load("//build_defs:artifacts.bzl", "generate", "python_tool", "source_tree")

source_tree(
    name = "sources",
    srcs = {path[len("src/"):]: path for path in glob([
        "src/*.dctlh",
        "src/ui-spec.json",
        "src/jc-lgg-locales.json",
        "src/jc-surface-locales.json",
        "src/cone-locales.json",
    ])},
    visibility = ["PUBLIC"],
)

export_file(
    name = "metadata",
    src = "product.toml",
    visibility = ["PUBLIC"],
)

python_tool(
    name = "generator",
    srcs = {"pg_dctl_tools/" + name: "tools/" + name for name in [
        "generate_dctl.py",
        "warp_geometry.py",
    ]},
    main_module = "pg_dctl_tools.generate_dctl",
    deps = ["//libraries/perceptual-grade-reference:model_code"],
)

GENERATOR_ARGS = [
    "--source-dir",
    "$(location :sources)",
    "--color-source",
    "$(location //libraries/color-dctl:linear)",
    "--metadata",
    "$(location :metadata)",
    "--catalog-dir",
    "$(location //libraries/perceptual-grade-core:catalog_sources)",
]

DCTL_STAGES = [
    ("linear", "1-Linear"),
    ("input", "1B-XYZ-Input"),
    ("tone_jc", "2-3A-Cone-Tone-JC"),
    ("warp", "3B-Cone-Warp"),
    ("output", "4-XYZ-Output"),
]

generate(
    name = "dctl",
    args = GENERATOR_ARGS,
    outputs = {
        stage + "_" + locale: "Perceptual-Grade-" + slug + suffix + ".dctl"
        for stage, slug in DCTL_STAGES
        for locale, suffix in [("en", ""), ("zh_HANS", "-zh-HANS")]
    },
    tool = ":generator",
    visibility = ["PUBLIC"],
)

generate(
    name = "standalone_tone_jc",
    args = GENERATOR_ARGS + ["--standalone-tone-jc"],
    outputs = {
        stage + "_" + locale: "Perceptual-Grade-" + slug + suffix + ".dctl"
        for stage, slug in [("tone", "2-Cone-Tone"), ("jc", "3A-Cone-Color-JC")]
        for locale, suffix in [("en", ""), ("zh_HANS", "-zh-HANS")]
    },
    tool = ":generator",
    visibility = ["PUBLIC"],
)

generate(
    name = "jc_prototype",
    args = GENERATOR_ARGS + ["--jc-prototype"],
    outputs = {
        variant + "_" + locale: "Perceptual-Grade-3A-Color-JC-LGG-" + slug + suffix + ".dctl"
        for variant, slug in [("lgg", "Prototype"), ("lgg_nonlog", "NonLog-Prototype"), ("lgg_pivot", "Pivot-Prototype")]
        for locale, suffix in [("en", ""), ("zh_HANS", "-zh-HANS")]
    },
    tool = ":generator",
    visibility = ["PUBLIC"],
)

generate(
    name = "jc_surface_prototype",
    args = GENERATOR_ARGS + ["--jc-surface"],
    outputs = {
        locale: "Perceptual-Grade-3A-Color-JC-Surface-Prototype" + suffix + ".dctl"
        for locale, suffix in [("en", ""), ("zh_HANS", "-zh-HANS")]
    },
    tool = ":generator",
    visibility = ["PUBLIC"],
)

generate(
    name = "jc_overlap_prototypes",
    args = GENERATOR_ARGS + ["--jc-overlap"],
    outputs = {
        variant + "_" + locale: "Perceptual-Grade-3A-Cone-Color-JC-" + slug + "-Overlap-Prototype" + suffix + ".dctl"
        for variant, slug in [("jc_adjacent_overlap", "Adjacent"), ("jc_broad_overlap", "Broad")]
        for locale, suffix in [("en", ""), ("zh_HANS", "-zh-HANS")]
    },
    tool = ":generator",
    visibility = ["PUBLIC"],
)

generate(
    name = "jc_anchor_centers_prototype",
    args = GENERATOR_ARGS + ["--jc-anchor-centers"],
    outputs = {
        locale: "Perceptual-Grade-3A-Cone-Color-JC-Broad-Overlap-Anchor-Centers-Prototype" + suffix + ".dctl"
        for locale, suffix in [("en", ""), ("zh_HANS", "-zh-HANS")]
    },
    tool = ":generator",
    visibility = ["PUBLIC"],
)

