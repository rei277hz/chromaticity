    name = "warp_quadratic_scale_prototype",
    args = GENERATOR_ARGS + ["--warp-quadratic-scale"],
    outputs = {
        locale: "Perceptual-Grade-3B-Cone-Warp-Quadratic-Scale-Prototype" + suffix + ".dctl"
        for locale, suffix in [("en", ""), ("zh_HANS", "-zh-HANS")]
    },
    tool = ":generator",
    visibility = ["PUBLIC"],
)

python_tool(
    name = "quality",
    srcs = {"pg_dctl_tools/dctl_quality.py": "tools/dctl_quality.py"},
    main_module = "pg_dctl_tools.dctl_quality",
    deps = ["//products/perceptual-grade-dctl/tests:support"],
)

generate(
    name = "quality_report",
    outputs = {"json": "report.json", "markdown": "summary.md"},
    tool = ":quality",
)

export_file(
    name = "documentation",
    src = "README.md",
    visibility = ["PUBLIC"],
)
