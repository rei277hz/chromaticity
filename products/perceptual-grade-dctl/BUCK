    args = GENERATOR_ARGS + ["--jc-gain"],
    outputs = {
        variant + "_" + locale: "Perceptual-Grade-3A-Cone-Color-JC-" + slug + "-Gain-Prototype" + suffix + ".dctl"
        for variant, slug in [("jc_linear_gain", "Linear"), ("jc_log_gain", "Log")]
        for locale, suffix in [("en", ""), ("zh_HANS", "-zh-HANS")]
    },
    tool = ":generator",
    visibility = ["PUBLIC"],
)

generate(
    name = "jc_global_shape_prototype",
    args = GENERATOR_ARGS + ["--jc-global-shape"],
    outputs = {
        locale: "Perceptual-Grade-3A-Cone-Color-JC-Global-Shape-Prototype" + suffix + ".dctl"
        for locale, suffix in [("en", ""), ("zh_HANS", "-zh-HANS")]
    },
    tool = ":generator",
    visibility = ["PUBLIC"],
)

generate(
    name = "jc_tone_fit_prototype",
    args = GENERATOR_ARGS + ["--jc-tone-fit"],
    outputs = {
        locale: "Perceptual-Grade-2-3A-Cone-Tone-JC-Prototype" + suffix + ".dctl"
