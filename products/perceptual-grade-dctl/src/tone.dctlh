__DEVICE__ PGValue pg_cone_tone(float3 wire, float blackNits, PGFour levelNits, int fit, int peakIndex) {
    if (!pg_cone_valid(wire) || !color_finite(blackNits) || !pg_tone_input_valid(levelNits, fit, peakIndex))
        return pg_value(color_zero3(), 0);

    if (blackNits <= 0.0f && pg_tone_default_levels(levelNits, peakIndex)) return pg_value(wire, 1);

    PGFour target = pg_tone_anchors(peakIndex);
    float black = pg_tone_nits_to_j(blackNits);
    PGFour source = pg_tone_input_anchors(levelNits, black);
    if (black == 0.0f && pg_four_equal(source, target)) return pg_value(wire, 1);

    float3 chart = pg_cone_chart(wire);
    if (!color_finite3(chart)) return pg_value(color_zero3(), 0);
    float ja = chart.x;
    float chroma = pg_hypot(chart.y, chart.z);
    float hkChroma = 66.0f * chroma;
    float height = pg_hypot(ja, _sqrtf(hkChroma));
    float span = source.h - black;
    float t = (height * .01f - black) / span;
    if (t <= 0.0f) return pg_value(color_zero3(), 1);
    float remapped = target.h;
    if (t != 1.0f) {
        PGFour knots = pg_four((source.s - black) / span, (source.m - black) / span,
                               (source.w - black) / span, 1.0f);
        remapped = pg_tone_remap(t, pg_tone_fit(knots, target, fit));
    }
    float out = 100.0f * remapped;
    return pg_cone_wire(chart * pg_tone_hk_gain(out, ja, hkChroma));
}
