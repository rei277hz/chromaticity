__DEVICE__ PGValue pg_cone_tone(float3 wire, float blackNits, PGFour levelNits, int fit, int peakIndex) {
    if (!pg_cone_valid(wire) || !color_finite(blackNits) || !pg_four_finite(levelNits) ||
        fit < -2 || fit > 6 || peakIndex < 0 || peakIndex > 3)
        return pg_value(color_zero3(), 0);

    float peak = pg_selected_peak(peakIndex);
    PGFour defaults = pg_four(3.148082606120999f, 36.54f, 203.0f, peak);
    if (blackNits <= 0.0f && pg_four_equal(levelNits, defaults)) return pg_value(wire, 1);

    PGFour target = pg_tone_anchors(peakIndex);
    float black = pg_neutral_j(_fmaxf(0.0f, blackNits) / 203.0f) * .01f;
    PGFour source = pg_four(pg_neutral_j(_fmaxf(0.0f, levelNits.s) / 203.0f) * .01f,
                            pg_neutral_j(_fmaxf(0.0f, levelNits.m) / 203.0f) * .01f,
                            pg_neutral_j(_fmaxf(0.0f, levelNits.w) / 203.0f) * .01f,
                            pg_neutral_j(_fmaxf(0.0f, levelNits.h) / 203.0f) * .01f);
    source.s = _fmaxf(source.s, black + .001f);
    source.m = _fmaxf(source.m, source.s + .001f);
    source.w = _fmaxf(source.w, source.m + .001f);
    source.h = _fmaxf(source.h, source.w + .001f);
    if (black == 0.0f && pg_four_equal(source, target)) return pg_value(wire, 1);

    float3 chart = pg_cone_chart(wire);
    if (!color_finite3(chart)) return pg_value(color_zero3(), 0);
    float ja = chart.x;
    float chroma = pg_hypot(chart.y, chart.z);
    float hkChroma = 66.0f * chroma;
    float height = pg_hypot(ja, _sqrtf(hkChroma));
    float span = source.h - black;
    float t = (height * .01f - black) / span;
    if (t <= 0.0f) return pg_value(color_zero3(), 1);
    float remapped = target.h;
    if (t != 1.0f) {
        PGFour knots = pg_four((source.s - black) / span, (source.m - black) / span,
                               (source.w - black) / span, 1.0f);
        PGFour dx = pg_four(knots.s, knots.m - knots.s, knots.w - knots.m, 1.0f - knots.w);
        PGFour dy = pg_four(target.s, target.m - target.s, target.w - target.m, target.h - target.w);
        float slope = _fminf(_fminf(dy.s / dx.s, dy.m / dx.m), _fminf(dy.w / dx.w, dy.h / dx.h));
        PGFour residual = pg_four(_fmaxf(0.0f, dy.s - slope * dx.s),
                                  _fmaxf(0.0f, dy.m - slope * dx.m),
                                  _fmaxf(0.0f, dy.w - slope * dx.w),
                                  _fmaxf(0.0f, dy.h - slope * dx.h));
        remapped = slope * t + pg_four_dot(residual, pg_transitions(t, pg_kernel(knots, fit)));
    }
    float out = 100.0f * remapped;
    float gain = pg_div(2.0f * out * out, pg_hypot(hkChroma, 2.0f * ja * out) + hkChroma);
    return pg_cone_wire(chart * gain);
}
