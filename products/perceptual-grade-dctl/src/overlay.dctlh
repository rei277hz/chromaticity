__DEVICE__ int pg_glyph(int ch) {
    if(ch==48)return 31599;
    if(ch==49)return 11415;
    if(ch==50)return 29671;
    if(ch==51)return 29647;
    if(ch==52)return 23497;
    if(ch==53)return 31183;
    if(ch==54)return 31215;
    if(ch==55)return 29330;
    if(ch==56)return 31727;
    if(ch==57)return 31695;
    if(ch==46)return 2;
    if(ch==65)return 11245;
    if(ch==66)return 27566;
    if(ch==67)return 31015;
    if(ch==68)return 27502;
    if(ch==69)return 31143;
    if(ch==70)return 31140;
    if(ch==71)return 31087;
    if(ch==72)return 23533;
    if(ch==73)return 29847;
    if(ch==74)return 4719;
    if(ch==75)return 23469;
    if(ch==76)return 18727;
    if(ch==77)return 24557;
    if(ch==78)return 24573;
    if(ch==79)return 31599;
    if(ch==80)return 31716;
    if(ch==81)return 31609;
    if(ch==82)return 27565;
    if(ch==83)return 31183;
    if(ch==84)return 29842;
    if(ch==85)return 23407;
    if(ch==86)return 23402;
    if(ch==87)return 23549;
    if(ch==88)return 23213;
    if(ch==89)return 23186;
    if(ch==90)return 29351;
