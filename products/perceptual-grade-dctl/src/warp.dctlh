#define PG_WARP_TURN 6.283185307179586f
#define PG_WARP_RADIANS 0.0174532925199433f

typedef struct {
    float chromaStops[4][6];
    float hueDegrees[4][6];
    float scaleStops[4][6];
    float3 adaptanceTargets[4];
    float halfSaturation;
} PGWarpSettings;

typedef struct { float value[6]; } PGWarpRing;
typedef struct { int index; float fraction; float angle; float width; } PGWarpSector;
typedef struct { PGState state; float scale; int valid; } PGWarpEdit;

__DEVICE__ float pg_warp_lerp(float a, float b, float t) {
    return a + (b - a) * t;
}

__DEVICE__ float pg_warp_fourth(float x) {
    float square = x * x;
    return square * square;
}

__DEVICE__ float pg_warp_eighth(float x) {
    float fourth = pg_warp_fourth(x);
    return fourth * fourth;
}

__DEVICE__ float pg_warp_gap(PGWarpRing angles, int handle) {
    if (handle == 5) return angles.value[0] + PG_WARP_TURN - angles.value[5];
    return angles.value[handle + 1] - angles.value[handle];
}

__DEVICE__ int pg_warp_ordered(PGWarpRing angles) {
    for (int handle = 0; handle < 6; ++handle) {
        if (!(pg_warp_gap(angles, handle) > 1.0e-8f)) return 0;
    }
    return 1;
}

__DEVICE__ PGWarpSector pg_warp_sector(float angle, PGWarpRing angles) {
    float offset = angle - angles.value[0];
    float wrapped = angles.value[0] + (offset - PG_WARP_TURN * _floorf(offset / PG_WARP_TURN));
    int handle = 0;
    for (int i = 1; i < 6; ++i) {
        if (wrapped >= angles.value[i]) handle = i;
    }
    float width = pg_warp_gap(angles, handle);
    PGWarpSector sector;
    sector.index = handle;
    sector.fraction = _fminf(1.0f, _fmaxf(0.0f, (wrapped - angles.value[handle]) / width));
    sector.angle = wrapped;
    sector.width = width;
    return sector;
}

__DEVICE__ float pg_warp_angle_slope(float a, float b) {
    float small = _fminf(a, b);
    return small / _sqrtf(_sqrtf(0.5f * (pg_warp_fourth(small / a) + pg_warp_fourth(small / b))));
}

__DEVICE__ float pg_warp_angle_edit(float angle, PGWarpRing source, PGWarpRing target) {
    PGWarpSector sector = pg_warp_sector(angle, source);
    int handle = sector.index;
    int prev = (handle + 5) % 6;
    int next = (handle + 1) % 6;
    float gap = pg_warp_gap(target, handle);
    float slope = gap / sector.width;
    float leftSlope = pg_warp_gap(target, prev) / pg_warp_gap(source, prev);
    float rightSlope = pg_warp_gap(target, next) / pg_warp_gap(source, next);
    float d0 = sector.width * pg_warp_angle_slope(leftSlope, slope) / 5.0f;
    float d1 = sector.width * pg_warp_angle_slope(slope, rightSlope) / 5.0f;

    // Evaluate the periodic quintic relative to its first control point.
    float points[6] = {0.0f, d0, 2.0f * d0, gap - 2.0f * d1, gap - d1, gap};
    for (int count = 5; count > 0; --count) {
        for (int i = 0; i < count; ++i) {
            points[i] = pg_warp_lerp(points[i], points[i + 1], sector.fraction);
        }
    }
    return (target.value[handle] - sector.angle) + points[0];
}

__DEVICE__ float pg_warp_toe(PGWarpRing source, PGWarpRing target, int includeTarget) {
    float smallest = 2.0f;
    for (int i = 0; i < 6; ++i) {
        smallest = _fminf(smallest, 0.1f * source.value[i]);
        if (includeTarget) smallest = _fminf(smallest, 0.1f * target.value[i]);
    }
    float sum = pg_warp_eighth(smallest / 2.0f);
    for (int i = 0; i < 6; ++i) {
        sum += pg_warp_eighth(smallest / (0.1f * source.value[i]));
        if (includeTarget) sum += pg_warp_eighth(smallest / (0.1f * target.value[i]));
    }
    return smallest / _sqrtf(_sqrtf(_sqrtf(sum)));
}

__DEVICE__ float pg_warp_attenuation(float chroma, float toe) {
    float normalizer = _fmaxf(chroma, toe);
    float c = chroma / normalizer;
    float t = toe / normalizer;
    return t / _sqrtf(pg_hypot(c * c, t * t));
}

__DEVICE__ float pg_warp_radius_coefficient(float source, float target, float toe) {
    float attenuation = pg_warp_attenuation(source, toe);
    float ratio = target / source;
    if (ratio >= 1.0f) return 1.0f + (ratio - 1.0f) / (1.0f - attenuation);
    return (ratio - attenuation) / (1.0f - attenuation);
}

__DEVICE__ float pg_warp_radius_gain(float chroma, float coefficient, float toe) {
    float attenuation = pg_warp_attenuation(chroma, toe);
    if (coefficient < 1.0f) return coefficient + (1.0f - coefficient) * attenuation;
    float complement = 1.0f - attenuation;
    if (chroma <= toe) {
        // Evaluate the fourth-order toe without subtracting two nearly equal values.
        float fourth = pg_warp_fourth(chroma / toe);
        float root = _sqrtf(_sqrtf(1.0f + fourth));
        complement = fourth / (root * (root + 1.0f) * (root * root + 1.0f));
    }
    return 1.0f + (coefficient - 1.0f) * complement;
}

__DEVICE__ float pg_warp_radial(float chroma, PGWarpSector sector, PGWarpRing source, PGWarpRing target) {
    float toe = pg_warp_toe(source, target, 1);
    int left = sector.index;
    int right = (left + 1) % 6;
    float a = pg_warp_radius_coefficient(source.value[left], target.value[left], toe);
    float b = pg_warp_radius_coefficient(source.value[right], target.value[right], toe);
    float coefficient = _expf(pg_warp_lerp(_logf(a), _logf(b), pg_smoother(sector.fraction)));
    return pg_warp_radius_gain(chroma, coefficient, toe);
}

__DEVICE__ PGWarpEdit pg_warp_web(PGState source, PGWarpSettings config, int peakIndex,
                                  int row, float fraction, float chroma) {
    PGWarpEdit edit;
    edit.state = source;
    edit.scale = 1.0f;
    edit.valid = 1;
    if (chroma == 0.0f) return edit;

    PGWarpRing angles, targetAngles, radii, targetRadii, finalRadii;
    int hueActive = 0;
    int chromaActive = 0;
    int scaleActive = 0;
    for (int i = 0; i < 6; ++i) {
        float3 left = pg_warp_reference_corner(peakIndex, row, i);
        float3 right = pg_warp_reference_corner(peakIndex, row + 1, i);
        float hue = pg_warp_lerp(config.hueDegrees[row][i], config.hueDegrees[row + 1][i], fraction);
        float radiusStops = pg_warp_lerp(config.chromaStops[row][i], config.chromaStops[row + 1][i], fraction);
        float finalStops = pg_warp_lerp(config.scaleStops[row][i], config.scaleStops[row + 1][i], fraction);
        angles.value[i] = pg_warp_lerp(left.x, right.x, fraction);
        targetAngles.value[i] = angles.value[i] + PG_WARP_RADIANS * hue;
        radii.value[i] = _expf(pg_warp_lerp(left.y, right.y, fraction));
        targetRadii.value[i] = radii.value[i] * _exp2f(radiusStops);
        finalRadii.value[i] = targetRadii.value[i] * _exp2f(finalStops);
        hueActive = hueActive || hue != 0.0f;
        chromaActive = chromaActive || radiusStops != 0.0f;
        scaleActive = scaleActive || finalStops != 0.0f;
    }
    if (!hueActive && !chromaActive && !scaleActive) return edit;
    if (!pg_warp_ordered(targetAngles)) {
        edit.valid = 0;
        return edit;
    }

    float angle = _atan2f(source.q.z, source.q.y);
    float rotation = 0.0f;
    if (hueActive) {
        float toe = pg_warp_toe(radii, radii, 0);
        rotation = pg_smoother(chroma / toe) * pg_warp_angle_edit(angle, angles, targetAngles);
    }
    float destAngle = angle + rotation;
    PGWarpSector sector = pg_warp_sector(destAngle, targetAngles);
    float gain = chromaActive ? pg_warp_radial(chroma, sector, radii, targetRadii) : 1.0f;
    float destChroma = chroma * gain;
    edit.scale = scaleActive ? pg_warp_radial(destChroma, sector, targetRadii, finalRadii) : 1.0f;
    float3 q = source.q;
    q.y = destAngle == angle ? q.y * gain : destChroma * _cosf(destAngle);
    q.z = destAngle == angle ? q.z * gain : destChroma * _sinf(destAngle);
    float energy = pg_requested_energy(source.e, chroma, destChroma, 0.0f);
    edit.state = pg_state(q, energy);
    edit.valid = color_finite3(q) && color_finite(energy) && color_finite(edit.scale) && edit.scale > 0.0f;
    return edit;
}

__DEVICE__ float pg_warp_neutral_response(float height) {
    return (PG_AW / 3.05f) * _powf(height * 0.01f, 1.0f / PG_GAMMA);
}

__DEVICE__ float pg_warp_log_odds(float response) {
    return _logf(response) - _logf(400.0f - response);
}

__DEVICE__ PGValue pg_warp_adaptance_log(float3 target, float height) {
    if (target.x == 0.0f && target.y == 0.0f) return pg_value(color_zero3(), 1);
    float3 q = make_float3(height, target.x, target.y);
    float3 response = pg_response_from_state(pg_state(q, height * height));
    if (!color_finite3(response) || response.x <= 0.0f || response.x >= 400.0f ||
        response.y <= 0.0f || response.y >= 400.0f || response.z <= 0.0f || response.z >= 400.0f) {
        return pg_value(color_zero3(), 0);
    }
    float neutral = pg_warp_log_odds(pg_warp_neutral_response(height));
    return pg_value(make_float3(pg_warp_log_odds(response.x) - neutral,
                                pg_warp_log_odds(response.y) - neutral,
                                pg_warp_log_odds(response.z) - neutral), 1);
}

__DEVICE__ float pg_warp_response_gain(float magnitude, float gain) {
    if (gain == 1.0f) return 1.0f;
    if (magnitude <= 400.0f) {
        return (400.0f * gain) / ((400.0f - magnitude) + gain * magnitude);
    }
    // The exterior continuation is defined even for an intermediate beyond the pole.
    float y = magnitude / 400.0f - 1.0f;
    float u = 2.0f * y / (_sqrtf(1.0f + 4.0f * y) + 1.0f);
    float z = u / gain;
    return (1.0f + z + z * z) / (magnitude / 400.0f);
}

__DEVICE__ float pg_warp_reach(float chroma, float energy, float halfSaturation) {
    if (chroma == 0.0f) return 1.0f;
    float midpoint = halfSaturation * _sqrtf(_fabs(energy));
    float scale = _fmaxf(chroma, midpoint);
    float on = pg_warp_fourth(midpoint / scale);
    return on / (on + pg_warp_fourth(chroma / scale));
}

__DEVICE__ PGState pg_warp_adaptance(PGState state, float3 logGains, float height,
                                     float inputChroma, float inputEnergy, float halfSaturation) {
    float reach = pg_warp_reach(inputChroma, inputEnergy, halfSaturation);
    if (reach == 0.0f || (logGains.x == 0.0f && logGains.y == 0.0f && logGains.z == 0.0f) ||
        (state.e == 0.0f && state.q.x == 0.0f && state.q.y == 0.0f && state.q.z == 0.0f)) return state;

    float r0 = pg_warp_neutral_response(height);
    float3 neutralRatios = make_float3(pg_warp_response_gain(r0, _expf(logGains.x)),
                                      pg_warp_response_gain(r0, _expf(logGains.y)),
                                      pg_warp_response_gain(r0, _expf(logGains.z)));
    float normalization = 3.05f / color_dot(make_float3(2.0f, 1.0f, 0.05f), neutralRatios);
    float factor = _expf(reach * _logf(normalization));
    float3 response = pg_response_from_state(state);
    response = response * make_float3(pg_warp_response_gain(_fabs(response.x), _expf(reach * logGains.x)),
                                      pg_warp_response_gain(_fabs(response.y), _expf(reach * logGains.y)),
                                      pg_warp_response_gain(_fabs(response.z), _expf(reach * logGains.z))) * factor;
    PGState result = pg_state_from_response(response);
    if (inputChroma == 0.0f && state.q.y == 0.0f && state.q.z == 0.0f) {
        result.e = state.e;
        result.q.x = pg_hk(pg_ja(state.e), pg_hypot(result.q.y, result.q.z));
    }
    return result;
}

__DEVICE__ PGValue pg_warp_xyz(float3 xyz, PGWarpSettings config, int peakIndex) {
    if (peakIndex < 0 || peakIndex >= 4 || !color_finite3(xyz) ||
        !(config.halfSaturation >= 0.05f && config.halfSaturation <= 1.0f)) {
        return pg_value(color_zero3(), 0);
    }

    int webActive = 0;
    int adaptanceActive = 0;
    float anchors[4];
    float3 logs[4];
    for (int row = 0; row < 4; ++row) {
        anchors[row] = pg_warp_anchor(peakIndex, row);
        PGValue logGain = pg_warp_adaptance_log(config.adaptanceTargets[row], anchors[row]);
        if (!logGain.valid) return pg_value(color_zero3(), 0);
        logs[row] = logGain.v;
        adaptanceActive = adaptanceActive || config.adaptanceTargets[row].x != 0.0f || config.adaptanceTargets[row].y != 0.0f;

        PGWarpRing targets;
        int rowHueActive = 0;
        for (int handle = 0; handle < 6; ++handle) {
            float hue = config.hueDegrees[row][handle];
            float c = config.chromaStops[row][handle];
            float s = config.scaleStops[row][handle];
            if (!color_finite(hue) || !color_finite(c) || !color_finite(s)) return pg_value(color_zero3(), 0);
            targets.value[handle] = pg_warp_reference_corner(peakIndex, row, handle).x + PG_WARP_RADIANS * hue;
            rowHueActive = rowHueActive || hue != 0.0f;
            webActive = webActive || hue != 0.0f || c != 0.0f || s != 0.0f;
        }
        if (rowHueActive && !pg_warp_ordered(targets)) return pg_value(color_zero3(), 0);
    }
    if (!webActive && !adaptanceActive) return pg_value(xyz, 1);

    PGState input = pg_enter_xyz(xyz);
    if (!color_finite3(input.q) || !color_finite(input.e)) return pg_value(color_zero3(), 0);
    float chroma = pg_hypot(input.q.y, input.q.z);
    float height = pg_hypot(pg_ja(input.e), _sqrtf(66.0f * chroma));
    int row = height >= anchors[2] ? 2 : (height >= anchors[1] ? 1 : 0);
    float fraction = pg_smoother((height - anchors[row]) / (anchors[row + 1] - anchors[row]));
    PGState state = input;
    float scale = 1.0f;
    if (webActive) {
        PGWarpEdit edit = pg_warp_web(input, config, peakIndex, row, fraction, chroma);
        if (!edit.valid) return pg_value(color_zero3(), 0);
        state = edit.state;
        scale = edit.scale;
    }
    if (adaptanceActive) {
        float3 logGains = logs[row] + (logs[row + 1] - logs[row]) * fraction;
        state = pg_warp_adaptance(state, logGains, height, chroma, input.e, config.halfSaturation);
        if (!color_finite3(state.q) || !color_finite(state.e)) return pg_value(color_zero3(), 0);
    }
    state = pg_guard(state, input.e);
    if (scale != 1.0f) {
        state.e *= scale * scale;
        state.q.y *= scale;
        state.q.z *= scale;
        state.q.x = pg_hk(pg_ja(state.e), pg_hypot(state.q.y, state.q.z));
    }
    if (state.e == input.e && state.q.x == input.q.x && state.q.y == input.q.y && state.q.z == input.q.z) {
        return pg_value(xyz, 1);
    }
    return pg_decode_xyz(state);
}
