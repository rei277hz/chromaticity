load("//build_defs:artifacts.bzl", "generate")

TOOL_PREFIX = ""

EVALUATION_SOURCES = {
    path[len(TOOL_PREFIX):]: path
    for path in glob([TOOL_PREFIX + "*.py"])
    if path != TOOL_PREFIX + "gate_policy.py"
}

python_library(
    name = "gate_policy_sources",
    srcs = {"gate_policy.py": TOOL_PREFIX + "gate_policy.py"},
    base_module = "tools.perceptual_grade.reports",
    visibility = ["PUBLIC"],
    deps = [
        "//products/perceptual-grade-next-blender:kernel_runtime",
        "//third_party:numpy",
    ],
)

python_library(
    name = "evaluation_sources",
    srcs = EVALUATION_SOURCES,
    base_module = "tools.perceptual_grade.reports",
    visibility = ["PUBLIC"],
    deps = [
        ":gate_policy_sources",
        "//libraries/perceptual-grade-reference:model_code",
        "//products/perceptual-grade-next-blender:boundary_support_sources",
        "//products/perceptual-grade-next-blender:kernel_runtime",
        "//third_party:bpy",
        "//third_party:numpy",
    ],
)

python_binary(
    name = "evaluate",
    main_module = "tools.perceptual_grade.reports.evaluate",
    visibility = ["PUBLIC"],
    deps = [":evaluation_sources"],
)

generate(
    name = "report",
