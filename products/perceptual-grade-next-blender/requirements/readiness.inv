{
  "version": 1,
  "state": "State",
  "event": "Event",
  "initializers": ["new"],
  "step": "step",
  "invariants": {
    "optional_signatures_are_nonempty": "(state.desired_signature is None or state.desired_signature != '') and (state.applied_signature is None or state.applied_signature != '')",
    "applied_quality_matches_applied_signature": "(state.applied_signature is None) == (state.applied_quality is None) and (state.applied_quality is None or state.applied_quality in ('preview', 'full'))",
    "error_discards_applied_kernel": "state.error is None or state.applied_signature is None",
    "applied_kernel_has_demand": "state.desired_signature is not None or state.applied_signature is None"
  },
  "contracts": {
    "new": {
      "requires": [
        "desired_signature is None or desired_signature != ''",
        "applied_signature is None or applied_signature != ''",
        "applied_quality is None or applied_quality in ('preview', 'full')",
        "applied_signature is not None or applied_quality is None",
        "error is None or applied_signature is None",
        "desired_signature is not None or applied_signature is None"
      ],
      "ensures": [
        "result.desired_signature == desired_signature",
        "result.applied_signature == applied_signature",
        "result.applied_quality == (None if applied_signature is None else ('full' if applied_quality is None else applied_quality))",
        "result.gesture_active == gesture_active and result.error == error"
      ]
    },
    "output_allowed": {
      "ensures": [
        "result == (state.desired_signature is not None and state.desired_signature == state.applied_signature and state.applied_quality == 'full' and state.error is None)"
      ]
    },
    "output_mode": {
      "ensures": [
        "result == ('current' if output_allowed(state) else ('error' if state.error is not None else ('pending' if state.applied_signature is None else 'preview')))"
      ]
    },
    "step": {
      "requires": [
        "state.desired_signature is None or state.desired_signature != ''",
        "state.applied_signature is None or state.applied_signature != ''",
        "(state.applied_signature is None) == (state.applied_quality is None)",
        "state.error is None or state.applied_signature is None",
        "state.desired_signature is not None or state.applied_signature is None",
        "event.signature is None or event.signature != ''",
        "event.quality in ('preview', 'full')"
      ],
      "ensures": [
        "result[0].desired_signature is None or result[0].desired_signature != ''",
        "result[0].applied_signature is None or result[0].applied_signature != ''",
        "(result[0].applied_signature is None) == (result[0].applied_quality is None)",
        "result[0].error is None or result[0].applied_signature is None",
        "result[0].desired_signature is not None or result[0].applied_signature is None",
        "result[1].output_mode == output_mode(result[0])",
        "result[1].error == result[0].error",
        "result[1].prepare_signature is None or result[1].prepare_signature == result[0].desired_signature",
        "(result[1].build_signature is None) == (result[1].build_quality is None)"
      ]
    }
  },
  "properties": [
    {
      "name": "full_quality_is_required_for_current_output",
      "variables": {},
      "lets": {
        "requested": "step(new(), Event('request', 'a'))",
        "prepared": "step(requested[0], Event('preparation_result', 'a'))",
        "full": "step(prepared[0], Event('installation_result', 'a'))",
        "preview_requested": "step(new(), Event('request', 'b'))",
        "preview_prepared": "step(preview_requested[0], Event('preparation_result', 'b', quality='preview'))",
        "preview": "step(preview_prepared[0], Event('installation_result', 'b', quality='preview'))"
      },
      "assert": "output_allowed(full[0]) and not output_allowed(preview[0]) and full[1].output_mode == 'current' and preview[1].output_mode == 'preview'"
    },
    {
      "name": "request_without_gesture_retains_last_good_output",
      "variables": {},
      "lets": {
        "changed": "step(new('a', 'a'), Event('request', 'b'))"
      },
      "assert": "changed[0].desired_signature == 'b' and changed[0].applied_signature == 'a' and changed[1].output_mode == 'preview' and changed[1].prepare_signature == 'b' and not output_allowed(changed[0])"
    },
    {
      "name": "gesture_release_retains_last_good_output",
      "variables": {},
      "lets": {
        "started": "step(new('a', 'a'), Event('gesture_begin'))",
        "changed": "step(started[0], Event('request', 'b'))",
        "released": "step(changed[0], Event('gesture_release'))"
      },
      "assert": "changed[1].output_mode == 'preview' and released[0].applied_signature == 'a' and not released[0].gesture_active and released[1].output_mode == 'preview' and not output_allowed(released[0])"
    },
    {
      "name": "matching_preview_survives_release",
      "variables": {},
      "lets": {
        "requested": "step(new(), Event('request', 'a'))",
        "prepared": "step(requested[0], Event('preparation_result', 'a', quality='preview'))",
        "installed": "step(prepared[0], Event('installation_result', 'a', quality='preview'))",
        "released": "step(installed[0], Event('gesture_release'))"
      },
      "assert": "released[0].applied_signature == 'a' and released[0].applied_quality == 'preview' and released[1].output_mode == 'preview' and not output_allowed(released[0])"
    },
    {
      "name": "stale_completion_requires_gesture",
      "variables": {},
      "lets": {
        "requested": "step(new(), Event('request', 'a'))",
        "begun": "step(requested[0], Event('gesture_begin'))",
        "changed": "step(begun[0], Event('request', 'b'))",
        "prepared": "step(changed[0], Event('preparation_result', 'a', quality='preview'))",
        "installed": "step(prepared[0], Event('installation_result', 'a', quality='preview'))",
        "released": "step(installed[0], Event('gesture_release'))",
        "late": "step(released[0], Event('installation_result', 'a', quality='preview'))"
      },
      "assert": "prepared[1].build_signature == 'a' and installed[1].output_mode == 'preview' and released[0].applied_signature == 'a' and released[1].output_mode == 'preview' and late[0] == released[0] and late[1].build_signature is None"
    },
    {
      "name": "stale_full_result_updates_drag_preview",
      "variables": {},
      "lets": {
        "requested": "step(new(), Event('request', 'a'))",
        "begun": "step(requested[0], Event('gesture_begin'))",
        "changed": "step(begun[0], Event('request', 'b'))",
        "prepared": "step(changed[0], Event('preparation_result', 'a'))",
        "installed": "step(prepared[0], Event('installation_result', 'a'))",
        "released": "step(installed[0], Event('gesture_release'))"
      },
      "assert": "prepared[1].build_signature == 'a' and prepared[1].build_quality == 'full' and installed[0].applied_signature == 'a' and installed[0].applied_quality == 'full' and installed[1].output_mode == 'preview' and released[0].applied_signature == 'a' and released[1].output_mode == 'preview' and not output_allowed(released[0])"
    },
    {
      "name": "late_lower_quality_never_replaces_full_quality",
      "variables": {},
      "lets": {
        "full": "step(new('a', 'a', 'full', True), Event('preparation_result', 'a', quality='preview'))",
        "installed": "step(full[0], Event('installation_result', 'a', quality='preview'))"
      },
      "assert": "full[0].applied_quality == 'full' and full[1].build_signature is None and installed[0].applied_quality == 'full' and installed[1].output_mode == 'current'"
    },
    {
      "name": "current_failure_clears_applied_output",
      "variables": {},
      "lets": {
        "requested": "step(new(), Event('request', 'a'))",
        "preview_prepared": "step(requested[0], Event('preparation_result', 'a', quality='preview'))",
        "preview": "step(preview_prepared[0], Event('installation_result', 'a', quality='preview'))",
        "failed": "step(preview[0], Event('preparation_result', 'a', 'failed'))"
      },
      "assert": "failed[0].applied_signature is None and failed[0].error == 'failed' and failed[1].output_mode == 'error'"
    },
    {
      "name": "return_to_applied_settings_updates_preparation_demand",
      "variables": {},
      "lets": {
        "begun": "step(new('a', 'a'), Event('gesture_begin'))",
        "changed": "step(begun[0], Event('request', 'b'))",
        "returned": "step(changed[0], Event('request', 'a'))"
      },
      "assert": "returned[1].output_mode == 'current' and returned[1].prepare_signature == 'a' and returned[1].build_signature is None"
    }
  ],
  "witnesses": [
    {
      "name": "preview_remains_visible_until_full_installation",
      "variables": {},
      "lets": {
        "requested": "step(new(), Event('request', 'a'))",
        "preview_prepared": "step(requested[0], Event('preparation_result', 'a', quality='preview'))",
        "preview": "step(preview_prepared[0], Event('installation_result', 'a', quality='preview'))",
        "released": "step(preview[0], Event('gesture_release'))",
        "full_prepared": "step(released[0], Event('preparation_result', 'a'))",
        "full": "step(full_prepared[0], Event('installation_result', 'a'))"
      },
      "assert": "preview[1].output_mode == 'preview' and released[1].output_mode == 'preview' and full[1].output_mode == 'current' and full[0].applied_quality == 'full'"
    }
  ]
}
