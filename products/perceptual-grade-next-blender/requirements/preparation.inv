{
  "version": 1,
  "state": "State",
  "event": "Event",
  "initializers": [
    "new"
  ],
  "step": "step",
  "invariants": {},
  "contracts": {
    "new": {
      "ensures": [
        "result.desired_signature is None and result.running_signature is None"
      ]
    },
    "step": {
      "ensures": [
        "result[0].desired_signature == (event.signature if event.kind == 'request' else state.desired_signature)",
        "result[0].running_signature == ((event.signature if state.running_signature is None else state.running_signature) if event.kind == 'request' else (state.running_signature if event.kind == 'preparation_preview' or event.signature is None or event.signature != state.running_signature else (state.desired_signature if state.desired_signature != event.signature else None)))",
        "result[1].prepare_signature == (event.signature if event.kind == 'request' and state.running_signature is None else (state.desired_signature if event.kind == 'preparation_result' and event.signature is not None and event.signature == state.running_signature and state.desired_signature != event.signature else None))",
        "result[1].preview_signature == (event.signature if event.kind == 'preparation_preview' and event.signature is not None and event.signature == state.running_signature and event.error is None else None)",
        "result[1].result_signature == (event.signature if event.kind == 'preparation_result' and event.signature is not None and event.signature == state.running_signature and state.desired_signature is not None and (event.error is None or event.signature == state.desired_signature) else None)",
        "result[1].error == (event.error if result[1].result_signature is not None else None)",
        "result[1].prepare_signature is None or result[1].prepare_signature == result[0].running_signature"
      ]
    }
  },
  "properties": [
    {
      "name": "idle_request_starts_preparation",
      "variables": {},
      "lets": {
        "updated": "step(new(), Event('request', 'a'))"
      },
      "assert": "updated[0] == State('a', 'a') and updated[1].prepare_signature == 'a' and updated[1].preview_signature is None and updated[1].result_signature is None"
    },
    {
      "name": "running_request_only_replaces_latest_demand",
      "variables": {},
      "lets": {
        "first": "step(new(), Event('request', 'a'))",
        "second": "step(first[0], Event('request', 'b'))"
      },
      "assert": "second[0] == State('b', 'a') and second[1] == Effects()"
    },
    {
      "name": "preview_receipt_keeps_worker_occupied",
      "variables": {},
      "lets": {
        "started": "step(new(), Event('request', 'a'))",
        "queued": "step(started[0], Event('request', 'b'))",
        "preview": "step(queued[0], Event('preparation_preview', 'a'))"
      },
      "assert": "preview[0] == queued[0] and preview[1].preview_signature == 'a' and preview[1].prepare_signature is None and preview[1].result_signature is None"
    },
    {
      "name": "final_receipt_starts_latest_successor",
      "variables": {},
      "lets": {
        "started": "step(new(), Event('request', 'a'))",
        "queued_b": "step(started[0], Event('request', 'b'))",
        "queued_c": "step(queued_b[0], Event('request', 'c'))",
        "final": "step(queued_c[0], Event('preparation_result', 'a'))"
      },
      "assert": "final[0] == State('c', 'c') and final[1].prepare_signature == 'c' and final[1].result_signature == 'a'"
    },
    {
      "name": "current_final_receipt_does_not_restart",
      "variables": {},
      "lets": {
        "started": "step(new(), Event('request', 'a'))",
        "final": "step(started[0], Event('preparation_result', 'a'))"
      },
      "assert": "final[0] == State('a', None) and final[1].prepare_signature is None and final[1].result_signature == 'a'"
    },
    {
      "name": "obsolete_failure_does_not_publish_error",
      "variables": {},
      "lets": {
        "started": "step(new(), Event('request', 'a'))",
        "queued": "step(started[0], Event('request', 'b'))",
        "final": "step(queued[0], Event('preparation_result', 'a', 'failed'))"
      },
      "assert": "final[0] == State('b', 'b') and final[1].prepare_signature == 'b' and final[1].result_signature is None and final[1].error is None"
    },
    {
      "name": "unmatched_receipt_is_ignored",
      "variables": {},
      "lets": {
        "started": "step(new(), Event('request', 'a'))",
        "preview": "step(started[0], Event('preparation_preview', 'b'))",
        "final": "step(started[0], Event('preparation_result', 'b'))"
      },
      "assert": "preview == (started[0], Effects()) and final == (started[0], Effects())"
    }
  ],
  "witnesses": [
    {
      "name": "preview_does_not_consume_latest_queued_request",
      "variables": {},
      "lets": {
        "started": "step(new(), Event('request', 'a'))",
        "latest_b": "step(started[0], Event('request', 'b'))",
        "latest_c": "step(latest_b[0], Event('request', 'c'))",
        "preview": "step(latest_c[0], Event('preparation_preview', 'a'))",
        "final": "step(preview[0], Event('preparation_result', 'a'))"
      },
      "assert": "preview[0].running_signature == 'a' and preview[1].preview_signature == 'a' and preview[1].prepare_signature is None and final[1].prepare_signature == 'c'"
    }
  ]
}
