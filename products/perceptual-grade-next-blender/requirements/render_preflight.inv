{
  "version": 1,
  "state": "State",
  "event": "Event",
  "initializers": [
    "new"
  ],
  "step": "step",
  "invariants": {},
  "contracts": {
    "new": {
      "ensures": [
        "result.phase == 'waiting'",
        "result.scene_identity == scene_identity and result.frame == frame and result.subframe == subframe"
      ]
    }
  },
  "properties": [
    {
      "name": "release_requires_correlated_exact_publication",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.phase == 'waiting'"
      ],
      "lets": {
        "transition": "step(state, event)"
      },
      "assert": "transition[1].action != 'release' or (event.kind == 'published' and event.scene_identity == state.scene_identity and event.frame == state.frame and event.subframe == state.subframe and event.signature is not None and event.error is None and event.published_signature == event.signature and transition[0].phase == 'released')"
    },
    {
      "name": "terminal_receipts_are_inert",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.phase != 'waiting'"
      ],
      "assert": "step(state, event) == (state, Effects())"
    },
    {
      "name": "missing_or_changed_scene_time_fails_closed",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.phase == 'waiting'",
        "event.kind == 'published'",
        "event.scene_identity != state.scene_identity or event.frame != state.frame or event.subframe != state.subframe"
      ],
      "lets": {
        "transition": "step(state, event)"
      },
      "assert": "transition[0].phase == 'failed' and transition[1].action == 'fail'"
    },
    {
      "name": "publication_mismatch_fails_closed",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.phase == 'waiting'",
        "event.kind == 'published'",
        "event.scene_identity == state.scene_identity",
        "event.frame == state.frame",
        "event.subframe == state.subframe",
        "event.published_signature != event.signature or event.error is not None or event.signature is None"
      ],
      "lets": {
        "transition": "step(state, event)"
      },
      "assert": "transition[0].phase == 'failed' and transition[1].action == 'fail'"
    },
    {
      "name": "failure_event_fails_closed",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.phase == 'waiting'",
        "event.kind == 'failed'"
      ],
      "lets": {
        "transition": "step(state, event)"
      },
      "assert": "transition[0].phase == 'failed' and transition[1].action == 'fail' and (event.error is None or transition[1].error == event.error)"
    }
  ],
  "witnesses": [
    {
      "name": "matching_frame_releases_after_exact_publication",
      "variables": {},
      "lets": {
        "waiting": "new(20, 17, '0x0.0p+0')",
        "released": "step(waiting, Event('published', 20, 17, '0x0.0p+0', signature='grade-17', published_signature='grade-17'))"
      },
      "assert": "released == (State('released', 20, 17, '0x0.0p+0'), Effects('release'))"
    },
    {
      "name": "previous_frame_observation_fails_closed",
      "variables": {},
      "lets": {
        "waiting": "new(20, 18, '0x0.0p+0')",
        "stale": "step(waiting, Event('published', 20, 17, '0x0.0p+0', signature='grade-17', published_signature='grade-17'))"
      },
      "assert": "stale[0].phase == 'failed' and stale[1].action == 'fail'"
    }
  ],
  "mutations": [
    {
      "name": "release_accepts_unpublished_signature",
      "function": "step",
      "target": "event.published_signature != event.signature",
      "replacement": "False",
      "detects": [
        "property.release_requires_correlated_exact_publication",
        "property.publication_mismatch_fails_closed"
      ]
    },
    {
      "name": "release_accepts_changed_scene_time",
      "function": "step",
      "target": "event.scene_identity != state.scene_identity or event.frame != state.frame or event.subframe != state.subframe",
      "replacement": "False",
      "detects": [
        "property.release_requires_correlated_exact_publication",
        "property.missing_or_changed_scene_time_fails_closed"
      ]
    }
  ]
}
