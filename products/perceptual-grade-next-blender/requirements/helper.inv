{
  "version": 1,
  "state": "State",
  "event": "Event",
  "initializers": [
    "new"
  ],
  "step": "step",
  "invariants": {
    "nonnegative_generation": "state.generation >= 0",
    "ready_has_passed_probe": "state.phase != 'ready' or (state.probe_id is None and not state.close_requested)",
    "starting_has_queued_probe": "state.phase != 'starting' or (state.probe_id is not None and state.active_id is None and not state.close_requested)",
    "probing_occupies_slot": "state.phase != 'probing' or (state.probe_id is not None and state.active_id == state.probe_id and not state.close_requested)",
    "retired_work_has_no_ids": "state.phase not in ('stopped', 'retiring', 'failed', 'closed') or (state.probe_id is None and state.active_id is None)",
    "closed_requested": "state.phase != 'closed' or state.close_requested",
    "running_phases_have_no_error": "state.phase not in ('starting', 'probing', 'ready') or state.error is None"
  },
  "contracts": {
    "new": {
      "ensures": [
        "result == State('stopped', 0, None, None, None)"
      ]
    }
  },
  "properties": [
    {
      "name": "ready_requires_successful_probe",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "lets": {
        "out": "step(state, event)"
      },
      "assert": "out[0].phase != 'ready' or state.phase == 'ready' or (state.phase == 'probing' and event.kind == 'probe_result' and event.generation == state.generation and event.success and event.job_id == state.probe_id and event.job_id == state.active_id)",
      "assume": [
        "state.generation >= 0",
        "state.phase != 'ready' or (state.probe_id is None and not state.close_requested)",
        "state.phase != 'starting' or (state.probe_id is not None and state.active_id is None and not state.close_requested)",
        "state.phase != 'probing' or (state.probe_id is not None and state.active_id == state.probe_id and not state.close_requested)",
        "state.phase not in ('stopped', 'retiring', 'failed', 'closed') or (state.probe_id is None and state.active_id is None)",
        "state.phase != 'closed' or state.close_requested",
        "state.phase not in ('starting', 'probing', 'ready') or state.error is None"
      ]
    },
    {
      "name": "cancelled_probe_withdraws_startup",
      "variables": {},
      "lets": {
        "out": "step(State('probing', 1, 7, 7, None), Event('cancelled', 1, job_id=7, transport='channel'))"
      },
      "assert": "out[0].phase == 'stopping' and out[0].close_requested and out[0].active_id == 7 and out[1].deadline_stage == 'stopping' and out[1].send_shutdown and not out[1].cleanup"
    },
    {
      "name": "cancel_before_hello_waits_for_exit",
      "variables": {},
      "lets": {
        "out": "step(State('starting', 1, 7, None, None), Event('cancel', 1, job_id=7))"
      },
      "assert": "out[0].phase == 'terminating' and out[0].probe_id == 7 and out[0].close_requested and out[1].deadline_stage == 'terminating' and out[1].terminate and not out[1].cleanup"
    },
    {
      "name": "late_probe_success_cannot_revive_cancelled_helper",
      "variables": {},
      "lets": {
        "late": "step(State('stopping', 1, 7, 7, None, True), Event('probe_result', 1, job_id=7, success=True))"
      },
      "assert": "late == (State('stopping', 1, 7, 7, None, True), Effects())"
    },
    {
      "name": "stale_generation_is_ignored",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "lets": {
        "out": "step(state, event)"
      },
      "assert": "out == (state, Effects())",
      "assume": [
        "state.generation >= 0",
        "state.phase != 'ready' or (state.probe_id is None and not state.close_requested)",
        "state.phase != 'starting' or (state.probe_id is not None and state.active_id is None and not state.close_requested)",
        "state.phase != 'probing' or (state.probe_id is not None and state.active_id == state.probe_id and not state.close_requested)",
        "state.phase not in ('stopped', 'retiring', 'failed', 'closed') or (state.probe_id is None and state.active_id is None)",
        "state.phase != 'closed' or state.close_requested",
        "event.kind != 'launch'",
        "event.generation != state.generation",
        "state.phase not in ('starting', 'probing', 'ready') or state.error is None"
      ]
    },
    {
      "name": "terminal_poll_never_touches_transport",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "lets": {
        "out": "step(state, event)"
      },
      "assert": "out == (state, Effects())",
      "assume": [
        "state.generation >= 0",
        "state.phase != 'ready' or (state.probe_id is None and not state.close_requested)",
        "state.phase != 'starting' or (state.probe_id is not None and state.active_id is None and not state.close_requested)",
        "state.phase != 'probing' or (state.probe_id is not None and state.active_id == state.probe_id and not state.close_requested)",
        "state.phase not in ('stopped', 'retiring', 'failed', 'closed') or (state.probe_id is None and state.active_id is None)",
        "state.phase != 'closed' or state.close_requested",
        "state.phase in ('retiring', 'failed', 'closed')",
        "event.kind == 'poll'",
        "state.phase not in ('starting', 'probing', 'ready') or state.error is None"
      ]
    },
    {
      "name": "shutdown_does_not_cleanup_live_process",
      "variables": {},
      "lets": {
        "out": "step(State('ready', 1, None, 8, None), Event('shutdown', 1, transport='channel'))"
      },
      "assert": "out[0].phase == 'stopping' and out[1].deadline_stage == 'stopping' and out[1].send_shutdown and not out[1].cleanup"
    },
    {
      "name": "exit_authorizes_failure_and_cleanup",
      "variables": {},
      "lets": {
        "out": "step(State('terminating', 1, None, 8, 'original'), Event('exited', 1, error='later', exit_code=23))"
      },
      "assert": "out[0] == State('retiring', 1, None, None, 'original') and out[1].clear_deadline and out[1].publish_kind == 'failure' and out[1].publish_id == 8 and out[1].publish_error == 'original' and out[1].queue_kind == 'fail' and out[1].queue_error == 'original' and out[1].cleanup"
    },
    {
      "name": "cleanup_failure_retains_owner_and_error",
      "variables": {},
      "lets": {
        "out": "step(State('retiring', 1, None, None, 'original'), Event('cleanup_result', 1, error='cleanup'))"
      },
      "assert": "out == (State('retiring', 1, None, None, 'original'), Effects())"
    },
    {
      "name": "shutdown_fences_admission",
      "variables": {
        "state": "State"
      },
      "lets": {
        "out": "step(state, Event('shutdown', state.generation, transport='channel'))"
      },
      "assert": "not admitting(out[0]) and out[0].close_requested",
      "assume": [
        "state.generation >= 0",
        "state.phase != 'ready' or (state.probe_id is None and not state.close_requested)",
        "state.phase != 'starting' or (state.probe_id is not None and state.active_id is None and not state.close_requested)",
        "state.phase != 'probing' or (state.probe_id is not None and state.active_id == state.probe_id and not state.close_requested)",
        "state.phase not in ('stopped', 'retiring', 'failed', 'closed') or (state.probe_id is None and state.active_id is None)",
        "state.phase != 'closed' or state.close_requested",
        "state.phase not in ('starting', 'probing', 'ready') or state.error is None"
      ]
    },
    {
      "name": "cancel_request_retains_active_slot",
      "variables": {},
      "lets": {
        "out": "step(State('ready', 1, None, 8, None), Event('cancel', 1, job_id=8))"
      },
      "assert": "out[0] == State('ready', 1, None, 8, None) and out[1].send_cancel_id == 8 and out[1].publish_kind is None"
    },
    {
      "name": "cancel_acknowledgement_dispatches_successor",
      "variables": {},
      "lets": {
        "out": "step(State('ready', 1, None, 8, None), Event('cancelled', 1, job_id=8, next_id=9))"
      },
      "assert": "out[0].active_id == 9 and out[1].publish_kind == 'cancelled' and out[1].publish_id == 8 and out[1].dispatch_id == 9"
    },
    {
      "name": "stale_stage_timeout_has_no_effects",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "lets": {
        "out": "step(state, event)"
      },
      "assert": "out == (state, Effects())",
      "assume": [
        "state.generation >= 0",
        "state.phase != 'ready' or (state.probe_id is None and not state.close_requested)",
        "state.phase != 'starting' or (state.probe_id is not None and state.active_id is None and not state.close_requested)",
        "state.phase != 'probing' or (state.probe_id is not None and state.active_id == state.probe_id and not state.close_requested)",
        "state.phase not in ('stopped', 'retiring', 'failed', 'closed') or (state.probe_id is None and state.active_id is None)",
        "state.phase != 'closed' or state.close_requested",
        "event.kind == 'timeout'",
        "event.stage != state.phase",
        "state.phase not in ('starting', 'probing', 'ready') or state.error is None"
      ]
    },
    {
      "name": "stopping_timeout_requests_termination",
      "variables": {},
      "lets": {
        "out": "step(State('stopping', 1, None, 8, None, True), Event('timeout', 1, stage='stopping'))"
      },
      "assert": "out[0].phase == 'terminating' and out[0].active_id == 8 and out[1].deadline_stage == 'terminating' and out[1].terminate"
    },
    {
      "name": "terminating_timeout_requests_kill",
      "variables": {},
      "lets": {
        "out": "step(State('terminating', 1, None, 8, 'failed', True), Event('timeout', 1, stage='terminating'))"
      },
      "assert": "out[0].phase == 'killing' and out[0].active_id == 8 and out[1].deadline_stage == 'killing' and out[1].kill"
    },
    {
      "name": "killing_timeout_marks_unretired",
      "variables": {},
      "lets": {
        "out": "step(State('killing', 1, None, 8, 'failed', True), Event('timeout', 1, stage='killing'))"
      },
      "assert": "out[0].phase == 'unretired' and out[0].active_id == 8 and out[1].clear_deadline and close_problem(out[0]) is not None"
    },
    {
      "name": "duplicate_exit_does_not_republish",
      "variables": {
        "state": "State"
      },
      "lets": {
        "out": "step(state, Event('exited', state.generation))"
      },
      "assert": "out == (state, Effects())",
      "assume": [
        "state.generation >= 0",
        "state.phase != 'ready' or (state.probe_id is None and not state.close_requested)",
        "state.phase != 'starting' or (state.probe_id is not None and state.active_id is None and not state.close_requested)",
        "state.phase != 'probing' or (state.probe_id is not None and state.active_id == state.probe_id and not state.close_requested)",
        "state.phase not in ('stopped', 'retiring', 'failed', 'closed') or (state.probe_id is None and state.active_id is None)",
        "state.phase != 'closed' or state.close_requested",
        "state.phase in ('retiring', 'failed', 'closed')",
        "state.phase not in ('starting', 'probing', 'ready') or state.error is None"
      ]
    },
    {
      "name": "repeated_shutdown_preserves_stage_deadline",
      "variables": {
        "state": "State"
      },
      "lets": {
        "out": "step(state, Event('shutdown', state.generation))"
      },
      "assert": "out == (state, Effects())",
      "assume": [
        "state.generation >= 0",
        "state.phase != 'ready' or (state.probe_id is None and not state.close_requested)",
        "state.phase != 'starting' or (state.probe_id is not None and state.active_id is None and not state.close_requested)",
        "state.phase != 'probing' or (state.probe_id is not None and state.active_id == state.probe_id and not state.close_requested)",
        "state.phase not in ('stopped', 'retiring', 'failed', 'closed') or (state.probe_id is None and state.active_id is None)",
        "state.phase != 'closed' or state.close_requested",
        "state.phase in ('stopping', 'terminating', 'killing', 'unretired')",
        "state.close_requested",
        "state.phase not in ('starting', 'probing', 'ready') or state.error is None"
      ]
    },
    {
      "name": "first_causal_error_is_preserved",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 0",
        "state.phase != 'ready' or (state.probe_id is None and not state.close_requested)",
        "state.phase != 'starting' or (state.probe_id is not None and state.active_id is None and not state.close_requested)",
        "state.phase != 'probing' or (state.probe_id is not None and state.active_id == state.probe_id and not state.close_requested)",
        "state.phase not in ('stopped', 'retiring', 'failed', 'closed') or (state.probe_id is None and state.active_id is None)",
        "state.phase != 'closed' or state.close_requested",
        "state.phase not in ('starting', 'probing', 'ready') or state.error is None",
        "state.error is not None",
        "event.kind != 'launch'"
      ],
      "lets": {
        "out": "step(state, event)"
      },
      "assert": "out[0].error == state.error"
    },
    {
      "name": "successful_probe_admits_work",
      "variables": {},
      "lets": {
        "out": "step(State('probing', 1, 1, 1, None), Event('probe_result', 1, job_id=1, success=True, next_id=2))"
      },
      "assert": "admitting(out[0]) and out[0].active_id == 2 and out[1].publish_kind == 'result' and out[1].publish_id == 1 and out[1].dispatch_id == 2"
    },
    {
      "name": "cancelled_startup_exit_publishes_cancellation",
      "variables": {},
      "lets": {
        "out": "step(State('terminating', 1, 1, 1, None, True), Event('exited', 1, exit_code=-15, error='signal'))"
      },
      "assert": "out[0].phase == 'retiring' and out[0].error is None and out[1].publish_kind == 'cancelled' and out[1].publish_id == 1 and out[1].queue_kind == 'cancel' and out[1].cleanup"
    },
    {
      "name": "startup_exit_publishes_probe_failure",
      "variables": {},
      "lets": {
        "out": "step(State('starting', 1, 7, None, None), Event('exited', 1, error='worker exited'))"
      },
      "assert": "out[0].phase == 'retiring' and out[0].error == 'worker exited' and out[1].publish_kind is None and out[1].probe_publish_kind == 'failure' and out[1].probe_publish_id == 7 and out[1].probe_publish_error == 'worker exited' and out[1].queue_kind == 'fail' and out[1].cleanup"
    }
  ],
  "witnesses": [],
  "mutations": [
    {
      "name": "cancelled_probe_becomes_ready",
      "function": "_cancelled",
      "target": "_shutdown(state, event.transport)",
      "replacement": "(State('ready', state.generation, None, None, None), Effects())",
      "detects": [
        "property.cancelled_probe_withdraws_startup"
      ]
    },
    {
      "name": "poll_after_terminal_cleanup",
      "function": "step",
      "target": "state.phase in ('stopped', 'retiring', 'failed', 'closed')",
      "replacement": "False",
      "detects": [
        "property.terminal_poll_never_touches_transport"
      ]
    },
    {
      "name": "cleanup_before_physical_exit",
      "function": "_shutdown",
      "target": "Effects(deadline_stage='stopping', send_shutdown=True)",
      "replacement": "Effects(deadline_stage='stopping', cleanup=True)",
      "detects": [
        "property.shutdown_does_not_cleanup_live_process"
      ]
    }
  ]
}
