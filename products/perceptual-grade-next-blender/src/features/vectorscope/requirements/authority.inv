{
  "version": 1,
  "state": "PublicationState",
  "event": "PublicationEvent",
  "initializers": [
    "new_publication"
  ],
  "step": "publication_step",
  "invariants": {},
  "properties": [
    {
      "name": "unmatched_or_different_source_receipt_is_inert",
      "variables": {
        "state": "PublicationState",
        "event": "PublicationEvent"
      },
      "assume": [
        "not state.active or not state.same_source"
      ],
      "assert": "publication_step(state, event) == PublicationTransition(state, PublicationDecision(False, False, False))"
    },
    {
      "name": "current_requires_exact_success",
      "variables": {
        "state": "PublicationState",
        "event": "PublicationEvent"
      },
      "lets": {
        "effects": "publication_step(state, event).effects"
      },
      "assert": "effects.current == (state.active and state.same_source and state.exact and event.success) and (not effects.current or effects.publish)"
    },
    {
      "name": "superseded_success_cannot_overwrite_newer_display",
      "variables": {
        "state": "PublicationState"
      },
      "assume": [
        "not state.exact",
        "state.display_newer"
      ],
      "assert": "publication_step(state, PublicationEvent(True)) == PublicationTransition(state, PublicationDecision(False, False, False))"
    },
    {
      "name": "only_exact_failure_is_visible",
      "variables": {
        "state": "PublicationState",
        "event": "PublicationEvent"
      },
      "lets": {
        "effects": "publication_step(state, event).effects"
      },
      "assert": "effects.fail == (state.active and state.same_source and state.exact and not event.success) and (event.success or not effects.publish)"
    },
    {
      "name": "display_current_requires_publication_and_live_source",
      "variables": {
        "published": "bool",
        "revision_matches": "bool",
        "source_valid": "bool"
      },
      "assert": "display_current(published, revision_matches, source_valid) == (published and revision_matches and source_valid)"
    },
    {
      "name": "preview_current_requires_matching_live_receipt",
      "variables": {
        "active": "bool",
        "revision_matches": "bool",
        "source_valid": "bool"
      },
      "assert": "preview_current(active, revision_matches, source_valid) == (active and revision_matches and source_valid)"
    }
  ],
  "witnesses": [
    {
      "name": "lagging_same_source_preview_is_reachable",
      "assert": "publication(True, True, True, False, False) == PublicationDecision(True, False, False)"
    },
    {
      "name": "current_display_is_reachable",
      "assert": "display_current(True, True, True)"
    },
    {
      "name": "current_preview_is_reachable",
      "assert": "preview_current(True, True, True)"
    }
  ],
  "mutations": [
    {
      "name": "unmatched_receipt_is_admitted",
      "function": "publication_step",
      "target": "not state.active or not state.same_source",
      "replacement": "False",
      "detects": [
        "property.unmatched_or_different_source_receipt_is_inert"
      ]
    },
    {
      "name": "superseded_capture_overwrites_newer_display",
      "function": "publication_step",
      "target": "state.exact or not state.display_newer",
      "replacement": "True",
      "detects": [
        "property.superseded_success_cannot_overwrite_newer_display"
      ]
    },
    {
      "name": "display_ignores_live_context",
      "function": "display_current",
      "target": "published and revision_matches and source_valid",
      "replacement": "published and revision_matches",
      "detects": [
        "property.display_current_requires_publication_and_live_source"
      ]
    },
    {
      "name": "preview_ignores_revision",
      "function": "preview_current",
      "target": "active and revision_matches and source_valid",
      "replacement": "active and source_valid",
      "detects": [
        "property.preview_current_requires_matching_live_receipt"
      ]
    }
  ]
}
