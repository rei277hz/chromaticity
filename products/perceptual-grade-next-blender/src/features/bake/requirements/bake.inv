{
  "version": 1,
  "state": "State",
  "event": "Event",
  "initializers": [
    "new"
  ],
  "step": "step",
  "invariants": {
    "request_signature_is_nonempty": "state.signature is None or state.signature != ''",
    "idle_has_no_request": "state.phase != 'idle' or state.signature is None",
    "terminal_has_no_request": "state.phase != 'terminal' or state.signature is None"
  },
  "properties": [
    {
      "name": "request_requires_valid_signature",
      "variables": {
        "signature": "Optional[str]"
      },
      "lets": {
        "transition": "step(new(), Event('request', signature))"
      },
      "assert": "transition[1].action != 'enqueue' or (signature is not None and signature != '')"
    },
    {
      "name": "queue_is_bounded_and_serial_per_node",
      "variables": {
        "count": "int",
        "busy": "bool"
      },
      "assert": "can_enqueue(count, busy) == (0 <= count < 8 and not busy)"
    },
    {
      "name": "start_requires_queued_phase",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "lets": {
        "transition": "step(state, event)"
      },
      "assert": "transition[1].action != 'start' or (state.phase == 'queued' and event.kind == 'start')"
    },
    {
      "name": "completion_requires_current_signature",
      "variables": {},
      "lets": {
        "queued": "step(new(), Event('request', 'a'))",
        "running": "step(queued[0], Event('start'))",
        "stale": "step(running[0], Event('completed', current_signature='b', successful=True))"
      },
      "assert": "stale[0].phase == 'terminal' and stale[1].action == 'discard'"
    },
    {
      "name": "publication_requires_current_signature",
      "variables": {},
      "lets": {
        "ready": "State('ready', 'a')",
        "current": "step(ready, Event('publish', current_signature='a'))",
        "stale": "step(ready, Event('publish', current_signature='b'))"
      },
      "assert": "current == (State('publishing', 'a'), Effects('publish')) and stale[0].phase == 'terminal' and stale[1].action == 'discard'"
    },
    {
      "name": "publication_failure_authorizes_rollback",
      "variables": {},
      "lets": {
        "transition": "step(State('publishing', 'a'), Event('published', current_signature='a', successful=False, error='upload failed'))"
      },
      "assert": "transition[0].phase == 'terminal' and transition[1].action == 'rollback' and transition[1].error == 'upload failed'"
    },
    {
      "name": "activation_failure_authorizes_rollback",
      "variables": {},
      "lets": {
        "transition": "step(State('activating', 'a'), Event('activated', current_signature='a', successful=False, error='activation failed'))"
      },
      "assert": "transition[0].phase == 'terminal' and transition[1].action == 'rollback' and transition[1].error == 'activation failed'"
    },
    {
      "name": "input_change_cancels_running_request",
      "variables": {},
      "lets": {
        "transition": "step(State('running', 'a'), Event('invalidate', current_signature='b'))"
      },
      "assert": "transition[0].phase == 'cancelling' and transition[0].signature == 'a' and transition[1].action == 'cancel'"
    },
    {
      "name": "input_change_discards_queued_result",
      "variables": {},
      "lets": {
        "transition": "step(State('queued', 'a'), Event('invalidate', current_signature='b'))"
      },
      "assert": "transition[0].phase == 'terminal' and transition[1].action == 'discard'"
    },
    {
      "name": "terminal_receipts_are_inert",
      "variables": {},
      "lets": {
        "transition": "step(State('terminal'), Event('completed', current_signature='a', successful=True))"
      },
      "assert": "transition == (State('terminal'), Effects())"
    },
    {
      "name": "valid_artifact_remains_baked",
      "variables": {},
      "lets": {
        "output": "output_policy(True, True)"
      },
      "assert": "output == Output('baked')"
    },
    {
      "name": "source_invalidation_requires_tracked_receipt",
      "variables": {
        "has_receipt": "bool",
        "source_changed": "bool"
      },
      "lets": {
        "authorized": "persist_source_invalidation(has_receipt, source_changed)"
      },
      "assert": "authorized == (has_receipt and source_changed)"
    },
    {
      "name": "toggle_requires_valid_artifact_and_live_kernel",
      "variables": {
        "valid": "bool",
        "live_error": "Optional[str]"
      },
      "lets": {
        "available": "bake_toggle_available(valid, live_error)"
      },
      "assert": "available == (valid and live_error is None)"
    },
    {
      "name": "manual_bypass_selects_live_output",
      "variables": {},
      "lets": {
        "output": "output_policy(False, True)"
      },
      "assert": "output == Output('live')"
    },
    {
      "name": "shared_image_binding_requires_valid_matching_route",
      "variables": {},
      "lets": {
        "valid": "binding_policy('route', True, True)",
        "invalid_image": "binding_policy('route', False, True)",
        "wrong_domain": "binding_policy('route', True, False)"
      },
      "assert": "valid.receipt_signature == 'route' and invalid_image.receipt_signature is None and wrong_domain.receipt_signature is None"
    },
    {
      "name": "invalid_selected_image_fails_closed",
      "variables": {},
      "lets": {
        "output": "output_policy(True, False)"
      },
      "assert": "output.mode == 'error' and output.error is not None"
    },
    {
      "name": "live_failure_overrides_baked_output",
      "variables": {
        "artifact_valid": "bool"
      },
      "lets": {
        "output": "output_policy(True, artifact_valid, 'kernel lost')"
      },
      "assert": "output.mode == 'error' and output.error == 'kernel lost'"
    }
  ],
  "witnesses": [
    {
      "name": "request_runs_and_publishes",
      "variables": {},
      "lets": {
        "queued": "step(new(), Event('request', 'a'))",
        "running": "step(queued[0], Event('start'))",
        "ready": "step(running[0], Event('completed', current_signature='a', successful=True))",
        "publishing": "step(ready[0], Event('publish', current_signature='a'))",
        "activating": "step(publishing[0], Event('published', current_signature='a', successful=True))",
        "done": "step(activating[0], Event('activated', current_signature='a', successful=True))"
      },
      "assert": "queued[1].action == 'enqueue' and running[1].action == 'start' and ready[0].phase == 'ready' and publishing[1].action == 'publish' and activating[0].phase == 'activating' and activating[1].action == 'activate' and done[0].phase == 'terminal' and done[1].action == 'retire'"
    },
    {
      "name": "failed_request_retires_without_publishing",
      "variables": {},
      "lets": {
        "failed": "step(State('running', 'a'), Event('completed', successful=False, error='worker failed'))"
      },
      "assert": "failed[0].phase == 'terminal' and failed[1].action == 'retire' and failed[1].error == 'worker failed'"
    }
  ],
  "mutations": [
    {
      "name": "skip_current_signature_check",
      "function": "_current",
      "target": "event.current_signature == state.signature",
      "replacement": "True",
      "detects": [
        "property.completion_requires_current_signature",
        "property.publication_requires_current_signature"
      ]
    },
    {
      "name": "select_live_for_valid_bake",
      "function": "output_policy",
      "target": "Output(\"baked\")",
      "replacement": "Output(\"live\")",
      "detects": [
        "property.valid_artifact_remains_baked"
      ]
    },
    {
      "name": "allow_invalid_artifact",
      "function": "output_policy",
      "target": "not artifact_valid",
      "replacement": "False",
      "detects": [
        "property.invalid_selected_image_fails_closed"
      ]
    },
    {
      "name": "drop_live_error_guard",
      "function": "output_policy",
      "target": "live_error is not None",
      "replacement": "False",
      "detects": [
        "property.live_failure_overrides_baked_output"
      ]
    },
    {
      "name": "drop_source_tracking_requirement",
      "function": "persist_source_invalidation",
      "target": "has_receipt and source_changed",
      "replacement": "source_changed",
      "detects": [
        "property.source_invalidation_requires_tracked_receipt"
      ]
    },
    {
      "name": "allow_invalid_toggle",
      "function": "bake_toggle_available",
      "target": "live_error is None and artifact_valid",
      "replacement": "True",
      "detects": [
        "property.toggle_requires_valid_artifact_and_live_kernel"
      ]
    }
  ]
}
