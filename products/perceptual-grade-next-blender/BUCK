load("//build_defs:artifacts.bzl", "generate", "source_tree")
load("//build_defs:python_packages.bzl", "extension_tree")

PREFIX = "src/"

SOURCES = {path[len(PREFIX):]: path for path in glob([PREFIX + "**/*.py"])}

source_tree(
    name = "sources",
    srcs = SOURCES,
    visibility = ["PUBLIC"],
)

extension_tree(
    name = "extension_tree",
    entrypoints = {
        "__init__.py": "src/__init__.py",
        "nodes.py": "src/nodes.py",
        "preparation_runtime.py": "src/preparation_runtime.py",
        "blender_manifest.toml": "blender_manifest.toml",
        "LICENSE": "LICENSE",
        "README.md": "README.md",
    },
    visibility = ["PUBLIC"],
    deps = [
        "//libraries/perceptual-grade-next-core:runtime_bundle",
        "//libraries/perceptual-grade-nodes:code_bundle",
    ],
)

python_library(
    name = "packager_sources",
    srcs = {"perceptual_grade_package.py": "tools/package.py"},
    base_module = "product_build",
    visibility = ["PUBLIC"],
    deps = ["//tools/verification:packaging"],
)

python_binary(
    name = "package",
    main_module = "product_build.perceptual_grade_package",
    deps = [":packager_sources"],
)

export_file(
    name = "package_inventory",
    src = "tools/package_inventory.json",
    visibility = ["PUBLIC"],
)

generate(
    name = "extension",
    args = [
        "--tree",
        "$(location :extension_tree)",
        "--inventory",
        "$(location :package_inventory)",
        "--proof-stack",
        "$(location //libraries/perceptual-grade-next-core:proof_stack)",
        "--requirements-stack",
        "$(location //libraries/perceptual-grade-next-core:stack_requirements)",
        "--proof-preparation",
        "$(location //libraries/perceptual-grade-next-core:proof_preparation)",
        "--requirements-preparation",
        "$(location //libraries/perceptual-grade-next-core:preparation_requirements)",
        "--proof-readiness",
        "$(location //libraries/perceptual-grade-next-core:proof_readiness)",
        "--requirements-readiness",
        "$(location //libraries/perceptual-grade-next-core:readiness_requirements)",
    ],
    outputs = {
        "zip": "perceptual_grade.zip",
        "report": "package-report.json",
    },
    tool = ":package",
    visibility = ["PUBLIC"],
)

export_file(
    name = "documentation",
    src = "README.md",
    visibility = ["PUBLIC"],
)

python_library(
    name = "workspace_install_code",
    srcs = {"install_workspace.py": "tools/install_workspace.py"},
    base_module = "product_install",
    visibility = ["PUBLIC"],
)

python_library(
    name = "workspace_install_archive",
    base_module = "product_install",
    resources = {"perceptual_grade.zip": ":extension[zip]"},
)

python_binary(
    name = "install_workspace",
    main_module = "product_install.install_workspace",
    visibility = ["PUBLIC"],
    deps = [
        ":workspace_install_archive",
        ":workspace_install_code",
    ],
)
