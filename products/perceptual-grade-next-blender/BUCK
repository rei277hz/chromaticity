invariant_proof(
    name = "proof_bake",
    required_mutations = [
        "skip_current_signature_check",
        "keep_stale_bake_selected",
        "allow_stale_toggle",
    ],
    required_properties = [
        "request_requires_valid_signature",
        "queue_is_bounded_and_serial_per_node",
        "start_requires_queued_phase",
        "completion_requires_current_signature",
        "publication_requires_current_signature",
        "publication_failure_authorizes_rollback",
        "activation_failure_authorizes_rollback",
        "input_change_cancels_running_request",
        "input_change_discards_queued_result",
        "terminal_receipts_are_inert",
        "stale_bake_automatically_uses_live_output",
        "source_invalidation_overrides_matching_signature",
        "toggle_requires_current_receipt_and_valid_artifact",
        "stale_disabled_bake_revokes_receipt",
        "matching_disabled_bake_retains_receipt",
        "shared_image_binding_requires_valid_matching_route",
        "invalid_selected_image_fails_closed",
        "live_failure_overrides_baked_output",
    ],
    required_witnesses = [
        "request_runs_and_publishes",
        "failed_request_retires_without_publishing",
    ],
    requirements = ":bake_requirements",
    runtime_source = "policy/bake.py",
    source = ":bake_source",
    visibility = ["PUBLIC"],
)

