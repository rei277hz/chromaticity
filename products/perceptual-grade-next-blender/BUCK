PREFIX = "src/"

KERNEL_PREFIX = PREFIX + "kernel/"

SOURCES = {path[len(PREFIX):]: path for path in glob([PREFIX + "**/*.py"])}

KERNEL_SOURCES = {
    path[len(KERNEL_PREFIX):]: path
    for path in glob([KERNEL_PREFIX + "**/*.py"])
}

TEMPLATE_BUILD_PREFIX = "tools/template_build/"

TEMPLATE_BUILD_SOURCES = {
    path[len(TEMPLATE_BUILD_PREFIX):]: path
    for path in glob([TEMPLATE_BUILD_PREFIX + "**/*.py"])
}

KERNEL_RUNTIME_SOURCES = KERNEL_SOURCES

POLICY_PREFIX = PREFIX + "policy/"

POLICY_SOURCES = {
    path[len(POLICY_PREFIX):]: path
    for path in glob([POLICY_PREFIX + "*.py"])
}

POLICY_ENTRYPOINTS = {
    "policy/" + path[len(POLICY_PREFIX):]: path
    for path in glob([POLICY_PREFIX + "*.py"])
}

RUNTIME_PREFIX = PREFIX + "runtime/"

RUNTIME_ENTRYPOINTS = {
    "runtime/" + path[len(RUNTIME_PREFIX):]: path
    for path in glob([RUNTIME_PREFIX + "**/*.py"])
}

