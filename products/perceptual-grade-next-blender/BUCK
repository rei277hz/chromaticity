extension_tree(
    name = "extension_tree",
    entrypoints = {
        path[len(PREFIX):]: path
        for path in glob([PREFIX + "*.py"])
        if path != PREFIX + "localization.py"
    } | {
        "blender_manifest.toml": "blender_manifest.toml",
        "LICENSE": "LICENSE",
        "README.md": "README.md",
    } | POLICY_ENTRYPOINTS | RUNTIME_ENTRYPOINTS,
    visibility = ["PUBLIC"],
    deps = [
        ":kernel_runtime_bundle",
        ":localization_runtime_bundle",
    ],
)

