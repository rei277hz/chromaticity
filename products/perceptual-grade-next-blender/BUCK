        "gesture_release_retains_last_good_output",
        "matching_preview_survives_release",
        "stale_completion_requires_gesture",
        "stale_full_result_updates_drag_preview",
        "late_lower_quality_never_replaces_full_quality",
        "current_failure_clears_applied_output",
        "return_to_applied_settings_updates_preparation_demand",
        "replacement_rebuild_tracks_order_and_multiplicity",
        "grade_edit_rebuilds_only_when_referenced",
        "kernel_match_does_not_override_preparation_correlation",
        "preparation_failure_requires_current_preparation_signature",
        "request_preserves_reducer_owned_stack_membership",
        "disposal_clears_node_lifecycle",
        "disposal_authorizes_cleanup_without_presentation",
        "disposal_is_idempotent",
        "disposed_demand_rejects_correlated_late_receipts",
    ],
    required_witnesses = [
        "preview_remains_visible_until_full_installation",
        "duplicate_grade_occurrences_are_preserved",
    ],
    requirements = ":node_requirements",
