    "src/downloads/provenance/favicon.json": ":favicon[manifest]",
    "src/downloads/provenance/legacy-generator-sources.json": "source-provenance.json",
}

ASSETS.update({"src/assets/figures/" + name + ".png": ":figures[" + name + "]" for name in FIGURES})

ASSETS.update({"src/assets/figures/photo-" + name + ".png": ":photos[" + name + "]" for name in PHOTO_GRADES})

ASSETS.update({"src/assets/screenshots/" + name + ".png": ":screenshots[" + name + "]" for name in SCREENSHOTS})

ASSETS.update({"src/assets/demos/" + name + ".webp": ":demos[" + name + "]" for name in DEMOS})

ASSETS.update({"src/assets/demos/" + name + "-still.webp": ":demos[" + name + "_still]" for name in DEMOS})

source_tree(
    name = "assets",
    srcs = ASSETS,
    visibility = ["PUBLIC"],
)

