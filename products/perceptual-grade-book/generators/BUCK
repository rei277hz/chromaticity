    "src/assets/ab_background.png": ":ab_background[png]",
    "src/assets/intro/match-three-images.webp": ":intro[animation]",
    "src/assets/intro/match-three-images-still.webp": ":intro[still]",
    "src/assets/demos/manifest.json": ":demos[manifest]",
    "src/assets/fragments/benchmark.md": ":figures[benchmark]",
    "src/downloads/photo-metrics.json": ":photos[metrics]",
    "src/downloads/provenance/numerical-figures.json": ":figures[manifest]",
    "src/downloads/provenance/photographic-figures.json": ":photos[manifest]",
