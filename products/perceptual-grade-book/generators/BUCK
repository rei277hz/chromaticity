DEMO_OUTPUTS.update({name + "_still": "images/" + name + "-still.webp" for name in DEMOS})

DEMO_OUTPUTS["manifest"] = "manifest.json"

book_generate(
    name = "demos",
    args = [
        "--recordings",
        "$(location //products/perceptual-grade-book:book_recordings)",
        "--spec",
        "$(location //products/perceptual-grade-book:book_data)/demos.json",
    ],
    outputs = DEMO_OUTPUTS,
    tool = ":demos_tool",
    visibility = ["PUBLIC"],
)

book_generate(
    name = "intro",
    args = [
        "--recordings",
