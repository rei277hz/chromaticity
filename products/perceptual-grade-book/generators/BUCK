load("//build_defs:artifacts.bzl", "python_tool", "source_tree")
load(":rules.bzl", "book_generate")

export_file(
    name = "publication_sources",
    src = "BUCK",
    visibility = ["PUBLIC"],
)

python_library(
    name = "action_sources",
    srcs = {"pg_book_generators/action.py": "action.py"},
    base_module = "",
)

python_binary(
    name = "action",
    main_module = "pg_book_generators.action",
    deps = [":action_sources"],
    visibility = ["PUBLIC"],
)

python_library(
    name = "common",
    srcs = [
        "__init__.py",
        "figure_common.py",
    ],
    base_module = "pg_book_generators",
    visibility = ["PUBLIC"],
)

export_file(
    name = "plot_style",
    src = "plot-style.tex",
)

TOOLS = {
    "figures": [
        "//libraries/perceptual-grade-reference:model_code",
        "//products/perceptual-grade-next-blender:kernel_code",
    ],
    "screenshots": ["//third_party:pillow"],
    "demos": [
        "//third_party:imageio-ffmpeg",
        "//third_party:numpy",
        "//third_party:pillow",
    ],
    "intro": [":demos_tool_sources"],
    "favicon": ["//third_party:pillow"],
}

[
    python_tool(
        name = name + "_tool",
        srcs = {"pg_book_generators/" + name + ".py": name + ".py"},
        main_module = "pg_book_generators." + name,
        deps = [":common"] + deps,
    )
    for name, deps in TOOLS.items()
]

FIGURES = [
    "linear-basis",
    "tone-curves",
    "tone-saturation",
    "color-tone-weights",
    "color-drivers",
    "guard-boundary",
    "guard-energy",
    "lut-input-grid",
    "lut-interpolation",
]

FIGURE_OUTPUTS = {name: "images/" + name + ".svg" for name in FIGURES}

FIGURE_OUTPUTS.update({
    "manifest": "manifest.json",
    "data": "numerical-data.json",
    "sources": "chart-sources.zip",
})

book_generate(
    name = "figures_data",
    args = [
        "--style",
        "$(location :plot_style)",
    ],
    outputs = {
        "manifest": "manifest.json",
        "figures": "figures.json",
        "data": "numerical-data.json",
    },
    tool = ":figures_tool",
    visibility = ["PUBLIC"],
)

book_generate(
    name = "figures",
    args = [
        "--sources", "$(location :figures_data)",
        "--runtime", "$(location //products/perceptual-grade-book/generators/latex:runtime)",
        "--fonts", "$(location //products/perceptual-grade-book/print:pdf_fonts)",
    ],
    outputs = FIGURE_OUTPUTS,
    tool = "//products/perceptual-grade-book/generators/latex:renderer",
    visibility = ["PUBLIC"],
)

SCREENSHOTS = [
    "blender-install",
    "blender-shading",
    "blender-compositing",
    "resolve-install",
    "resolve-cst",
    "colorchecker-connect",
    "tone-waveforms",
]

SCREENSHOT_OUTPUTS = {name: "images/" + name + ".png" for name in SCREENSHOTS}

SCREENSHOT_OUTPUTS["manifest"] = "manifest.json"

book_generate(
    name = "screenshots",
    args = [
        "--screenshots",
        "$(location //products/perceptual-grade-book:book_screenshots)",
        "--spec",
        "$(location //products/perceptual-grade-book:book_data)/screenshots.json",
    ],
    outputs = SCREENSHOT_OUTPUTS,
    tool = ":screenshots_tool",
    visibility = ["PUBLIC"],
)

DEMOS = [
    "linear-white-balance",
    "linear-correction",
    "colorchecker-match",
    "tone-curve",
    "color-j",
    "color-jc-curves",
    "color-jc-pads",
    "color-adaptance",
    "color-hue-pad",
    "color-hue-rotation",
]

DEMO_OUTPUTS = {name: "images/" + name + ".webp" for name in DEMOS}

DEMO_OUTPUTS.update({name + "_still": "images/" + name + "-still.webp" for name in DEMOS})

DEMO_OUTPUTS["manifest"] = "manifest.json"

book_generate(
    name = "demos",
    args = [
        "--recordings",
        "$(location //products/perceptual-grade-book:book_recordings)",
        "--spec",
        "$(location //products/perceptual-grade-book:book_data)/demos.json",
    ],
    outputs = DEMO_OUTPUTS,
    tool = ":demos_tool",
    visibility = ["PUBLIC"],
)

book_generate(
    name = "intro",
    args = [
        "--recordings",
        "$(location //products/perceptual-grade-book:book_intro_recording)",
        "--spec",
        "$(location //products/perceptual-grade-book:book_data)/intro-video.json",
    ],
    outputs = {
        "animation": "match-three-images.webp",
        "still": "match-three-images-still.webp",
        "manifest": "manifest.json",
    },
    tool = ":intro_tool",
    visibility = ["PUBLIC"],
)

book_generate(
    name = "favicon",
    args = [
        "--icons",
        "$(location //products/perceptual-grade-icon:icons)",
    ],
    outputs = {
        "ico": "favicon.ico",
        "touch": "apple-touch-icon.png",
        "android192": "android-192.png",
        "android512": "android-512.png",
        "maskable": "android-512-maskable.png",
        "webmanifest": "site.webmanifest",
        "manifest": "manifest.json",
    },
    tool = ":favicon_tool",
    visibility = ["PUBLIC"],
)

ICON_FILES = [
    "perceptual-grade-" + str(size) + "-" + variant + ".png"
    for size in [16, 32, 48, 64, 180, 192, 256, 512]
    for variant in ["transparent", "opaque"]
]

ASSETS = {
    "src/favicon.ico": ":favicon[ico]",
    "src/apple-touch-icon.png": ":favicon[touch]",
    "src/android-192.png": ":favicon[android192]",
    "src/android-512.png": ":favicon[android512]",
    "src/android-512-maskable.png": ":favicon[maskable]",
    "src/site.webmanifest": ":favicon[webmanifest]",
    "src/downloads/chart-sources.zip": ":figures[sources]",
    "src/downloads/provenance/numerical-figures.json": ":figures[manifest]",
    "src/downloads/provenance/host-screenshots.json": ":screenshots[manifest]",
    "src/downloads/provenance/favicon.json": ":favicon[manifest]",
}

ASSETS.update({
    "src/assets/icons/" + name: "//products/perceptual-grade-icon:icons[" + name + "]"
    for name in ICON_FILES
})

ASSETS.update({"src/assets/figures/" + name + ".svg": ":figures[" + name + "]" for name in FIGURES})

ASSETS.update({"src/assets/screenshots/" + name + ".png": ":screenshots[" + name + "]" for name in SCREENSHOTS})

source_tree(
    name = "assets",
    srcs = ASSETS,
    visibility = ["PUBLIC"],
)

