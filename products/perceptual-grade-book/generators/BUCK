load("//build_defs:artifacts.bzl", "python_tool", "source_tree")
load(":rules.bzl", "book_generate")

python_tool(
    name = "action",
    srcs = {"pg_book_generators/action.py": "action.py"},
    main_module = "pg_book_generators.action",
)

python_library(
    name = "common",
    srcs = [
        "__init__.py",
        "figure_common.py",
    ],
    base_module = "pg_book_generators",
    visibility = ["PUBLIC"],
)

source_tree(
    name = "catalog_sources",
    srcs = {path.removeprefix("legacy/locales/"): path for path in glob(["legacy/locales/*.json"])},
)

python_tool(
    name = "compile_locales",
    srcs = {"pg_book_generators/compile_locales.py": "compile_locales.py"},
    main_module = "pg_book_generators.compile_locales",
    deps = ["//third_party:babel"],
)

CATALOGS = [path.removeprefix("legacy/locales/").removesuffix(".json") for path in glob(["legacy/locales/*.json"])]

book_generate(
    name = "locales",
    args = [
        "--catalog-dir",
        "$(location :catalog_sources)",
    ],
    outputs = {locale: locale + "/LC_MESSAGES/perceptual_grade.mo" for locale in CATALOGS},
    tool = ":compile_locales",
)

LEGACY_RESOURCES = {path.removeprefix("legacy/"): path for path in glob(["legacy/**/*.json"])}

LEGACY_RESOURCES.update({"locales/" + locale + "/LC_MESSAGES/perceptual_grade.mo": ":locales[" + locale + "]" for locale in CATALOGS})

python_library(
    name = "legacy_model",
    srcs = {path.removeprefix("legacy/"): path for path in glob(["legacy/**/*.py"])},
    base_module = "pg_book_legacy",
    resources = LEGACY_RESOURCES,
    deps = ["//third_party:numpy"],
)

TOOLS = {
    "figures": [
        ":legacy_model",
        "//third_party:matplotlib",
    ],
    "photos": [
        ":legacy_model",
        "//third_party:bpy",
        "//third_party:pillow",
    ],
    "screenshots": ["//third_party:pillow"],
    "demos": [
        "//third_party:imageio-ffmpeg",
        "//third_party:numpy",
        "//third_party:pillow",
    ],
    "intro": [":demos_tool_sources"],
    "favicon": ["//third_party:pillow"],
    "ab_background": [
        ":legacy_model",
        "//third_party:pillow",
    ],
    "locus": [
        "//third_party:colour-science",
        "//third_party:numpy",
        "//third_party:pillow",
    ],
}

[
    python_tool(
        name = name + "_tool",
        srcs = {"pg_book_generators/" + name + ".py": name + ".py"},
        main_module = "pg_book_generators." + name,
        deps = [":common"] + deps,
    )
    for name, deps in TOOLS.items()
]

FIGURES = [
    "linear-basis",
    "tone-curves",
    "tone-saturation",
    "color-tone-weights",
    "color-drivers",
    "color-hue-concentration",
    "guard-boundary",
    "guard-energy",
    "lut-input-grid",
    "lut-interpolation",
    "render-benchmark",
]

FIGURE_OUTPUTS = {name: "images/" + name + ".png" for name in FIGURES}

FIGURE_OUTPUTS.update({
    "benchmark": "fragments/benchmark.md",
    "manifest": "manifest.json",
    "data": "numerical-data.json",
})

book_generate(
    name = "figures",
    args = [
        "--data",
        "$(location //products/perceptual-grade-book:book_data)",
    ],
    outputs = FIGURE_OUTPUTS,
    tool = ":figures_tool",
    visibility = ["PUBLIC"],
)

source_tree(
    name = "photo_fixtures",
    srcs = {
        "exr/metadata.json": "fixtures/exr-metadata.json",
        "pq/metadata.json": "fixtures/pq-metadata.json",
        "pq/IMG_0221.PNG": "fixtures/IMG_0221.PNG",
    },
)

PHOTO_GRADES = [
    "practical",
    "chroma-8x",
    "dark-chroma",
]

PHOTO_OUTPUTS = {name: "images/photo-" + name + ".png" for name in PHOTO_GRADES}

PHOTO_OUTPUTS.update({
    "metrics": "metrics.json",
    "manifest": "manifest.json",
})

book_generate(
    name = "photos",
    args = [
        "--data",
        "$(location //products/perceptual-grade-book:book_data)",
        "--fixtures",
        "$(location :photo_fixtures)",
        "--samples",
        "$(location //products/perceptual-grade-blender/tests/fixtures/photographs:sources)",
    ],
    outputs = PHOTO_OUTPUTS,
    tool = ":photos_tool",
    visibility = ["PUBLIC"],
)

SCREENSHOTS = [
