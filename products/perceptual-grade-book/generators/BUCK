ASSETS = {
    "src/favicon.ico": ":favicon[ico]",
    "src/apple-touch-icon.png": ":favicon[touch]",
    "src/android-192.png": ":favicon[android192]",
    "src/android-512.png": ":favicon[android512]",
    "src/android-512-maskable.png": ":favicon[maskable]",
    "src/site.webmanifest": ":favicon[webmanifest]",
