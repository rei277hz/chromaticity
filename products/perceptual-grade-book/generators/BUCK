    "tone-waveforms",
]

SCREENSHOT_OUTPUTS = {name: "images/" + name + ".png" for name in SCREENSHOTS}

SCREENSHOT_OUTPUTS["manifest"] = "manifest.json"

book_generate(
    name = "screenshots",
    args = [
        "--screenshots",
        "$(location //products/perceptual-grade-book:book_screenshots)",
        "--spec",
        "$(location //products/perceptual-grade-book:book_data)/screenshots.json",
    ],
    outputs = SCREENSHOT_OUTPUTS,
    tool = ":screenshots_tool",
    visibility = ["PUBLIC"],
)

DEMOS = [
    "linear-white-balance",
    "linear-correction",
