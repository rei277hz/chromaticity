generate(
    name = "archive",
    args = [
        "--site",
        "$(location :site[html])",
    ],
    outputs = {
        "zip": "perceptual-grade-site.zip",
        "checksums": "SHA256.json",
    },
    tool = ":archive_tool",
    visibility = ["PUBLIC"],
)

python_library(
    name = "preview_resources",
    base_module = "pg_book_build",
    resources = {"site": ":site[html]"},
)

python_binary(
    name = "preview",
    main_module = "pg_book_build.serve",
    visibility = ["PUBLIC"],
    deps = [
        ":build_support",
        ":preview_resources",
    ],
)

python_library(
    name = "publish_resources",
    base_module = "pg_book_build",
    resources = {"perceptual-grade-site.zip": ":archive[zip]"},
)

# Buck builds the completed ZIP through remote execution; `buck2 run` launches
# the publisher on the client so it can replace the local website checkout's
# files.
python_binary(
    name = "publish",
    main_module = "pg_book_build.publish",
    visibility = ["PUBLIC"],
    deps = [
        ":build_support",
        ":publish_resources",
    ],
)
