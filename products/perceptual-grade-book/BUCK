load("//build_defs:artifacts.bzl", "generate", "source_tree")
load(":rules.bzl", "documentation")

source_tree(
    name = "docs",
    srcs = {path.removeprefix("docs/"): path for path in glob(["docs/**"])},
    visibility = ["PUBLIC"],
)

# Independent authored inputs keep a chapter edit out of media generation.
[
    source_tree(
        name = name,
        srcs = {path.removeprefix(prefix): path for path in glob(patterns)},
        visibility = ["PUBLIC"],
    )
    for name, prefix, patterns in [
        (
            "book_data",
            "docs/data/",
            ["docs/data/*.json"],
        ),
        (
            "book_screenshots",
            "docs/media/screenshots/",
            ["docs/media/screenshots/*.png"],
        ),
        (
            "book_recordings",
            "docs/media/demos/",
            [
                "docs/media/demos/**/*.mov",
                "docs/media/demos/**/*.MOV",
            ],
        ),
        (
            "book_intro_recording",
            "docs/media/intro/",
            ["docs/media/intro/*.mp4"],
        ),
        (
            "book_icons",
            "docs/book/src/assets/icons/",
            ["docs/book/src/assets/icons/*.png"],
        ),
    ]
]

source_tree(
    name = "historical",
    srcs = {path.removeprefix("historical/"): path for path in glob(["historical/**"])},
    visibility = ["PUBLIC"],
)

export_file(
    name = "historical_manifest",
    src = "historical-manifest.json",
    visibility = ["PUBLIC"],
)

alias(
    name = "tool_pins",
    actual = "//third_party/book:pins",
    visibility = ["PUBLIC"],
)

source_tree(
    name = "data_downloads",
    srcs = {
        "src/downloads/benchmark.json": "docs/data/benchmark.json",
        "src/downloads/photo-grades.json": "docs/data/photo-grades.json",
    },
    visibility = ["PUBLIC"],
)

python_library(
    name = "build_support",
    srcs = {path.removeprefix("tools/"): path for path in glob(["tools/*.py"])},
    base_module = "pg_book_build",
    visibility = ["PUBLIC"],
)

[
    python_binary(
        name = name,
        main_module = "pg_book_build." + module,
        deps = [":build_support"],
    )
    for name, module in [
        ("assemble_tool", "assemble"),
        ("site_tool", "site"),
        ("archive_tool", "deploy"),
    ]
]

generate(
    name = "book_inputs",
    args = [
        "--docs",
        "$(location :docs)",
        "--assets",
        "$(location //products/perceptual-grade-book/generators:assets)",
        "--assets",
        "$(location //products/perceptual-grade-book/cdn:assets)",
        "--assets",
        "$(location :data_downloads)",
        "--historical",
        "$(location :historical)",
        "--manifest",
        "$(location :historical_manifest)",
    ],
    outputs = {},
    tool = ":assemble_tool",
    visibility = ["PUBLIC"],
)

documentation(
    name = "site",
    book = ":book_inputs",
    mdbook = "//third_party/rust:mdbook-mdbook",
    pins = ":tool_pins",
    rust_versions = "//third_party/rust/tools:versions",
    tool = ":site_tool",
    visibility = ["PUBLIC"],
)

generate(
    name = "archive",
    args = [
        "--site",
        "$(location :site[html])",
    ],
    outputs = {
        "zip": "perceptual-grade-site.zip",
        "checksums": "SHA256.json",
    },
    tool = ":archive_tool",
    visibility = ["PUBLIC"],
)

python_library(
    name = "preview_resources",
    base_module = "pg_book_build",
    resources = {"site": ":site[html]"},
)

python_binary(
    name = "preview",
    main_module = "pg_book_build.serve",
    visibility = ["PUBLIC"],
    deps = [
        ":build_support",
        ":preview_resources",
    ],
)

python_library(
    name = "publish_resources",
    base_module = "pg_book_build",
    resources = {"perceptual-grade-site.zip": ":archive[zip]"},
)

# Buck builds the completed ZIP through NativeLink; `buck2 run` launches the
# publisher on the client so it can replace the local website checkout's files.
python_binary(
    name = "publish",
    main_module = "pg_book_build.publish",
    visibility = ["PUBLIC"],
    deps = [
        ":build_support",
        ":publish_resources",
    ],
)
