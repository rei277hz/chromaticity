load("//build_defs:artifacts.bzl", "generate", "source_tree")
load(":rules.bzl", "documentation")
load("//products/perceptual-grade-book/print:rules.bzl", "book_exports")

source_tree(
    name = "docs",
    srcs = {
        path.removeprefix("docs/"): path
        for path in glob(["docs/**"], exclude = ["docs/book/src/assets/icons/*.png"])
    },
    visibility = ["PUBLIC"],
)

# Independent authored inputs keep a chapter edit out of media generation.
[
    source_tree(
        name = name,
        srcs = {path.removeprefix(prefix): path for path in glob(patterns)},
        visibility = ["PUBLIC"],
    )
    for name, prefix, patterns in [
        (
            "book_data",
            "docs/data/",
            ["docs/data/*.json"],
        ),
        (
            "book_screenshots",
            "docs/media/screenshots/",
            ["docs/media/screenshots/*.png"],
        ),
        (
            "book_recordings",
            "docs/media/demos/",
            [
                "docs/media/demos/**/*.mov",
                "docs/media/demos/**/*.MOV",
            ],
        ),
        (
            "book_intro_recording",
            "docs/media/intro/",
            ["docs/media/intro/*.mp4"],
        ),
    ]
]

source_tree(
    name = "historical",
    srcs = {path.removeprefix("historical/"): path for path in glob(["historical/**"])},
    visibility = ["PUBLIC"],
)

export_file(
    name = "historical_manifest",
    src = "historical-manifest.json",
    visibility = ["PUBLIC"],
)

alias(
    name = "tool_pins",
    actual = "//third_party/book:pins",
    visibility = ["PUBLIC"],
)

source_tree(
    name = "data_downloads",
    srcs = {
        "src/downloads/benchmark.json": "docs/data/benchmark.json",
        "src/downloads/photo-grades.json": "docs/data/photo-grades.json",
    },
    visibility = ["PUBLIC"],
)

source_tree(
    name = "policy_diagram_sources",
    srcs = {path.removeprefix("docs/book/diagrams/"): path for path in glob(["docs/book/diagrams/*.d2"])},
    visibility = ["PUBLIC"],
)

source_tree(
    name = "historical_figure_inputs",
    srcs = {
        "shaper.zip": "docs/book/src/downloads/lut-shaper-report.zip",
        "shaper-selection.json": "docs/book/src/downloads/lut-shaper-selection.json",
        "domain-report.md": "docs/engineering/lut-domain128/report.md",
        "domain-selection.json": "docs/book/src/downloads/lut-domain128-selection.json",
    },
    visibility = ["PUBLIC"],
)

python_library(
    name = "build_support",
    srcs = {path.removeprefix("tools/"): path for path in glob(["tools/*.py"])},
    base_module = "pg_book_build",
    visibility = ["PUBLIC"],
)

[
    python_binary(
        name = name,
        main_module = "pg_book_build." + module,
        deps = [":build_support"],
    )
    for name, module in [
        ("assemble_tool", "assemble"),
        ("site_tool", "site"),
        ("archive_tool", "deploy"),
        ("book_refs_tool", "book_refs"),
    ]
]

generate(
    name = "book_inputs",
    args = [
        "--docs",
        "$(location :docs)",
        "--assets",
        "$(location //products/perceptual-grade-book/generators:assets)",
        "--assets",
        "$(location //products/perceptual-grade-book/cdn:assets)",
        "--assets",
        "$(location //products/perceptual-grade-book/diagrams:assets)",
        "--assets",
        "$(location :data_downloads)",
        "--historical",
        "$(location :historical)",
        "--manifest",
        "$(location :historical_manifest)",
    ],
    outputs = {
        "user-manual": "user-manual",
        "technical-report": "technical-report",
    },
    tool = ":assemble_tool",
    visibility = ["PUBLIC"],
)

documentation(
    name = "site",
    book = ":book_inputs",
    mdbook = "//third_party/rust:mdbook-mdbook",
    pins = ":tool_pins",
    rust_versions = "//third_party/rust/tools:versions",
    tool = ":site_tool",
    visibility = ["PUBLIC"],
)

generate(
    name = "book_refs",
    args = [
        "--docs", "$(location :docs)",
        "--site", "$(location :site[html])",
        "--sources", "$(location //products/perceptual-grade-next-blender:book_reference_sources)",
    ],
    outputs = {
        "json": "book-refs.json",
        "text": "book-refs.txt",
    },
    tool = ":book_refs_tool",
    visibility = ["PUBLIC"],
)

