direction: down

disposal: "disposal"
retirement: "retirement"
fence: "fence"
detach: "detach"
observe: "observe"
evict: "evict"
recheck: "recheck"
remove: "remove"
terminal: "terminal" {
  style.double-border: true
}

disposal -> fence: "begin"
retirement -> observe: "begin"
fence -> detach: "success"
fence -> terminal: "failed"
detach -> observe: "receipt"
observe -> evict: "success, not live or eligible"
observe -> terminal: "failed or live and ineligible"
evict -> recheck: "success"
evict -> terminal: "failed"
recheck -> remove: "success, eligible"
recheck -> terminal: "failed or ineligible"
remove -> terminal: "receipt"

**.style.font-size: 32
(** -> **)[*].style.font-size: 24
