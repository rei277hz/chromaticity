direction: down

idle: "Idle\nrunning=None"
active: "Running A\ndesired=A"
queued: "Running A\ndesired=B"
next: "Running B\ndesired=B"
idle -> active: "request A / prepare"
active -> idle: "final A"
active -> active: "preview A"
active -> queued: "request B"
queued -> queued: "new demand / preview A"
queued -> next: "final A / prepare B"
next -> idle: "final B"

**.style.font-size: 20
(** -> **)[*].style.font-size: 20
