shape: sequence_diagram

consumer: "Execution consumer"
policy: "Helper policy"
process: "Helper / transport"

consumer -> policy: "launch(probe_id)"
startup: "Startup and probe" {
  policy -> consumer: "launch and set startup deadline"
  consumer -> process: "spawn with session UUID and token"
  process -> consumer: "hello(protocol=2, session, token)"
  consumer -> policy: "hello after handshake checks"
  policy -> consumer: "dispatch probe and clear startup deadline"
  consumer -> process: "run(job=probe_id, session)"
  process -> consumer: "probe result(job, session)"
  consumer -> policy: "probe_result(job_id=probe_id)"
  policy -> consumer: "publish probe result and enter ready with idle slot"
}
work: "loop [submit, optional cancel, preview and final receipts]" {
  consumer -> policy: "submit after ready / cancel / correlated receipt"
  policy -> consumer: "dispatch / send_cancel / pump / publish"
  opt transport work authorized: {
    consumer -> process: "authorized frame(session, job) or transport pump"
  }
  process -> consumer: "preview / result / cancelled(session, job)"
  consumer -> policy: "receipt for matching session and active job"
}
consumer -> policy: "shutdown(channel)"
shutdown: "loop [shutdown, timeout escalation, physical exit]" {
  policy -> consumer: "send_shutdown / terminate / kill"
  consumer -> process: "perform authorized shutdown step"
  process -> consumer: "transport or physical-exit observation"
  consumer -> policy: "poll / timeout(current deadline stage) / exited"
  policy -> consumer: "escalate only when stage matches phase"
}
opt physical exit observed: {
  policy -> consumer: "settle probe or job, settle queue, clean up"
  consumer -> consumer: "release transport resources"
  consumer -> policy: "cleanup_result"
}

**.style.font-size: 44
(** -> **)[*].style.font-size: 44
**.style.font-color: "#111827"
**.style.italic: false
(** -> **)[*].style.font-color: "#111827"
(** -> **)[*].style.italic: false
