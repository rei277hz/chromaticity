direction: down

absent: "gesture=None"
armed: "armed"
active: "active"
finishing_armed: "finishing_armed"
finishing_active: "finishing_active"
absent -> armed: "press"
armed -> active: "move [>= 3 px on either axis]"
armed -> finishing_armed: "deferred finish"
active -> finishing_active: "deferred finish"
finishing_armed -> absent: "observe"
finishing_active -> absent: "observe"

