direction: down

idle: "idle"
repair_gate: "repair_gate"
repair_stage: "repair_stage"
stage: "stage"
select: "select"
deliver: "deliver"
restore_selector: "restore_selector"
fail: "fail"
terminal: "terminal" {
  style.double-border: true
}

idle -> fail: "begin [invalid or denied]\n/ fail_closed"
idle -> stage: "begin [admitted, active valid]"
idle -> repair_gate: "begin [admitted, active invalid]\n/ fail_closed"
repair_gate -> repair_gate: "closed [failed]\n/ fail_closed"
repair_gate -> repair_stage: "closed [success]\n/ repair"
stage -> select: "staged [success, clean]"
stage -> fail: "staged [failed or unclean]\n/ fail_closed"
repair_stage -> select: "staged [success, clean]"
repair_stage -> fail: "staged [failed or unclean]\n/ fail_closed"
select -> deliver: "selected [success, matching]"
select -> restore_selector: "selected [failed or mismatch]"
deliver -> terminal: "delivered [success]"
deliver -> restore_selector: "delivered [failed]"
restore_selector -> fail: "restored\n/ fail_closed"
fail -> fail: "closed [failed]\n/ fail_closed"
fail -> terminal: "closed [success]"

**.style.font-size: 32
(** -> **)[*].style.font-size: 24
