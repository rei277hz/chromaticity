direction: down

pending: "pending"
preview: "preview"
current: "current"
error: "error"

pending -> preview: "install [preview]"
pending -> current: "install\n[full, matching]"
preview -> current: "install\n[full, matching]"
current -> preview: "request [new demand]"
preview -> preview: "request\n[new demand]"
pending -> error: "receipt\n[current\nerror]"
preview -> error: "receipt\n[current\nerror]"
current -> error: "receipt\n[current\nerror]"
error -> pending: "request"
error -> current: "recovery\n[full, matching]"

**.style.font-size: 32
(** -> **)[*].style.font-size: 24
