shape: sequence_diagram

manager: "Bake manager"
policy: "Bake policy"
freshness: "Bake freshness policy"
helper: "Native Blender helper"
host: "Publication gate + Blender"

opt file load or undo: {
  host -> manager: "restore binding, Use Bake,\nand cheap persisted receipt"
  manager -> freshness: "compare graph/settings and Image metadata;\nrebaseline transient per-ID generations"
  alt persisted receipt: {
    matching: "stable facts match" {
      freshness -> manager: "preserve receipt and Use Bake"
      manager -> host: "reconcile the restored selection"
    }
    changed: "missing or mismatched" {
      freshness -> manager: "revoke receipt; select live;\ndisable Use Bake until rebake"
      manager -> host: "apply revocation effects"
    }
  }
}
manager -> host: "require current kernels; resolve domain/backend;\nfreeze scene, sources, and enabled Cycles GPU devices"
manager -> freshness: "capture cheap metadata, per-ID generations,\ngraph/settings, engine, and device selection"
freshness -> manager: "current request receipt"
manager -> policy: "request(signature)"
policy -> manager: "enqueue; reserve this node"
manager -> policy: "start when the helper slot is free"
policy -> manager: "start"
manager -> helper: "submit immutable snapshot with unique artifact directory"
alt shader evaluator: {
  eevee_image: "EEVEE Image route" {
    helper -> helper: "render a private orthographic plane;\nreconstruct signed-HDR values from AOVs"
  }
  cycles_shader: "Cycles Image or UV route" {
    helper -> helper: "evaluate native Grade or Stack LUT\non the selected CPU/GPU device"
  }
  compositor: "Compositor route" {
    helper -> helper: "evaluate native compositor tree\nwith its existing output route"
  }
}
opt source changes or cancellation: {
  host -> manager: "notified Image edit / explicit invalidate_image;\nsource or settings observation changes"
  manager -> freshness: "advance affected per-ID generation;\ncompare every bound node, including Use Bake off"
  freshness -> manager: "revoke receipt; select live;\ndisable Use Bake until rebake"
  manager -> host: "apply revocation effects"
  manager -> policy: "invalidate or close"
  policy -> manager: "cancel; retain running ownership"
  manager -> helper: "request cancellation"
}
helper -> manager: "final receipt for bake.exr, failure, or cancellation\ncorrelated by helper session and job ID"
manager -> manager: "check successful receipt's request signature"
manager -> policy: "completed(current signature) / cancelled"
alt completion: {
  obsolete: "stale, cancelled, or failed" {
    policy -> manager: "discard / retire; no image publication"
    manager -> manager: "release files\nand reservation"
  }
  current: "successful and current" {
    manager -> manager: "retain ready artifact"
    loop publication deferred: {
      manager -> host: "enter commit scope"
      host -> manager: "defer; retry on a later poll"
    }
    manager -> host: "enter admitted commit scope"
    manager -> freshness: "check current cheap metadata, dependency\ngenerations, and graph/settings digest"
    freshness -> manager: "current receipt or revocation effects"
    manager -> policy: "publish(current signature)"
    policy -> manager: "publish"
    manager -> host: "snapshot destination; upload, pack;\ncommit Image metadata and receipt"
    host -> manager: "publication receipt"
    manager -> policy: "published(receipt, current signature)"
    opt publication succeeded and remains current: {
      policy -> manager: "activate"
      manager -> freshness: "install completed receipt"
      freshness -> manager: "enable Use Bake; reconcile readers"
      manager -> host: "select baked output;\nsynchronize shared readers"
      host -> manager: "activation receipt"
      manager -> policy: "activated(receipt, current signature)"
    }
    opt activation succeeded and remains current: {
      policy -> manager: "retire"
    }
    opt publication or activation failed or became stale: {
      policy -> manager: "rollback"
      manager -> host: "restore image and metadata;\nfail closed if restoration fails"
    }
    manager -> manager: "retire files and reservation\nafter the terminal effect"
    manager -> host: "leave the same commit scope"
  }
}
loop after publication, including Use Bake off: {
  host -> manager: "observe source metadata and notified changes"
  manager -> freshness: "compare receipt and Image generations"
  opt source or settings changed: {
    freshness -> manager: "revoke receipt; select live;\ndisable Use Bake until rebake"
    manager -> host: "apply revocation effects to all affected readers"
  }
}

**.style.font-size: 44
(** -> **)[*].style.font-size: 44
**.style.font-color: "#111827"
**.style.italic: false
(** -> **)[*].style.font-color: "#111827"
(** -> **)[*].style.italic: false
