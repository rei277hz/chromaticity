shape: sequence_diagram

consumer: "Lifecycle consumer"
policy: "Resource policy"
blender: "Blender resource / registry"

consumer -> policy: "new_disposal / new_retirement; step(Event())"
opt node disposal: {
  disposal: "loop [fence, detach; stop if fence fails]" {
    policy -> consumer: "fence / detach"
    consumer -> blender: "fence subscriptions / detach users"
    blender -> consumer: "operation receipt or error"
    consumer -> policy: "Event(failed)"
  }
}
opt fence succeeded or ordinary retirement: {
  policy -> consumer: "observe"
  consumer -> blender: "read current facts"
  blender -> consumer: "live, owned, users, protected, retain_for_undo"
  consumer -> policy: "Event(facts or failed)"
  alt observed lifetime: {
    undo_retained: "live, owned, retain_for_undo" {
      policy -> consumer: "retain"
      consumer -> blender: "set fake user"
      consumer -> policy: "operation receipt"
      policy -> consumer: "terminal; no eviction or removal"
    }
    removal_candidate: "not live or eligible" {
      retirement: "loop [evict, recheck, remove]\nadvance only on an authorizing receipt" {
        policy -> consumer: "evict / recheck / remove"
        consumer -> blender: "evict / reread facts / remove"
        blender -> consumer: "fresh facts or operation receipt"
        consumer -> policy: "Event(facts or failed)"
      }
      policy -> consumer: "terminal; removal only if fresh recheck eligible"
    }
    retained: "failed observation or live and ineligible" {
      policy -> consumer: "terminal; no removal effect"
    }
  }
}

**.style.font-size: 44
(** -> **)[*].style.font-size: 44
**.style.font-color: "#111827"
**.style.italic: false
(** -> **)[*].style.font-color: "#111827"
(** -> **)[*].style.italic: false
