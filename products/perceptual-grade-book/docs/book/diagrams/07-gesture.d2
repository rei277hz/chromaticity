direction: down

none: "current=None\npending=None"
current: "current!=None\npending=None"
pending: "current=None\npending!=None"
replacing: "current!=None\npending!=None"

none -> pending: "window / invoke"
current -> replacing: "handoff [eligible] / invoke"
pending -> current: "installed [success]"
replacing -> current: "installed [success]"
pending -> none: "installed [failure];\nlost [pending]"
replacing -> current: "installed [failure];\nlost [pending]"
replacing -> pending: "lost [current]"
current -> none: "lost [current]"
pending -> none: "reset / clear"
replacing -> none: "reset / clear"
current -> none: "reset / clear"

**.style.font-size: 32
(** -> **)[*].style.font-size: 24
