shape: sequence_diagram

render: "Render thread"
gate: "Gate + ticket policy"
consumer: "Main-thread consumer"
blender: "Blender scene / nodes"

render -> gate: "request scene and time; bind ticket to render lease"
loop admission until this ticket's exclusive scope is available: {
  consumer -> gate: "take active ticket; enter render_preflight"
  gate -> consumer: "admit or defer and requeue same ticket"
}
consumer -> blender: "resolve scene; set requested frame/subframe"
consumer -> blender: "reconcile Grade nodes; wait for preparation"
blender -> consumer: "observe live scene/time; validate Grade signature/output"
consumer -> gate: "publish for this active ticket"
gate -> consumer: "recheck ticket and exclusive render access"
alt publication result: {
  exact: "scene/time match; exact signature; outputs current" {
    gate -> consumer: "release"
    consumer -> gate: "leave scope; deliver"
    gate -> render: "wake; continue frame"
  }
  failed: "mismatch or error" {
    gate -> consumer: "fail with error"
    consumer -> blender: "attempt visible failure output"
    consumer -> gate: "finish_render_preflight_failure"
    gate -> render: "wake; raise failure"
  }
}

**.style.font-size: 44
(** -> **)[*].style.font-size: 44
**.style.font-color: "#111827"
**.style.italic: false
(** -> **)[*].style.font-color: "#111827"
(** -> **)[*].style.italic: false
