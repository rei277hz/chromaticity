direction: down

idle: "idle"
stage: "stage"
snapshot: "snapshot"
bind: "bind"
commit: "commit"
activate: "activate"
deliver: "deliver"
restore_bindings: "restore_bindings"
restore_metadata: "restore_metadata"
restore_resource: "restore_resource"
fail: "fail"
retire: "retire"
terminal: "terminal" {
  style.double-border: true
}

idle -> stage: "begin"
stage -> snapshot: "success, clean"
stage -> fail: "failed or unclean"
snapshot -> bind: "success"
snapshot -> fail: "failed"
bind -> commit: "success"
bind -> restore_bindings: "failed"
commit -> activate: "success"
commit -> restore_bindings: "failed"
activate -> deliver: "success"
activate -> restore_bindings: "failed"
deliver -> retire: "success"
deliver -> restore_bindings: "failed"
restore_bindings -> restore_metadata: "receipt"
restore_metadata -> restore_resource: "receipt"
restore_resource -> fail: "receipt"
fail -> retire: "receipt"
retire -> terminal: "receipt"

**.style.font-size: 32
(** -> **)[*].style.font-size: 24
