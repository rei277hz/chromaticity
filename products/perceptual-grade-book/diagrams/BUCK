load("//products/perceptual-grade-book/generators:rules.bzl", "book_generate")
load("//build_defs:artifacts.bzl", "generate")
load("//products/perceptual-grade-book/print:native_packages.bzl", "NATIVE_PACKAGES")
load(":native_packages.bzl", "BROWSER_PACKAGES")

NATIVE_RUNTIME_PACKAGES = dict(NATIVE_PACKAGES, **BROWSER_PACKAGES)

[http_file(
    name = "native_" + name + "_archive",
    out = spec["filename"],
    sha256 = spec["sha256"],
    urls = [spec["url"]],
) for name, spec in NATIVE_RUNTIME_PACKAGES.items()]

generate(
    name = "native_runtime",
    args = [arg for name in NATIVE_RUNTIME_PACKAGES for arg in [
        "--archive", "$(location :native_" + name + "_archive)",
    ]],
    outputs = {"libraries": "usr/lib/x86_64-linux-gnu"},
    tool = "//products/perceptual-grade-book/print:native_unpack",
)

# D2 embeds its fonts in the SVG. The remote action does not discover a host D2.
http_file(
    name = "d2_archive",
    out = "d2-v0.9.0-linux-amd64.tar.gz",
    sha256 = "5669ddc46b99e942cc96078f4a4e36d5e62103348f4c05179ede27802fdd87a9",
    urls = ["https://github.com/d2lang/d2/releases/download/v0.9.0/d2-v0.9.0-linux-amd64.tar.gz"],
)

python_library(
    name = "support",
    srcs = ["render.py"],
    base_module = "pg_book_diagrams",
)

python_binary(
    name = "renderer",
    main_module = "pg_book_diagrams.render",
    deps = [":support"],
)

