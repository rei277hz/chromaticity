invariant_proof(
    name = "project_unbounded_proof",
    required_mutations = [
        "ignore_artifact_revision",
        "ignore_required_evaluator_match",
        "accept_artifact_tail",
        "ignore_repair_debt",
    ],
    required_properties = [
        "T01_unbounded_worklist_covers_every_owner",
        "T02_unbounded_artifacts_match_revision_and_evaluator",
        "T03_unbounded_artifact_evaluator_matches_required_owner",
        "J07_unbounded_repair_debt_blocks_readiness",
    ],
    required_witnesses = ["five_aligned_ready_owners_are_accepted"],
    requirements = "requirements/project_unbounded.inv",
    runtime_contracts = "perceptual_grade_next_core/workflow/_project_unbounded_contracts.py",
    runtime_source = "perceptual_grade_next_core/workflow/project_unbounded.py",
    source = "src/perceptual_grade_next_core/workflow/project_unbounded.py",
    # The quantified J07 mutation counterexample can exceed 10 seconds under
    # concurrent builds. Give each solver query a minute; retain every obligation.
    timeout_ms = 60000,
    visibility = ["PUBLIC"],
)

