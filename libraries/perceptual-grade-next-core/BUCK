PREFIX = "src/perceptual_grade_next_core/"

SOURCES = {path[len(PREFIX):]: path for path in glob([PREFIX + "**/*.py"])}

RUNTIME_RESOURCES = {
    "workflow/_preflight_contracts.py": ":preflight_proof[validators]",
    "workflow/_scope_contracts.py": ":scope_proof[validators]",
    "workflow/_project_contracts.py": ":project_proof[validators]",
    "workflow/_project_unbounded_contracts.py": ":project_unbounded_proof[validators]",
    "workflow/_restart_contracts.py": ":restart_proof[validators]",
    "workflow/_foreground_contracts.py": ":foreground_proof[validators]",
    "workflow/_preparation_contracts.py": ":preparation_proof[validators]",
    "workflow/_recovery_policy_contracts.py": ":recovery_proof[validators]",
    "workflow/_composed_contracts.py": ":composition_proof[validators]",
}

component_library(
    name = "runtime",
    srcs = SOURCES,
    external_deps = ["//third_party:numpy"],
    package = "perceptual_grade_next_core",
    resources = RUNTIME_RESOURCES,
    visibility = ["PUBLIC"],
    deps = ["//libraries/color-core:runtime"],
)

# Temporary opt-in: omit only the unbounded project's generated contracts and
# proof dependency. The normal runtime and verification aggregates stay intact.
component_library(
    name = "unsafe_runtime",
    srcs = SOURCES,
    external_deps = ["//third_party:numpy"],
    package = "perceptual_grade_next_core",
    resources = {
        path: source
        for path, source in RUNTIME_RESOURCES.items()
        if path != "workflow/_project_unbounded_contracts.py"
    },
    visibility = ["PUBLIC"],
    deps = ["//libraries/color-core:runtime"],
)

