        "closed_owner_cannot_restore_authority",
        "failure_requires_explicit_retry",
        "retry_requires_a_failed_source",
        "closed_completion_cannot_become_ready",
        "equal_observation_keeps_failed_verdict",
    ],
    required_witnesses = [
        "open_owner_for_observation",
        "a_b_a_requires_distinct_source_revisions",
        "explicit_retry_starts_a_fresh_check",
