invariant_proof(
    name = "project_proof",
    required_mutations = [
        "open_accepts_unpaired_owner_evaluator",
        "owner_readiness_ignores_repair_debt",
        "owner_readiness_ignores_expected_evaluator",
        "save_starts_without_owner_readiness",
        "render_starts_without_owner_readiness",
        "owner_ready_accepts_repair_debt",
        "save_completion_accepts_stale_operation",
        "bake_accepts_another_evaluator",
        "render_accepts_stale_operation",
    ],
    required_properties = [
        "owner_worklist_has_exact_evaluator_slots",
        "owner_worklist_rejects_duplicate_or_unpaired_entries",
        "every_required_owner_has_current_matching_artifact",
        "ready_artifact_evaluator_matches_its_required_owner",
        "owner_ready_receipt_matches_required_evaluator",
        "save_start_requires_complete_current_owner_readiness",
        "render_start_requires_complete_current_owner_readiness",
        "repair_debt_blocks_ready_receipt_until_fresh_retry",
        "bake_completion_matches_admitted_receipt",
        "save_completion_requires_invoked_operation",
        "render_completion_requires_invoked_operation",
    ],
    required_witnesses = [
        "all_owners_ready_then_failure_retry_requires_fresh_receipt",
        "accepted_save_holds_publication_until_exact_terminal_receipt",
    ],
    requirements = "requirements/project.inv",
    runtime_contracts = "perceptual_grade_next_core/workflow/_project_contracts.py",
    runtime_source = "perceptual_grade_next_core/workflow/project_proof.py",
