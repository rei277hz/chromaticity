{
  "version": 1,
  "state": "ComposedState",
  "event": "ComposedEvent",
  "initializers": [
    "new_composed"
  ],
  "step": "composed_step",
  "invariants": {
    "closed_view_is_hidden": "state.phase != 'closed' or not state.view_visible",
    "physical_states_are_named": "state.scope_physical in ('none','live','retiring') and state.bake_physical in ('none','live','retiring')"
  },
  "contracts": {
    "new_composed": {
      "ensures": [
        "result.phase == 'closed' and not result.view_visible"
      ]
    }
  },
  "properties": [
    {
      "name": "C01_current_generation_required_for_scope",
      "variables": {
        "state": "ComposedState",
        "event": "ComposedEvent"
      },
      "lets": {
        "after": "composed_step(state,event)"
      },
      "assert": "not after[1] or event.kind != 'scope_begin' or (event.generation > 0 and event.generation == state.generation and event.owner != 0 and event.request > 0 and event.submission != 0 and event.resource != 0)"
    },
    {
      "name": "C02_restart_revokes_view_and_fences_generation",
      "variables": {
        "state": "ComposedState",
        "event": "ComposedEvent"
      },
      "lets": {
        "after": "composed_step(state,event)"
      },
      "assert": "not after[1] or event.kind != 'restart' or (not after[0].view_visible and after[0].phase == 'restarting' and after[0].generation == event.generation)"
    },
    {
      "name": "C09_restart_rejects_duplicate_obligations",
      "variables": {
        "state": "ComposedState",
        "event": "ComposedEvent"
      },
      "lets": {
        "after": "composed_step(state,event)"
      },
      "assert": "not after[1] or event.kind != 'restart' or _unique(event.obligations)"
    },
    {
      "name": "C03_restart_waits_for_physical_retirement",
      "variables": {
        "state": "ComposedState",
        "event": "ComposedEvent"
      },
      "lets": {
        "after": "composed_step(state,event)"
      },
      "assert": "not after[1] or event.kind != 'restart_complete' or (state.scope_physical == 'none' and state.bake_physical == 'none' and _same_members(state.restart_retired,state.restart_obligations))"
    },
    {
      "name": "C04_close_revokes_view_while_scope_retires",
      "variables": {
        "state": "ComposedState",
        "event": "ComposedEvent"
      },
      "lets": {
        "after": "composed_step(state,event)"
      },
      "assert": "not after[1] or event.kind != 'scope_close' or (not after[0].view_visible and (after[0].scope_physical == 'retiring' or after[0].scope_physical == 'none'))"
    },
    {
      "name": "C05_publication_hold_blocks_bake_start",
      "variables": {
        "state": "ComposedState",
        "event": "ComposedEvent"
      },
      "assume": [
        "state.publication_hold and event.kind == 'bake_start'"
      ],
      "lets": {
        "after": "composed_step(state,event)"
      },
      "assert": "after[0] == state and not after[1]"
    },
    {
      "name": "C06_scope_receipt_cannot_clear_project_hold",
      "variables": {
        "state": "ComposedState",
        "event": "ComposedEvent"
      },
      "assume": [
        "state.publication_hold and state.scope_physical == 'retiring' and event.kind == 'scope_retired' and event.generation == state.scope_generation and event.owner == state.scope_owner and event.request == state.scope_request and event.submission == state.scope_submission and event.resource == state.scope_resource"
      ],
      "lets": {
        "after": "composed_step(state,event)"
      },
      "assert": "after[0].publication_hold"
    },
    {
      "name": "C07_old_scope_receipt_cannot_advance_new_generation",
      "variables": {
        "state": "ComposedState",
        "event": "ComposedEvent"
      },
      "assume": [
        "state.scope_physical == 'retiring' and event.kind == 'scope_retired' and (event.generation != state.scope_generation or event.owner != state.scope_owner or event.request != state.scope_request or event.submission != state.scope_submission or event.resource != state.scope_resource)"
      ],
      "lets": {
        "after": "composed_step(state,event)"
      },
      "assert": "after[0] == state and not after[1]"
    },
    {
      "name": "C08_restart_does_not_replay_old_authority",
      "variables": {
        "state": "ComposedState",
        "event": "ComposedEvent"
      },
      "lets": {
        "after": "composed_step(state,event)"
      },
      "assert": "not after[1] or event.kind != 'restart' or (not after[0].view_visible and not after[0].publication_hold)"
    },
    {
      "name": "C10_scope_retirement_matches_original_work",
      "variables": {
        "state": "ComposedState",
        "event": "ComposedEvent"
      },
      "assume": [
        "state.scope_physical == 'retiring' and event.kind == 'scope_retired'"
      ],
      "lets": {
        "after": "composed_step(state,event)"
      },
      "assert": "after[1] or (after[0] == state and event.generation != state.scope_generation) or (after[0] == state and event.owner != state.scope_owner) or (after[0] == state and event.request != state.scope_request) or (after[0] == state and event.submission != state.scope_submission) or (after[0] == state and event.resource != state.scope_resource)"
    },
    {
      "name": "C11_bake_retirement_matches_original_work",
      "variables": {
        "state": "ComposedState",
        "event": "ComposedEvent"
      },
      "assume": [
        "state.bake_physical in ('live','retiring') and event.kind == 'bake_retired'"
      ],
      "lets": {
        "after": "composed_step(state,event)"
      },
      "assert": "after[1] or (after[0] == state and event.generation != state.bake_generation) or (after[0] == state and event.identity != state.bake_identity)"
    },
    {
      "name": "C12_restart_preserves_old_scope_receipt_identity",
      "variables": {
        "state": "ComposedState",
        "event": "ComposedEvent"
      },
      "assume": [
        "state.scope_physical == 'live' and event.kind == 'restart'"
      ],
      "lets": {
        "after": "composed_step(state,event)"
      },
      "assert": "not after[1] or (after[0].scope_physical == 'retiring' and after[0].scope_generation == state.scope_generation and after[0].scope_owner == state.scope_owner and after[0].scope_request == state.scope_request and after[0].scope_submission == state.scope_submission and after[0].scope_resource == state.scope_resource)"
    }
  ],
  "witnesses": [
    {
      "name": "close_hides_view_before_scope_retirement",
      "lets": {
        "opened": "composed_step(new_composed(),ComposedEvent('open',generation=1,epoch=1))",
        "begun": "composed_step(opened[0],ComposedEvent('scope_begin',generation=1,owner='scope-owner',request=1,submission='scope-submission',resource='scope-resource'))",
        "closed": "composed_step(begun[0],ComposedEvent('scope_close',generation=1))",
        "retired": "composed_step(closed[0],ComposedEvent('scope_retired',generation=1,owner='scope-owner',request=1,submission='scope-submission',resource='scope-resource'))"
      },
      "assert": "opened[1] and begun[1] and closed[1] and not closed[0].view_visible and closed[0].scope_physical == 'retiring' and retired[1] and retired[0].scope_physical == 'none'"
    },
    {
      "name": "save_hold_blocks_bake_across_scope_close",
      "lets": {
        "opened": "composed_step(new_composed(),ComposedEvent('open',generation=1,epoch=1))",
        "held": "composed_step(opened[0],ComposedEvent('publication_hold',generation=1))",
        "closed": "composed_step(held[0],ComposedEvent('scope_close',generation=1))",
        "bake": "composed_step(closed[0],ComposedEvent('bake_start',generation=1,identity='bake-1'))"
      },
      "assert": "opened[1] and held[1] and closed[1] and bake[0].publication_hold and not bake[1]"
    },
    {
      "name": "restart_accepts_only_exact_late_scope_retirement",
      "lets": {
        "opened": "composed_step(new_composed(),ComposedEvent('open',generation=1,epoch=1))",
        "begun": "composed_step(opened[0],ComposedEvent('scope_begin',generation=1,owner='scope-owner',request=4,submission='old-submission',resource='old-resource'))",
        "restarting": "composed_step(begun[0],ComposedEvent('restart',generation=2,obligations=('scope','updates'))) ",
        "wrong": "composed_step(restarting[0],ComposedEvent('scope_retired',generation=2,owner='scope-owner',request=4,submission='old-submission',resource='old-resource'))",
        "late": "composed_step(restarting[0],ComposedEvent('scope_retired',generation=1,owner='scope-owner',request=4,submission='old-submission',resource='old-resource'))",
        "duplicate": "composed_step(late[0],ComposedEvent('scope_retired',generation=1,owner='scope-owner',request=4,submission='old-submission',resource='old-resource'))",
        "scope_receipt": "composed_step(late[0],ComposedEvent('obligation_retired',generation=2,identity='scope'))",
        "updates_receipt": "composed_step(scope_receipt[0],ComposedEvent('obligation_retired',generation=2,identity='updates'))",
        "complete": "composed_step(updates_receipt[0],ComposedEvent('restart_complete',generation=2))"
      },
      "assert": "opened[1] and begun[1] and restarting[1] and not wrong[1] and late[1] and late[0].scope_physical == 'none' and not duplicate[1] and scope_receipt[1] and updates_receipt[1] and complete[1] and complete[0].phase == 'active'"
    },
    {
      "name": "restarted_bake_accepts_exact_old_terminal_receipt",
      "lets": {
        "opened": "composed_step(new_composed(),ComposedEvent('open',generation=1,epoch=1))",
        "started": "composed_step(opened[0],ComposedEvent('bake_start',generation=1,identity='bake-submission'))",
        "restarting": "composed_step(started[0],ComposedEvent('restart',generation=2,obligations=('bake',)))",
        "wrong": "composed_step(restarting[0],ComposedEvent('bake_retired',generation=2,identity='bake-submission'))",
        "retired": "composed_step(restarting[0],ComposedEvent('bake_retired',generation=1,identity='bake-submission'))"
      },
      "assert": "opened[1] and started[1] and restarting[1] and not wrong[1] and retired[1] and retired[0].bake_physical == 'none'"
    }
  ],
  "mutations": [
    {
      "name": "scope_receipt_clears_project_hold",
      "function": "composed_step",
      "target": "replace(state, scope_physical=\"none\", scope_generation=0, scope_owner=0, scope_request=0, scope_submission=0, scope_resource=0)",
      "replacement": "replace(state, scope_physical=\"none\", scope_generation=0, scope_owner=0, scope_request=0, scope_submission=0, scope_resource=0, publication_hold=False)",
      "detects": [
        "property.C06_scope_receipt_cannot_clear_project_hold"
      ]
    },
    {
      "name": "restart_completes_before_retirement",
      "function": "composed_step",
      "target": "_same_members(state.restart_retired, state.restart_obligations)",
      "replacement": "True",
      "detects": [
        "property.C03_restart_waits_for_physical_retirement"
      ]
    },
    {
      "name": "restart_accepts_duplicate_obligations",
      "function": "composed_step",
      "target": "_unique(event.obligations)",
      "replacement": "True",
      "detects": [
        "property.C09_restart_rejects_duplicate_obligations"
      ]
    },
    {
      "name": "scope_retirement_checks_current_generation_instead_of_receipt_generation",
      "function": "composed_step",
      "target": "event.generation == state.scope_generation",
      "replacement": "event.generation == state.generation",
      "detects": [
        "property.C10_scope_retirement_matches_original_work"
      ]
    }
  ],
  "loops": []
}
