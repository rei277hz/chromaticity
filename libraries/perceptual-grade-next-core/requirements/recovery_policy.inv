{
  "version": 1,
  "state": "RecoveryState",
  "event": "RecoveryEvent",
  "initializers": ["new_recovery"],
  "step": "recovery_step",
  "invariants": {"generation_nonnegative": "state.generation >= 0"},
  "contracts": {"new_recovery": {"ensures": ["result.phase == 'closed' and not result.replay"]}},
  "properties": [
    {"name":"reopen_discards_prior_authority","variables":{"state":"RecoveryState","event":"RecoveryEvent"},"lets":{"after":"recovery_step(state,event)"},"assert":"not after[1] or event.kind != 'open' or (after[0].generation == event.generation and after[0].replay == False)"},
    {"name":"reuse_requires_derived_validation","variables":{"state":"RecoveryState","event":"RecoveryEvent"},"lets":{"after":"recovery_step(state,event)"},"assert":"not after[1] or event.kind != 'reuse' or (event.derived_valid and after[0].phase == 'ready')"},
    {"name":"queue_creates_preparation_demand","variables":{"state":"RecoveryState","event":"RecoveryEvent"},"lets":{"after":"recovery_step(state,event)"},"assert":"not after[1] or event.kind != 'queue' or (after[0].phase == 'preparing' and after[0].queued)"},
    {"name":"recovery_generation_must_be_fresh","variables":{"state":"RecoveryState","event":"RecoveryEvent"},"assume":["event.kind == 'open' and event.generation <= state.generation"],"lets":{"after":"recovery_step(state,event)"},"assert":"after[0] == state and not after[1]"},
    {"name":"settled_recovery_does_not_requeue","variables":{"state":"RecoveryState","event":"RecoveryEvent"},"assume":["state.phase == 'ready' and event.kind != 'open'"],"lets":{"after":"recovery_step(state,event)"},"assert":"after[0] == state and not after[1]"},
    {"name":"queue_does_not_replay_operations","variables":{"state":"RecoveryState","event":"RecoveryEvent"},"lets":{"after":"recovery_step(state,event)"},"assert":"not after[1] or event.kind == 'discard' or not after[0].replay"},
    {"name":"discard_drops_explicit_operations","variables":{"state":"RecoveryState","event":"RecoveryEvent"},"lets":{"after":"recovery_step(state,event)"},"assert":"not after[1] or event.kind != 'discard' or not after[0].replay"},
    {"name":"ready_receipt_preserves_generation","variables":{"state":"RecoveryState","event":"RecoveryEvent"},"lets":{"after":"recovery_step(state,event)"},"assert":"after[0].phase != 'ready' or after[0].generation == state.generation"}
  ],
  "witnesses": [{"name":"recovery_queues_invalid_assets","lets":{"opened":"recovery_step(new_recovery(),RecoveryEvent('open',generation=1))","queued":"recovery_step(opened[0],RecoveryEvent('queue',generation=1))","ready":"recovery_step(queued[0],RecoveryEvent('ready',generation=1))"},"assert":"opened[1] and queued[1] and ready[1] and ready[0].phase == 'ready'"}],
  "mutations": [{"name":"recovery_accepts_stale_generation","function":"recovery_step","target":"event.generation > state.generation","replacement":"event.generation >= state.generation","detects":["property.recovery_generation_must_be_fresh"]}]
}
