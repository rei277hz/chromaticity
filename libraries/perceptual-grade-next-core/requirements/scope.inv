{
  "version": 1,
  "description": "Canonical scope inventory mapping: S02 cancelled completion preserves prior accepted input; S03 is only partially represented by the physical submission receipt (scope/request/resource incarnation binding is adapter-owned); S04 blocks a cancelled attempt from beginning again; S05 terminal read-once behavior is unrepresented (this machine accounts physical retirement only); S07 control acknowledgement and its once-only submission advance are adapter-owned; S08 this machine guards token issue/application against current accepted input, while the full staged-success/actor/foreground composite is split across scope and foreground adapters; S11 preserves a newer demand while old physical work retires; S12 preserves cancellation debt; S13 distinguishes closed/no-physical-debt from retiring work; S15 blocks acquisition/publication during playback and clears old display authority; S17 matches failure to the physical submission but component-scoped failure is unrepresented. S01, S06, S09, S10, S14, S16, S18, and S19 are unrepresented here: they require foreground lifecycle, preview occurrence, statistics/batch/resource/live-service/semantic-key/incarnation data absent from ScopeState.",
  "state": "ScopeState",
  "event": "ScopeEvent",
  "initializers": [
    "new_scope"
  ],
  "step": "scope_step",
  "invariants": {
    "physical_submission_is_owned": "state.physical == 'none' or (state.submission > 0 and state.physical in ('live','retiring'))",
    "accepted_source_is_complete": "(state.accepted_request > 0 and _identity(state.accepted_source)) or (state.accepted_request == 0 and state.accepted_source == 0)"
  },
  "contracts": {
    "new_scope": {
      "ensures": [
        "result.phase == 'idle' and result.physical == 'none' and result.submission == 0"
      ]
    }
  },
  "properties": [
    {
      "name": "completion_accounts_original_submission",
      "variables": {
        "state": "ScopeState",
        "event": "ScopeEvent"
      },
      "lets": {
        "after": "scope_step(state,event)"
      },
      "assert": "not after[1] or event.kind != 'complete' or (state.submission > 0 and event.submission == state.submission and event.generation == state.generation and event.owner == state.owner)"
    },
    {
      "name": "display_adoption_requires_current_healthy_scope",
      "variables": {
        "state": "ScopeState",
        "event": "ScopeEvent"
      },
      "lets": {
        "after": "scope_step(state,event)"
      },
      "assert": "not after[1] or event.kind != 'display_applied' or (scope_has_current_input(state) and not state.playing and event.token == state.display_token and event.token != 0 and event.token != '')"
    },
    {
      "name": "cancelled_completion_preserves_prior_accepted_input",
      "variables": {
        "state": "ScopeState",
        "event": "ScopeEvent"
      },
      "lets": {
        "after": "scope_step(state,event)"
      },
      "assert": "not after[1] or event.kind != 'complete' or not state.cancelled or (after[0].accepted_request == state.accepted_request and after[0].accepted_source == state.accepted_source)"
    },
    {
      "name": "operation_receipt_matches_owner_generation_serial",
      "variables": {
        "state": "ScopeState",
        "event": "ScopeEvent"
      },
      "lets": {
        "after": "scope_step(state,event)"
      },
      "assert": "not after[1] or event.kind not in ('complete','retired','cancel','fail') or (event.generation == state.generation and event.owner == state.owner and event.submission == state.submission)"
    },
    {
      "name": "cancelled_attempt_cannot_begin_again",
      "variables": {
        "state": "ScopeState",
        "event": "ScopeEvent"
      },
      "lets": {
        "after": "scope_step(state,event)"
      },
      "assert": "not after[1] or event.kind != 'begin' or (not state.cancelled and not state.playing and state.phase == 'healthy' and state.physical == 'none')"
    },
    {
      "name": "retirement_consumes_matching_physical_debt",
      "variables": {
        "state": "ScopeState",
        "event": "ScopeEvent"
      },
      "lets": {
        "after": "scope_step(state,event)"
      },
      "assert": "not after[1] or event.kind != 'retired' or (state.physical == 'retiring' and event.submission == state.submission and after[0].physical == 'none' and after[0].submission == 0)"
    },
    {
      "name": "begin_advances_request_and_submission_once",
      "variables": {
        "state": "ScopeState",
        "event": "ScopeEvent"
      },
      "lets": {
        "after": "scope_step(state,event)"
      },
      "assert": "not after[1] or event.kind != 'begin' or (event.request > state.begun_request and event.submission > state.submission and after[0].submission == event.submission)"
    },
    {
      "name": "display_issue_requires_current_accepted_input",
      "variables": {
        "state": "ScopeState",
        "event": "ScopeEvent"
      },
      "lets": {
        "after": "scope_step(state,event)"
      },
      "assert": "not after[1] or event.kind != 'display_issued' or ((state.phase == 'healthy' and state.accepted_request == state.request and state.accepted_source == state.source_id and _identity(state.accepted_source)) and not state.playing and event.request == state.accepted_request and event.source_id == state.accepted_source and after[0].display_token == event.token)"
    },
    {
      "name": "new_demand_retains_old_physical_debt",
      "variables": {
        "state": "ScopeState",
        "event": "ScopeEvent"
      },
      "assume": [
        "state.physical == 'live' and state.submission > 0 and event.kind == 'demand' and event.generation == state.generation and event.owner == state.owner and event.request > state.request"
      ],
      "lets": {
        "after": "scope_step(state,event)"
      },
      "assert": "not after[1] or (after[0].phase == 'retiring' and after[0].physical == 'retiring' and after[0].pending_request == event.request and after[0].pending_source == event.source_id)"
    },
    {
      "name": "cancel_retains_physical_retirement_debt",
      "variables": {
        "state": "ScopeState",
        "event": "ScopeEvent"
      },
      "lets": {
        "after": "scope_step(state,event)"
      },
      "assert": "not after[1] or event.kind != 'cancel' or (after[0].phase == 'retiring' and after[0].physical == 'retiring' and after[0].cancelled)"
    },
    {
      "name": "close_without_physical_work_is_destroyable",
      "variables": {
        "state": "ScopeState",
        "event": "ScopeEvent"
      },
      "assume": [
        "state.physical == 'none' or state.submission > 0"
      ],
      "lets": {
        "after": "scope_step(state,event)"
      },
      "assert": "not after[1] or event.kind != 'close' or (after[0].phase == 'closed' and after[0].physical == 'none') or (after[0].phase == 'retiring' and after[0].physical == 'retiring')"
    },
    {
      "name": "playback_blocks_acquisition_and_publication",
      "variables": {
        "state": "ScopeState",
        "event": "ScopeEvent"
      },
      "lets": {
        "after": "scope_step(state,event)"
      },
      "assert": "not after[1] or event.kind not in ('demand','begin','display_issued','display_applied') or not state.playing"
    },
    {
      "name": "playback_start_revokes_prior_display_tokens",
      "variables": {
        "state": "ScopeState",
        "event": "ScopeEvent"
      },
      "lets": {
        "after": "scope_step(state,event)"
      },
      "assert": "not after[1] or event.kind != 'playback_start' or (after[0].playing and after[0].display_token == 0 and after[0].applied_token == 0)"
    },
    {
      "name": "failure_is_bound_to_exact_physical_submission",
      "variables": {
        "state": "ScopeState",
        "event": "ScopeEvent"
      },
      "lets": {
        "after": "scope_step(state,event)"
      },
      "assert": "not after[1] or event.kind != 'fail' or (event.generation == state.generation and event.owner == state.owner and event.submission == state.submission)"
    },
    {
      "name": "old_settlement_preserves_latest_demand",
      "variables": {
        "state": "ScopeState",
        "event": "ScopeEvent"
      },
      "lets": {
        "after": "scope_step(state,event)"
      },
      "assert": "not after[1] or event.kind not in ('complete','retired') or (after[0].request == state.request and after[0].source_revision == state.source_revision and after[0].source_id == state.source_id and after[0].pending_request == state.pending_request and after[0].pending_source == state.pending_source)"
    },
    {
      "name": "scope_display_receipt_is_consumed_once",
      "variables": {
        "state": "ScopeState",
        "event": "ScopeEvent"
      },
      "lets": {
        "after": "scope_step(state,event)"
      },
      "assert": "not after[1] or event.kind != 'display_applied' or event.token != state.applied_token"
    }
  ],
  "witnesses": [
    {
      "name": "view_move_retires_without_accepting_old_completion",
      "lets": {
        "opened": "scope_step(new_scope(),ScopeEvent('open',generation=1,owner=1,view_epoch=1))",
        "demanded": "scope_step(opened[0],ScopeEvent('demand',generation=1,owner=1,view_epoch=1,request=1,source_revision=1,source_id=2))",
        "begun": "scope_step(demanded[0],ScopeEvent('begin',generation=1,owner=1,view_epoch=1,request=1,source_revision=1,source_id=2,submission=1))",
        "moved": "scope_step(begun[0],ScopeEvent('move',generation=1,owner=1,view_epoch=2))",
        "completed": "scope_step(moved[0],ScopeEvent('complete',generation=1,owner=1,view_epoch=1,request=1,source_revision=1,source_id=2,submission=1))"
      },
      "assert": "moved[1] and completed[1] and completed[0].accepted_request == 0 and completed[0].physical == 'none'"
    },
    {
      "name": "playback_revokes_display_then_requires_a_fresh_demand",
      "lets": {
        "opened": "scope_step(new_scope(),ScopeEvent('open',generation=1,owner=1,view_epoch=1))",
        "demanded": "scope_step(opened[0],ScopeEvent('demand',generation=1,owner=1,view_epoch=1,request=1,source_revision=1,source_id=2))",
        "begun": "scope_step(demanded[0],ScopeEvent('begin',generation=1,owner=1,view_epoch=1,request=1,source_revision=1,source_id=2,submission=1))",
        "done": "scope_step(begun[0],ScopeEvent('complete',generation=1,owner=1,view_epoch=1,request=1,source_revision=1,source_id=2,submission=1))",
        "issued": "scope_step(done[0],ScopeEvent('display_issued',generation=1,owner=1,view_epoch=1,request=1,source_revision=1,source_id=2,token=3))",
        "playing": "scope_step(issued[0],ScopeEvent('playback_start',generation=1,owner=1,playback_epoch=1))",
        "stopped": "scope_step(playing[0],ScopeEvent('playback_stop',generation=1,owner=1,playback_epoch=1))",
        "old_apply": "scope_step(stopped[0],ScopeEvent('display_applied',generation=1,owner=1,view_epoch=1,request=1,source_revision=1,source_id=2,token=3))"
      },
      "assert": "done[1] and issued[1] and playing[1] and stopped[1] and not old_apply[1]"
    }
  ],
  "mutations": [
    {
      "name": "completion_accepts_different_submission",
      "function": "scope_step",
      "target": "event.submission == state.submission",
      "replacement": "event.submission >= state.submission",
      "detects": [
        "property.completion_accounts_original_submission"
      ]
    },
    {
      "name": "begin_reuses_consumed_request",
      "function": "scope_step",
      "target": "event.request > state.begun_request",
      "replacement": "True",
      "detects": [
        "property.begin_advances_request_and_submission_once"
      ]
    },
    {
      "name": "scope_replays_display_receipt",
      "function": "scope_step",
      "target": "event.token != state.applied_token",
      "replacement": "True",
      "detects": [
        "property.scope_display_receipt_is_consumed_once"
      ]
    },
    {
      "name": "old_input_can_issue_current_display",
      "function": "scope_has_current_input",
      "target": "state.accepted_request == state.request",
      "replacement": "True",
      "detects": [
        "property.display_issue_requires_current_accepted_input"
      ]
    }
  ]
}
