{
  "version": 1,
  "description": "Joint proof over the same scope_step and foreground_step policies called by ScopeRuntime adapters. The combined transition publishes issue/adoption only when both accept; analysis payload/statistics equality and native acquisition/resource lifetimes remain outside this model.",
  "state": "ScopeViewState",
  "event": "ScopeViewEvent",
  "initializers": ["new_scope_view"],
  "step": "scope_view_step",
  "contracts": {
    "new_scope_view": {
      "ensures": ["result.scope.phase == 'idle' and result.scope.physical == 'none' and not result.view.visible"]
    }
  },
  "properties": [
    {
      "name": "rejected_joint_transition_changes_neither_policy",
      "variables": {"state": "ScopeViewState", "event": "ScopeViewEvent"},
      "lets": {"after": "scope_view_step(state,event)"},
      "assert": "after[1] or after[0] == state"
    },
    {
      "name": "joint_issue_installs_one_matching_scope_and_view_token",
      "variables": {"state": "ScopeViewState", "event": "ScopeViewEvent"},
      "lets": {"after": "scope_view_step(state,event)"},
      "assert": "not after[1] or event.kind != 'issue' or (scope_step(state.scope,event.scope_event)[1] and foreground_step(state.view,event.view_event)[1] and after[0].scope.display_token == event.scope_event.token and after[0].view.token == event.view_event.token and event.scope_event.token == event.view_event.token and after[0].scope.applied_token == state.scope.applied_token and after[0].view.applied_token == state.view.applied_token)"
    },
    {
      "name": "joint_apply_consumes_matching_receipts_once",
      "variables": {"state": "ScopeViewState", "event": "ScopeViewEvent"},
      "lets": {"after": "scope_view_step(state,event)"},
      "assert": "not after[1] or event.kind != 'apply' or (scope_step(state.scope,event.scope_event)[1] and foreground_step(state.view,event.view_event)[1] and after[0].scope.applied_token == event.scope_event.token and after[0].view.applied_token == event.view_event.token and event.scope_event.token == event.view_event.token)"
    },
    {
      "name": "joint_close_revokes_both_view_and_scope_authority",
      "variables": {"state": "ScopeViewState", "event": "ScopeViewEvent"},
      "lets": {"after": "scope_view_step(state,event)"},
      "assert": "not after[1] or event.kind != 'close' or (not after[0].view.visible and after[0].view.token == 0 and after[0].scope.closing and (after[0].scope.phase == 'closed' or (after[0].scope.phase == 'retiring' and after[0].scope.physical == 'retiring')))"
    },
    {
      "name": "joint_transfer_revokes_old_view_receipt",
      "variables": {"state": "ScopeViewState", "event": "ScopeViewEvent"},
      "lets": {"after": "scope_view_step(state,event)"},
      "assert": "not after[1] or event.kind != 'move' or (after[0].view.epoch > state.view.epoch and after[0].view.token == 0 and after[0].view.applied_token == 0)"
    }
  ],
  "witnesses": [
    {
      "name": "current_scope_visual_issues_and_applies_once",
      "lets": {
        "opened": "scope_view_step(new_scope_view(),ScopeViewEvent('open',ScopeEvent('open',generation=1,owner='app',view_epoch=1),ForegroundEvent('open',generation=1,owner='view-a',epoch=1)))",
        "demanded": "ScopeViewState(scope_step(opened[0].scope,ScopeEvent('demand',generation=1,owner='app',view_epoch=1,playback_epoch=0,request=1,source_revision=1,source_id='source-a'))[0],opened[0].view)",
        "begun": "ScopeViewState(scope_step(demanded.scope,ScopeEvent('begin',generation=1,owner='app',view_epoch=1,playback_epoch=0,request=1,source_revision=1,source_id='source-a',submission=1))[0],demanded.view)",
        "completed": "ScopeViewState(scope_step(begun.scope,ScopeEvent('complete',generation=1,owner='app',view_epoch=1,playback_epoch=0,request=1,source_revision=1,source_id='source-a',submission=1))[0],begun.view)",
        "issued": "scope_view_step(completed,ScopeViewEvent('issue',ScopeEvent('display_issued',generation=1,owner='app',view_epoch=1,playback_epoch=0,request=1,source_revision=1,source_id='source-a',token='visual-1'),ForegroundEvent('issue',generation=1,owner='view-a',epoch=1,token='visual-1'))) ",
        "applied": "scope_view_step(issued[0],ScopeViewEvent('apply',ScopeEvent('display_applied',generation=1,owner='app',view_epoch=1,playback_epoch=0,request=1,source_revision=1,source_id='source-a',token='visual-1'),ForegroundEvent('apply',generation=1,owner='view-a',epoch=1,token='visual-1'))) ",
        "duplicate": "scope_view_step(applied[0],ScopeViewEvent('apply',ScopeEvent('display_applied',generation=1,owner='app',view_epoch=1,playback_epoch=0,request=1,source_revision=1,source_id='source-a',token='visual-1'),ForegroundEvent('apply',generation=1,owner='view-a',epoch=1,token='visual-1')))"
      },
      "assert": "opened[1] and issued[1] and applied[1] and applied[0].scope.applied_token == 'visual-1' and applied[0].view.applied_token == 'visual-1' and not duplicate[1]"
    },
    {
      "name": "delayed_visual_after_close_is_not_adopted",
      "lets": {
        "opened": "scope_view_step(new_scope_view(),ScopeViewEvent('open',ScopeEvent('open',generation=1,owner='app',view_epoch=1),ForegroundEvent('open',generation=1,owner='view-a',epoch=1)))",
        "demanded": "ScopeViewState(scope_step(opened[0].scope,ScopeEvent('demand',generation=1,owner='app',view_epoch=1,playback_epoch=0,request=1,source_revision=1,source_id='source-a'))[0],opened[0].view)",
        "begun": "ScopeViewState(scope_step(demanded.scope,ScopeEvent('begin',generation=1,owner='app',view_epoch=1,playback_epoch=0,request=1,source_revision=1,source_id='source-a',submission=1))[0],demanded.view)",
        "completed": "ScopeViewState(scope_step(begun.scope,ScopeEvent('complete',generation=1,owner='app',view_epoch=1,playback_epoch=0,request=1,source_revision=1,source_id='source-a',submission=1))[0],begun.view)",
        "issued": "scope_view_step(completed,ScopeViewEvent('issue',ScopeEvent('display_issued',generation=1,owner='app',view_epoch=1,playback_epoch=0,request=1,source_revision=1,source_id='source-a',token='visual-1'),ForegroundEvent('issue',generation=1,owner='view-a',epoch=1,token='visual-1'))) ",
        "closed": "scope_view_step(issued[0],ScopeViewEvent('close',ScopeEvent('close',generation=1,owner='app'),ForegroundEvent('close',generation=1,owner='view-a'))) ",
        "late": "scope_view_step(closed[0],ScopeViewEvent('apply',ScopeEvent('display_applied',generation=1,owner='app',view_epoch=1,playback_epoch=0,request=1,source_revision=1,source_id='source-a',token='visual-1'),ForegroundEvent('apply',generation=1,owner='view-a',epoch=1,token='visual-1')))"
      },
      "assert": "opened[1] and issued[1] and closed[1] and not late[1] and late[0] == closed[0]"
    }
  ],
  "mutations": [
    {
      "name": "issue_commits_when_foreground_rejects",
      "function": "scope_view_issue",
      "target": "not scope_ok or not view_ok",
      "replacement": "not scope_ok",
      "detects": ["property.joint_issue_installs_one_matching_scope_and_view_token"]
    },
    {
      "name": "apply_commits_when_foreground_rejects",
      "function": "scope_view_apply",
      "target": "not scope_ok or not view_ok",
      "replacement": "not scope_ok",
      "detects": ["property.joint_apply_consumes_matching_receipts_once"]
    }
  ],
  "loops": []
}
