{
  "version": 1,
  "description": "Scalar decisions for one selected manual bake reservation. The trusted queue adapter computes occupancy and destination-order observations; collection scans, replacement, uniqueness, and capacity bookkeeping are tested in ordinary Python.",
  "state": "State",
  "event": "Event",
  "initializers": [
    "new"
  ],
  "step": "step",
  "invariants": {
    "identity": "state.generation >= 1 and state.serial >= 0",
    "entry_identity": "0 <= state.entry.request and state.entry.request <= state.serial and state.entry.target >= 0 and state.entry.destination >= 0 and 0 <= state.entry.lane <= 2",
    "empty_entry": "(state.entry.request == 0) == (state.entry.phase == 'empty') and (state.entry.target == 0) == (state.entry.request == 0) and (state.entry.destination == 0) == (state.entry.request == 0)",
    "physical_lease": "state.entry.physical == (state.entry.lane > 0) and (not state.entry.physical or state.entry.phase in ('running', 'cancelled'))"
  },
  "properties": [
    {
      "name": "admission_requires_free_target",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.serial >= 0",
        "0 <= state.entry.request and state.entry.request <= state.serial and state.entry.target >= 0 and state.entry.destination >= 0 and 0 <= state.entry.lane <= 2",
        "(state.entry.request == 0) == (state.entry.phase == 'empty') and (state.entry.target == 0) == (state.entry.request == 0) and (state.entry.destination == 0) == (state.entry.request == 0)",
        "state.entry.physical == (state.entry.lane > 0) and (not state.entry.physical or state.entry.phase in ('running', 'cancelled'))"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "after[1].action != 'freeze' or (event.kind == 'admit' and not state.closing and 0 <= event.slot < 8 and state.entry.request == 0 and not event.target_busy and event.target > 0 and event.destination > 0 and event.request > state.serial)"
    },
    {
      "name": "dispatch_requires_frozen_head_and_free_lane",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.serial >= 0",
        "0 <= state.entry.request and state.entry.request <= state.serial and state.entry.target >= 0 and state.entry.destination >= 0 and 0 <= state.entry.lane <= 2",
        "(state.entry.request == 0) == (state.entry.phase == 'empty') and (state.entry.target == 0) == (state.entry.request == 0) and (state.entry.destination == 0) == (state.entry.request == 0)",
        "state.entry.physical == (state.entry.lane > 0) and (not state.entry.physical or state.entry.phase in ('running', 'cancelled'))"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "after[1].action != 'dispatch' or (event.kind == 'start' and event.validated and state.entry.phase == 'queued' and event.lane in (1,2) and not event.lane_busy and not event.destination_waits and not state.closing)"
    },
    {
      "name": "publication_requires_destination_turn",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.serial >= 0",
        "0 <= state.entry.request and state.entry.request <= state.serial and state.entry.target >= 0 and state.entry.destination >= 0 and 0 <= state.entry.lane <= 2",
        "(state.entry.request == 0) == (state.entry.phase == 'empty') and (state.entry.target == 0) == (state.entry.request == 0) and (state.entry.destination == 0) == (state.entry.request == 0)",
        "state.entry.physical == (state.entry.lane > 0) and (not state.entry.physical or state.entry.phase in ('running', 'cancelled'))"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "after[1].action != 'publish' or (event.kind == 'publish' and event.validated and state.entry.phase == 'ready' and not event.destination_waits)"
    },
    {
      "name": "physical_release_needs_validated_retirement",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.serial >= 0",
        "0 <= state.entry.request and state.entry.request <= state.serial and state.entry.target >= 0 and state.entry.destination >= 0 and 0 <= state.entry.lane <= 2",
        "(state.entry.request == 0) == (state.entry.phase == 'empty') and (state.entry.target == 0) == (state.entry.request == 0) and (state.entry.destination == 0) == (state.entry.request == 0)",
        "state.entry.physical == (state.entry.lane > 0) and (not state.entry.physical or state.entry.phase in ('running', 'cancelled'))"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "not state.entry.physical or after[0].entry.physical or (event.kind in ('retired','complete') and event.validated and event.generation == state.generation and event.request == state.entry.request and event.target == state.entry.target and event.destination == state.entry.destination)"
    },
    {
      "name": "reservation_release_needs_terminal_receipt",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.serial >= 0",
        "0 <= state.entry.request and state.entry.request <= state.serial and state.entry.target >= 0 and state.entry.destination >= 0 and 0 <= state.entry.lane <= 2",
        "(state.entry.request == 0) == (state.entry.phase == 'empty') and (state.entry.target == 0) == (state.entry.request == 0) and (state.entry.destination == 0) == (state.entry.request == 0)",
        "state.entry.physical == (state.entry.lane > 0) and (not state.entry.physical or state.entry.phase in ('running', 'cancelled'))"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "after[1].action != 'release' or (event.kind == 'finish' and event.validated and state.entry.phase in ('publishing','cancelled') and not state.entry.physical)"
    },
    {
      "name": "cancel_preserves_physical_lease",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.serial >= 0",
        "0 <= state.entry.request and state.entry.request <= state.serial and state.entry.target >= 0 and state.entry.destination >= 0 and 0 <= state.entry.lane <= 2",
        "(state.entry.request == 0) == (state.entry.phase == 'empty') and (state.entry.target == 0) == (state.entry.request == 0) and (state.entry.destination == 0) == (state.entry.request == 0)",
        "state.entry.physical == (state.entry.lane > 0) and (not state.entry.physical or state.entry.phase in ('running', 'cancelled'))"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "event.kind not in ('cancel','close') or (after[0].entry.physical == state.entry.physical and after[0].entry.lane == state.entry.lane)"
    },
    {
      "name": "foreign_generation_has_no_effect",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.serial >= 0",
        "0 <= state.entry.request and state.entry.request <= state.serial and state.entry.target >= 0 and state.entry.destination >= 0 and 0 <= state.entry.lane <= 2",
        "(state.entry.request == 0) == (state.entry.phase == 'empty') and (state.entry.target == 0) == (state.entry.request == 0) and (state.entry.destination == 0) == (state.entry.request == 0)",
        "state.entry.physical == (state.entry.lane > 0) and (not state.entry.physical or state.entry.phase in ('running', 'cancelled'))"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "event.generation == state.generation or after == (state, Effects())"
    },
    {
      "name": "closing_cannot_admit_dispatch_or_publish",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.serial >= 0",
        "0 <= state.entry.request and state.entry.request <= state.serial and state.entry.target >= 0 and state.entry.destination >= 0 and 0 <= state.entry.lane <= 2",
        "(state.entry.request == 0) == (state.entry.phase == 'empty') and (state.entry.target == 0) == (state.entry.request == 0) and (state.entry.destination == 0) == (state.entry.request == 0)",
        "state.entry.physical == (state.entry.lane > 0) and (not state.entry.physical or state.entry.phase in ('running', 'cancelled'))"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "not state.closing or after[1].action not in ('freeze','queue','dispatch','publish')"
    },
    {
      "name": "frozen_request_identity_survives_queueing",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.serial >= 0",
        "0 <= state.entry.request and state.entry.request <= state.serial and state.entry.target >= 0 and state.entry.destination >= 0 and 0 <= state.entry.lane <= 2",
        "(state.entry.request == 0) == (state.entry.phase == 'empty') and (state.entry.target == 0) == (state.entry.request == 0) and (state.entry.destination == 0) == (state.entry.request == 0)",
        "state.entry.physical == (state.entry.lane > 0) and (not state.entry.physical or state.entry.phase in ('running', 'cancelled'))"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "state.entry.request == 0 or after[0].entry.request == 0 or (after[0].entry.request == state.entry.request and after[0].entry.target == state.entry.target and after[0].entry.destination == state.entry.destination)"
    }
  ],
  "witnesses": [
    {
      "name": "available_lane_can_dispatch",
      "lets": {
        "after": "step(State(serial=1, entry=Entry(1,2,3,'queued')), Event('start', request=1, target=2, destination=3, lane=1, validated=True))"
      },
      "assert": "after[1].action == 'dispatch' and after[0].entry.physical and after[0].entry.lane == 1"
    },
    {
      "name": "observed_predecessor_blocks_dispatch",
      "lets": {
        "before": "State(serial=1, entry=Entry(1,2,3,'queued'))",
        "after": "step(before, Event('start', request=1, target=2, destination=3, lane=1, validated=True, destination_waits=True))"
      },
      "assert": "after == (before, Effects())"
    },
    {
      "name": "selected_worker_retires_before_publication",
      "lets": {
        "after": "step(State(serial=1, entry=Entry(1,2,3,'running',1,True)), Event('complete', request=1, target=2, destination=3, validated=True))"
      },
      "assert": "after[1].action == 'stage' and after[0].entry.phase == 'ready' and not after[0].entry.physical and after[0].entry.request == 1"
    }
  ],
  "mutations": [
    {
      "name": "duplicate_target_admitted",
      "function": "step",
      "target": "not event.target_busy",
      "replacement": "True",
      "detects": [
        "property.admission_requires_free_target"
      ]
    },
    {
      "name": "busy_worker_reused",
      "function": "step",
      "target": "not event.lane_busy",
      "replacement": "True",
      "detects": [
        "property.dispatch_requires_frozen_head_and_free_lane"
      ]
    },
    {
      "name": "retirement_ignores_validation",
      "function": "step",
      "target": "event.kind == 'retired' and entry.physical and event.validated",
      "replacement": "event.kind == 'retired' and entry.physical",
      "detects": [
        "property.physical_release_needs_validated_retirement"
      ]
    },
    {
      "name": "finish_ignores_physical_lease",
      "function": "step",
      "target": "event.kind == 'finish' and entry.phase in ('publishing', 'cancelled') and not entry.physical and event.validated",
      "replacement": "event.kind == 'finish' and entry.phase in ('publishing', 'cancelled') and event.validated",
      "detects": [
        "property.reservation_release_needs_terminal_receipt"
      ]
    },
    {
      "name": "cancel_drops_worker_lease",
      "function": "cancel_entry",
      "target": "replace(entry, phase='cancelled')",
      "replacement": "replace(entry, phase='cancelled', physical=False, lane=0)",
      "detects": [
        "property.cancel_preserves_physical_lease"
      ]
    },
    {
      "name": "shared_destination_starts_out_of_order",
      "function": "step",
      "target": "event.kind == 'start' and entry.phase == 'queued' and event.validated and event.lane in (1, 2) and not event.lane_busy and not event.destination_waits",
      "replacement": "event.kind == 'start' and entry.phase == 'queued' and event.validated and event.lane in (1, 2) and not event.lane_busy",
      "detects": [
        "property.dispatch_requires_frozen_head_and_free_lane"
      ]
    }
  ]
}
