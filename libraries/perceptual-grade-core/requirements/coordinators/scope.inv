{
  "version": 1,
  "description": "scope workflow authority for the current Blender product. Scalar identities name separately owned payloads. Physical retirement, native replacement, verified readback and restoration are explicit adapter receipts; logical actions do not establish their truth.",
  "state": "State",
  "event": "Event",
  "initializers": [
    "new"
  ],
  "step": "step",
  "invariants": {
    "identity": "state.generation >= 1 and state.request >= 0 and state.source >= 0 and state.visual >= 0 and state.statistics >= 0",
    "seed_identity": "state.seed >= 0"
  },
  "properties": [
    {
      "name": "publication_requires_current_valid_payload",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.request >= 0 and state.source >= 0 and state.visual >= 0 and state.statistics >= 0",
        "state.seed >= 0"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "(after[1].action != 'publish_visual' and after[1].action != 'publish_statistics') or (event.validated and event.request == state.request and event.source == state.source and event.generation == state.generation and state.phase == 'running' and not state.closing)"
    },
    {
      "name": "late_receipt_after_cancel_ignored",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.request >= 0 and state.source >= 0 and state.visual >= 0 and state.statistics >= 0",
        "state.seed >= 0",
        "state.phase == 'retiring'"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "after[1].action != 'publish_visual' and after[1].action != 'publish_statistics'"
    },
    {
      "name": "registration_ack_must_match_current_capture",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.request >= 0 and state.source >= 0 and state.visual >= 0 and state.statistics >= 0",
        "state.seed >= 0",
        "event.kind == 'ready'"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "assert": "after[1].action != 'compute' or (event.validated and state.seed > 0 and event.request == state.request and event.source == state.source and event.generation == state.generation)"
    },
    {
      "name": "capture_cancellation_waits_for_retirement",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.request >= 0 and state.source >= 0 and state.visual >= 0 and state.statistics >= 0",
        "state.seed >= 0",
        "state.phase == 'capturing' and event.kind in ('cancel','failed') and event.request == state.request and event.source == state.source and event.generation == state.generation and not state.closing"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "assert": "after[0].phase == 'retiring' and after[1].action == 'cancel'"
    },
    {
      "name": "close_waits_for_capture_retirement",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.request >= 0 and state.source >= 0 and state.visual >= 0 and state.statistics >= 0",
        "state.seed >= 0",
        "state.phase == 'capturing' and event.kind == 'close' and event.generation == state.generation"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "assert": "after[0].phase == 'retiring' and after[1].action == 'cancel'"
    },
    {
      "name": "seed_receipt_binds_native_source",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.request >= 0 and state.source >= 0 and state.visual >= 0 and state.statistics >= 0",
        "state.seed >= 0",
        "event.kind in ('captured','ready','needs_seed')"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "assert": "after[1].action not in ('compute','register') or (event.source == state.source and event.request == state.request and event.generation == state.generation and event.validated)"
    }
  ],
  "witnesses": [
    {
      "name": "capturing_cancel_is_possible",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.request >= 0 and state.source >= 0 and state.visual >= 0 and state.statistics >= 0",
        "state.seed >= 0"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "assert": "event.kind == 'cancel' and state.phase == 'capturing' and after[1].action == 'cancel'"
    },
    {
      "name": "registered_seed_compute_is_possible",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.request >= 0 and state.source >= 0 and state.visual >= 0 and state.statistics >= 0",
        "state.seed >= 0"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "assert": "event.kind == 'ready' and after[1].action == 'compute'"
    }
  ],
  "mutations": [
    {
      "name": "capture_cancel_drops_retirement",
      "function": "step",
      "target": "(event.kind == 'failed' or event.kind == 'cancel') and state.phase in ('capturing', 'running', 'registering')",
      "replacement": "(event.kind == 'failed' or event.kind == 'cancel') and state.phase in ('running', 'registering')",
      "detects": [
        "property.capture_cancellation_waits_for_retirement"
      ]
    }
  ]
}
