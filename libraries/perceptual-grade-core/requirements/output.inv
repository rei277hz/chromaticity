{
  "version": 1,
  "description": "Current production output policy, with typed event admission and inductive state invariants. Native receipt truth is an adapter obligation.",
  "state": "State",
  "event": "OutputEvent",
  "initializers": [
    "establish"
  ],
  "step": "step",
  "invariants": {
    "state_domain": "valid(state)"
  },
  "contracts": {
    "establish": {
      "requires": [
        "incarnation > 0"
      ]
    },
    "step": {
      "requires": [
        "event_valid(state,event)"
      ]
    },
    "_at": {
      "requires": [
        "0 <= index < len(values)"
      ],
      "ensures": [
        "result == values[index]"
      ]
    },
    "slot_for": {
      "requires": [
        "0 <= index < 4"
      ]
    },
    "slot_consistent": {
      "requires": [
        "0 <= index < 4"
      ]
    }
  },
  "properties": [
    {
      "name": "failure_keeps_repair_debt",
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state,event)",
        "event.kind == 'graph_fail'",
        "not (event.validated and event.reader_excluded)"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "not after[1].accepted or (after[0].graph_phase == 4 and after[0].graph_debt and not after[0].graph_valid)"
    },
    {
      "name": "selection_requires_verified_target",
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state,event)",
        "event.kind == 'select'"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "not after[1].accepted or (event.validated and event.reader_excluded and complete(state,event.slot,event.source) and packing_clean(state,event.slot))"
    },
    {
      "name": "native_graph_effect_invalidates_authority_first",
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state,event)",
        "event.kind == 'fallback'"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "assert": "not after[1].accepted or (not after[0].graph_valid and after[0].graph_debt)"
    },
    {
      "name": "verified_repair_preserves_previous_graph_binding",
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state, event)"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "not ((event.kind == 'graph_repair' and after[1].accepted)) or (after[0].selected == state.selected and after[0].output_key == state.output_key and after[0].output_source == state.output_source and after[0].graph_valid == state.graph_previous_valid and not after[0].graph_debt)"
    },
    {
      "name": "reserve_never_overwrites_selected_slot",
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state, event)"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "not ((event.kind == 'reserve' and after[1].accepted)) or (event.slot != state.selected and event.reader_excluded and state.pending == -1)"
    },
    {
      "name": "write_requires_exact_reserved_operation",
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state, event)"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "not ((event.kind == 'armed' and after[1].accepted)) or (event.operation == state.operation and event.source == state.pending_source and event.slot == state.pending and event.validated and event.reader_excluded)"
    },
    {
      "name": "stale_output_session_is_rejected",
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state, event)",
        "not same_session(state,event) or not same_incarnation(state,event)",
        "event.kind != 'invalidate'"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "after[0] == state and not after[1].accepted"
    },
    {
      "name": "rejected_output_receipt_preserves_state",
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state, event)"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "not ((not after[1].accepted)) or (after[0] == state)"
    },
    {
      "name": "selected_output_certification_is_complete",
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state, event)",
        "output_complete(state,state.output_key)"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "complete(state,state.selected,state.output_source) and state.graph_valid"
    },
    {
      "name": "graph_begin_records_debt_before_mutation",
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state,event)",
        "event.kind == 'graph_begin'"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "assert": "not after[1].accepted or (after[0].graph_debt and after[0].graph_phase == 1 and after[0].graph_operation == state.graph_operation + 1 and after[0].graph_previous_valid == state.graph_valid and after[0].graph_valid == state.graph_valid and after[0].selected == state.selected and after[0].output_key == state.output_key and after[0].output_source == state.output_source)"
    },
    {
      "name": "verified_graph_failure_restores_previous_binding",
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state,event)",
        "event.kind == 'graph_fail'",
        "event.validated and event.reader_excluded"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "assert": "not after[1].accepted or (not after[0].graph_debt and after[0].graph_phase == 0 and after[0].graph_valid == state.graph_previous_valid and after[0].selected == state.selected and after[0].output_key == state.output_key and after[0].output_source == state.output_source)"
    },
    {
      "name": "local_invalidation_revokes_output_authority",
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state,event)",
        "event.kind == 'invalidate'"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "assert": "after[1].accepted and after[0].incarnation == state.incarnation + 1 and not after[0].graph_valid and after[0].selected == -1 and after[0].pending == -1"
    },
    {
      "name": "selected_publication_requires_clean_packing",
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state,event)",
        "event.kind == 'select' or event.kind == 'adopt'"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "assert": "not after[1].accepted or packing_clean(state,event.slot)"
    },
    {
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state,event)",
        "event.kind == 'adopt_native'"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "name": "native_adoption_has_no_numerical_provenance",
      "assert": "not after[1].accepted or (after[0].adopted and not after[0].graph_valid and after[0].selected == -1 and not after[0].slots[0].valid and not after[0].slots[1].valid and not after[0].slots[2].valid and not after[0].slots[3].valid)"
    },
    {
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state,event)",
        "state.adopted and event.kind == 'intent' and event.intent == state.intent and not event.explicit"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "name": "adopted_unchanged_intent_cannot_authorize_production",
      "assert": "after[0] == state and not after[1].accepted"
    },
    {
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state,event)",
        "state.adopted and event.kind != 'intent' and event.kind != 'adopt_native' and event.kind != 'invalidate'"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "name": "adopted_state_rejects_producer_effects",
      "assert": "after[0] == state and not after[1].accepted"
    },
    {
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state,event)",
        "event.kind == 'reserve'"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "name": "reserve_protects_native_selection_without_certifying_it",
      "assert": "not after[1].accepted or event.slot != state.protected"
    },
    {
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state,event)",
        "event.kind == 'transferred'"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "name": "producer_completion_requires_packing",
      "assert": "not after[1].accepted or (state.write_phase == 2 and packing_clean(state,event.slot) and event.validated and event.reader_excluded and event.operation == state.operation)"
    }
  ],
  "witnesses": [
    {
      "name": "reserve_admitted",
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state,event)"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "event.kind == 'reserve' and after[1].accepted"
    },
    {
      "name": "selection_admitted",
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state,event)"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "event.kind == 'select' and after[1].accepted"
    },
    {
      "name": "graph_repair_admitted",
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state,event)"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "event.kind == 'graph_repair' and after[1].accepted"
    },
    {
      "name": "verified_graph_failure_is_possible",
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state,event)",
        "event.kind == 'graph_fail'",
        "event.validated and event.reader_excluded"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "assert": "after[1].accepted and not after[0].graph_debt"
    },
    {
      "name": "local_invalidation_ignores_old_receipt_identity",
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state,event)",
        "event.kind == 'invalidate'",
        "not same_session(state,event)"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "assert": "after[1].accepted and after[0].incarnation == state.incarnation + 1"
    },
    {
      "name": "readable_output_can_need_repacking",
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state,event)",
        "output_complete(state,state.output_key)"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "assert": "not packing_clean(state,state.selected)"
    },
    {
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state,event)"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "name": "native_state_can_be_adopted",
      "assert": "event.kind == 'adopt_native' and after[1].accepted and after[0].adopted"
    },
    {
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state,event)"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "name": "changed_adopted_intent_resumes_production",
      "assert": "state.adopted and event.kind == 'intent' and event.intent != state.intent and after[1].accepted and not after[0].adopted"
    },
    {
      "variables": {
        "state": "State",
        "event": "OutputEvent"
      },
      "assume": [
        "valid(state)",
        "event_valid(state,event)"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "name": "explicit_same_intent_resumes_production",
      "assert": "state.adopted and event.kind == 'intent' and event.intent == state.intent and event.explicit and after[1].accepted and not after[0].adopted"
    }
  ],
  "mutations": [
    {
      "name": "reserve_overwrites_selected_slot",
      "function": "apply_reserve",
      "target": "event.slot != state.selected",
      "replacement": "True",
      "detects": [
        "property.reserve_never_overwrites_selected_slot"
      ]
    },
    {
      "name": "selection_skips_readback_validation",
      "function": "apply_select",
      "target": "event.validated",
      "replacement": "True",
      "detects": [
        "property.selection_requires_verified_target"
      ]
    },
    {
      "name": "unchanged_intent_restarts_adopted_output",
      "function": "apply_intent",
      "target": "event.intent != state.intent",
      "replacement": "True",
      "detects": [
        "property.adopted_unchanged_intent_cannot_authorize_production"
      ]
    },
    {
      "name": "reserve_overwrites_external_selection",
      "function": "apply_reserve",
      "target": "event.slot != state.protected",
      "replacement": "True",
      "detects": [
        "property.reserve_protects_native_selection_without_certifying_it"
      ]
    },
    {
      "name": "producer_completion_skips_packing",
      "function": "apply_transferred",
      "target": "packing_clean(state, event.slot)",
      "replacement": "True",
      "detects": [
        "property.producer_completion_requires_packing"
      ]
    }
  ]
}
