{
  "version": 1,
  "description": "Current production exact policy, with typed event admission and inductive state invariants. Native receipt truth is an adapter obligation.",
  "state": "ExactOperationState",
  "event": "ExactEvent",
  "initializers": [
    "new"
  ],
  "step": "step",
  "invariants": {
    "state_domain": "exact_invariant(state)"
  },
  "contracts": {
    "new": {
      "requires": []
    },
    "step": {
      "requires": [
        "event_valid(state,event)"
      ]
    }
  },
  "properties": [
    {
      "name": "invoke_requires_current_certificate",
      "variables": {
        "state": "ExactOperationState",
        "event": "ExactEvent"
      },
      "assume": [
        "exact_invariant(state)",
        "event_valid(state,event)"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "not after[1].invoke or (state.phase == 2 and state.receipt == state.required and state.receipt > 0 and not state.cancelled)"
    },
    {
      "name": "settlement_requires_physical_stop",
      "variables": {
        "state": "ExactOperationState",
        "event": "ExactEvent"
      },
      "assume": [
        "exact_invariant(state)",
        "event_valid(state,event)",
        "event.kind == 'settled' and not state.stopped"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "not after[1].accept"
    },
    {
      "name": "native_completion_retains_lease",
      "variables": {
        "state": "ExactOperationState",
        "event": "ExactEvent"
      },
      "assume": [
        "exact_invariant(state)",
        "event_valid(state, event)"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "not ((event.kind == 'native_result' and after[1].accept)) or (after[0].lease == state.lease and after[0].phase == 4 and not after[0].stopped)"
    },
    {
      "name": "native_receipts_bind_operation_and_lease",
      "variables": {
        "state": "ExactOperationState",
        "event": "ExactEvent"
      },
      "assume": [
        "exact_invariant(state)",
        "event_valid(state, event)",
        "event.kind in ('native_result','native_stopped','settled','cleanup_failed') and (event.operation != state.operation or event.session != state.session or event.revision != state.revision or event.frame != state.frame or event.token != state.lease)"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "not after[1].accept"
    },
    {
      "name": "native_lease_cannot_disappear_before_stop",
      "variables": {
        "state": "ExactOperationState",
        "event": "ExactEvent"
      },
      "assume": [
        "exact_invariant(state)",
        "event_valid(state, event)"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "not ((state.lease > 0 and after[0].lease == 0)) or (event.kind == 'settled' and state.stopped and after[1].accept)"
    },
    {
      "name": "frame_advance_requires_completed_uncancelled_output",
      "variables": {
        "state": "ExactOperationState",
        "event": "ExactEvent"
      },
      "assume": [
        "exact_invariant(state)",
        "event_valid(state, event)"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "not ((after[1].advance)) or (state.phase == 5 and not state.cancelled and state.stopped and state.outcome == 1)"
    },
    {
      "name": "validated_output_requires_final_resolution",
      "variables": {
        "state": "ExactOperationState",
        "event": "ExactEvent"
      },
      "assume": [
        "exact_invariant(state)",
        "event_valid(state, event)"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "not ((event.kind == 'validated' and after[1].accept)) or (event.resolution == 65 and event.key == state.required)"
    },
    {
      "name": "rejected_exact_receipt_preserves_state",
      "variables": {
        "state": "ExactOperationState",
        "event": "ExactEvent"
      },
      "assume": [
        "exact_invariant(state)",
        "event_valid(state, event)"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "not ((not after[1].accept)) or (after[0] == state)"
    }
  ],
  "witnesses": [
    {
      "name": "native_invoke_admitted",
      "variables": {
        "state": "ExactOperationState",
        "event": "ExactEvent"
      },
      "assume": [
        "exact_invariant(state)",
        "event_valid(state,event)"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "after[1].invoke"
    },
    {
      "name": "settlement_admitted",
      "variables": {
        "state": "ExactOperationState",
        "event": "ExactEvent"
      },
      "assume": [
        "exact_invariant(state)",
        "event_valid(state,event)"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "event.kind == 'settled' and after[1].accept"
    }
  ],
  "mutations": [
    {
      "name": "settlement_skips_native_stop",
      "function": "apply_settled",
      "target": "state.stopped",
      "replacement": "True",
      "detects": [
        "property.settlement_requires_physical_stop"
      ]
    },
    {
      "name": "validation_accepts_preview_resolution",
      "function": "apply_validated",
      "target": "event.resolution == 65",
      "replacement": "True",
      "detects": [
        "property.validated_output_requires_final_resolution"
      ]
    }
  ]
}
