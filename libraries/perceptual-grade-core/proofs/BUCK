load("//build_defs:artifacts.bzl", "verification_group")
load("//build_defs:invariant.bzl", "invariant_proof")
load("//libraries/perceptual-grade-core/requirements:inventory.bzl", "LEAF_REQUIREMENTS")
load("//libraries/perceptual-grade-core/requirements/coordinators:inventory.bzl", "COORDINATOR_REQUIREMENTS")

[invariant_proof(
    name = "proof_" + machine,
    required_mutations = inventory["mutations"],
    required_properties = inventory["properties"],
    required_witnesses = inventory["witnesses"],
    requirements = "//libraries/perceptual-grade-core:" + machine + "_requirements",
    runtime_source = "perceptual_grade_core/graph/policies/" + machine + ".py",
    source = "//libraries/perceptual-grade-core:" + machine + "_source",
    visibility = ["PUBLIC"],
) for machine, inventory in LEAF_REQUIREMENTS.items()]

[invariant_proof(
    name = "proof_" + machine + "_coordinator",
    required_mutations = inventory["mutations"],
    required_properties = inventory["properties"],
    required_witnesses = inventory["witnesses"],
    requirements = "//libraries/perceptual-grade-core:" + machine + "_coordinator_requirements",
    runtime_source = "perceptual_grade_core/graph/coordinators/" + machine + ("_policy.py" if machine == "bake_queue" else ".py"),
    source = "//libraries/perceptual-grade-core:" + ("bake_queue_policy_source" if machine == "bake_queue" else machine + "_coordinator_source"),
    timeout_ms = 5000 if machine == "bake_queue" else 10000,
    visibility = ["PUBLIC"],
) for machine, inventory in COORDINATOR_REQUIREMENTS.items()]

verification_group(
    name = "verify",
    visibility = ["PUBLIC"],
    deps = [":proof_" + machine for machine in LEAF_REQUIREMENTS] +
           [":proof_" + machine + "_coordinator" for machine in COORDINATOR_REQUIREMENTS],
)

alias(
    name = "bake_image",
    actual = ":proof_bake_image",
    visibility = ["PUBLIC"],
)
