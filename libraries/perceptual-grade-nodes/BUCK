load("//build_defs:artifacts.bzl", "generate", "source_tree")
load("//build_defs:python_packages.bzl", "component_library")

PREFIX = "src/"

SOURCES = {path[len(PREFIX):]: path for path in glob([PREFIX + "**/*.py"])}

# The native host supplies bpy. Preparation can be imported without Blender.
component_library(
    name = "code",
    srcs = SOURCES,
    external_deps = ["//third_party:numpy"],
    package = "perceptual_grade_nodes",
    visibility = ["PUBLIC"],
    deps = ["//libraries/color-core:runtime"],
)

python_library(
    name = "boundary_generator_sources",
    srcs = {"boundary.py": "tools/build_boundary.py"},
    base_module = "pg_nodes_build",
    visibility = ["PUBLIC"],
    deps = [":code"],
)

python_binary(
    name = "boundary_generator",
    main_module = "pg_nodes_build.boundary",
    deps = [":boundary_generator_sources"],
)

generate(
    name = "boundary_resource",
    outputs = {
        "npz": "output_boundary.npz",
        "report": "report.json",
    },
    tool = ":boundary_generator",
    visibility = ["PUBLIC"],
)

component_library(
    name = "runtime",
    srcs = {},
    package = "perceptual_grade_nodes",
    resources = {"output_boundary.npz": ":boundary_resource[npz]"},
    visibility = ["PUBLIC"],
    deps = [":code"],
)

source_tree(
    name = "sources",
    srcs = SOURCES,
    visibility = ["PUBLIC"],
)

export_file(
    name = "documentation",
    src = "README.md",
    visibility = ["PUBLIC"],
)

export_file(
    name = "boundary_documentation",
    src = "BOUNDARY.md",
    visibility = ["PUBLIC"],
)

export_file(
    name = "evidence",
    src = "EVIDENCE.md",
    visibility = ["PUBLIC"],
)

export_file(
    name = "example",
    src = "examples/linear_tone.py",
    visibility = ["PUBLIC"],
)

export_file(
    name = "full_example",
    src = "examples/full_grade.py",
    visibility = ["PUBLIC"],
)

export_file(
    name = "color_tables_documentation",
    src = "COLOR_TABLES.md",
    visibility = ["PUBLIC"],
)

# Oracle/native comparisons belong to development tooling, not runtime bundles.
TOOL_PREFIX = "tools/"

EVALUATION_SOURCES = {
    path[len(TOOL_PREFIX):]: path
    for path in glob([TOOL_PREFIX + "**/*.py"])
    if path != TOOL_PREFIX + "gate_policy.py"
}

python_library(
    name = "gate_policy_sources",
    srcs = {"gate_policy.py": "tools/gate_policy.py"},
    base_module = "tools.perceptual_grade_nodes",
    visibility = ["PUBLIC"],
    deps = [
        ":runtime",
        "//third_party:numpy",
    ],
)

python_library(
    name = "evaluation_sources",
    srcs = EVALUATION_SOURCES,
    base_module = "tools.perceptual_grade_nodes",
    visibility = ["PUBLIC"],
    deps = [
        ":gate_policy_sources",
        ":runtime",
        "//libraries/perceptual-grade-reference:model_code",
        "//third_party:bpy",
        "//third_party:numpy",
    ],
)

python_binary(
    name = "evaluate",
    main_module = "tools.perceptual_grade_nodes.evaluate",
    visibility = ["PUBLIC"],
    deps = [":evaluation_sources"],
)

