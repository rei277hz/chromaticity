{
  "version": 1,
  "state": "State",
  "event": "Event",
  "initializers": ["new"],
  "step": "step",
  "invariants": {
    "positive_generation": "state.generation >= 1",
    "execution_lease": "state.leases == (1 if state.busy else 0)",
    "idle_has_no_descendants": "state.busy or (not state.terminal and not state.cancelling)",
    "closed_is_retired": "not state.closed or (state.stopping and not state.busy)"
  },
  "contracts": {
    "new": {
      "ensures": ["result.generation == 1 and not result.busy and result.leases == 0 and not result.closed"]
    },
    "step": {
      "ensures": [
        "not result[1].reclaim or (result[0].leases == 0 and not result[0].busy)",
        "not result[1].start or (result[0].busy and result[0].leases == 1)"
      ]
    }
  },
  "properties": [
    {
      "name": "cancellation_retains_occupancy",
      "variables": {"state": "State", "event": "Event"},
      "assume": ["event.kind == 'cancel'"],
      "lets": {"result": "step(state, event)"},
      "assert": "result[0].leases == state.leases and result[0].busy == state.busy and not result[1].reclaim"
    },
    {
      "name": "terminal_is_not_quiescence",
      "variables": {"state": "State", "event": "Event"},
      "assume": ["event.kind == 'terminal'"],
      "lets": {"result": "step(state, event)"},
      "assert": "result[0].leases == state.leases and not result[1].reclaim"
    },
    {
      "name": "reclaim_waits_for_terminal",
      "variables": {"state": "State", "event": "Event"},
      "assume": ["event.kind == 'quiescent'", "not state.terminal"],
      "assert": "not step(state, event)[1].reclaim"
    },
    {
      "name": "no_double_start",
      "variables": {"state": "State", "event": "Event"},
      "assume": ["state.busy", "event.kind == 'start'"],
      "assert": "not step(state, event)[1].start"
    },
    {
      "name": "stale_event_ignored",
      "variables": {"state": "State", "event": "Event"},
      "assume": ["event.generation != state.generation"],
      "lets": {"result": "step(state, event)"},
      "assert": "result[0] == state and not result[1].accepted and not result[1].reclaim"
    },
    {
      "name": "closed_is_absorbing",
      "variables": {"state": "State", "event": "Event"},
      "assume": ["state.closed"],
      "assert": "step(state, event)[0] == state and not step(state, event)[1].start"
    }
  ],
  "witnesses": [
    {"name": "admit_initial_worker", "variables": {}, "assert": "step(new(), Event('start', 1))[1].start"}
  ],
  "mutations": [
    {"name": "early_reclaim", "function": "step", "target": "state.busy and state.terminal", "replacement": "state.busy", "detects": ["property.reclaim_waits_for_terminal"]},
    {"name": "admit_busy_worker", "function": "step", "target": "not state.busy and not state.stopping", "replacement": "not state.stopping", "detects": ["property.no_double_start"]},
    {"name": "drop_generation_fence", "function": "step", "target": "event.generation != state.generation or state.closed", "replacement": "state.closed", "detects": ["property.stale_event_ignored"]}
  ]
}
