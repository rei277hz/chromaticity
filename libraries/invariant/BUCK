load("//build_defs:artifacts.bzl", "source_tree", "verification_group")
load("//build_defs:invariant.bzl", "invariant_proof")

PREFIX = "src/"

VERIFIER_PREFIX = "verification/"

VERIFIER = {
    path[len(VERIFIER_PREFIX):]: path
    for path in glob([VERIFIER_PREFIX + "*.py"])
    if path != VERIFIER_PREFIX + "__init__.py"
}

python_library(
    name = "verification",
    srcs = VERIFIER,
    base_module = "color_tools.invariant.verification",
    visibility = ["PUBLIC"],
    deps = ["//third_party:z3-solver"],
)

python_binary(
    name = "verifier",
    main_module = "color_tools.invariant.verification.cli",
    visibility = ["PUBLIC"],
    deps = [":verification"],
)

source_tree(
    name = "verifier_sources",
    srcs = VERIFIER,
    visibility = ["PUBLIC"],
)

source_tree(
    name = "sources",
    srcs = {"lifecycle.py": PREFIX + "lifecycle.py"},
    visibility = ["PUBLIC"],
)

invariant_proof(
    name = "lifecycle_proof",
    required_mutations = [
        "early_reclaim",
        "admit_busy_worker",
        "drop_generation_fence",
    ],
    required_properties = [
        "cancellation_retains_occupancy",
        "terminal_is_not_quiescence",
        "reclaim_waits_for_terminal",
        "no_double_start",
        "stale_event_ignored",
        "closed_is_absorbing",
    ],
    required_witnesses = ["admit_initial_worker"],
    requirements = "requirements/lifecycle.inv",
    runtime_source = "invariant/lifecycle.py",
    source = PREFIX + "lifecycle.py",
    visibility = ["PUBLIC"],
)

verification_group(
    name = "verify",
    visibility = ["PUBLIC"],
    deps = [":lifecycle_proof"],
)

python_library(
    name = "test_verification",
    srcs = VERIFIER,
    base_module = "invariant.verification",
    deps = ["//third_party:z3-solver"],
)

python_test(
    name = "tests",
    srcs = ["tests/test_verification.py"],
    base_module = "invariant_tests",
    resources = {
        "lifecycle.py": PREFIX + "lifecycle.py",
        "lifecycle.inv": "requirements/lifecycle.inv",
    },
    deps = [":test_verification"],
)
