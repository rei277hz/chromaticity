{
  "version": 1,
  "description": "Scalar authority for native leases: generation and ingress ordering, admission, validated retirement and recovery. Exact token membership and proposed ledger edits are trusted adapter observations covered by ordinary runtime tests.",
  "state": "State",
  "event": "Event",
  "initializers": [
    "new"
  ],
  "step": "step",
  "invariants": {
    "state_domain": "state.generation >= 1 and state.revision >= 0 and state.serial >= 0"
  },
  "contracts": {
    "available": {
      "ensures": [
        "result == (generation == state.generation and revision == state.revision and not readers and not state.failed and not state.closed and not native_busy)"
      ]
    }
  },
  "properties": [
    {
      "name": "out_of_order_observation_preserves_state",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.revision >= 0 and state.serial >= 0",
        "not (event.revision == state.revision + 1)"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "after[0] == state and not after[1].consumed"
    },
    {
      "name": "foreign_generation_preserves_authority",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.revision >= 0 and state.serial >= 0",
        "event.generation != state.generation"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "after[0].generation == state.generation and after[0].serial == state.serial and after[0].failed == state.failed and after[0].closed == state.closed and not after[1].accepted"
    },
    {
      "name": "ordered_foreign_observation_is_consumed",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.revision >= 0 and state.serial >= 0",
        "event.revision == state.revision + 1",
        "event.generation != state.generation"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "after[0].revision == event.revision and after[1].consumed and not after[1].accepted"
    },
    {
      "name": "begin_requires_fresh_validated_ledger",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.revision >= 0 and state.serial >= 0",
        "event.kind == 'begin'"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "not after[1].accepted or (event.lease is not None and event.lease > state.serial and event.ledger_valid and after[0].serial == event.lease)"
    },
    {
      "name": "finish_requires_validated_known_lease",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.revision >= 0 and state.serial >= 0",
        "event.kind == 'finish'"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "not after[1].accepted or (event.known and event.ledger_valid and event.validated and after[0].serial == state.serial)"
    },
    {
      "name": "unmatched_finish_cannot_release",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.revision >= 0 and state.serial >= 0",
        "event.kind == 'finish' and not event.known"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "after[0].serial == state.serial and not after[1].accepted"
    },
    {
      "name": "pending_ingress_blocks_readiness",
      "variables": {
        "state": "State",
        "generation": "int",
        "revision": "int",
        "native_busy": "bool",
        "readers": "bool"
      },
      "assume": [
        "state.generation >= 1 and state.revision >= 0 and state.serial >= 0",
        "revision != state.revision"
      ],
      "lets": {},
      "assert": "not available(state, generation, revision, readers, native_busy)"
    },
    {
      "name": "outstanding_lease_blocks_readiness",
      "variables": {
        "state": "State",
        "generation": "int",
        "revision": "int",
        "native_busy": "bool",
        "readers": "bool"
      },
      "assume": [
        "state.generation >= 1 and state.revision >= 0 and state.serial >= 0",
        "readers"
      ],
      "lets": {},
      "assert": "not available(state, generation, revision, readers, native_busy)"
    },
    {
      "name": "native_job_blocks_readiness",
      "variables": {
        "state": "State",
        "generation": "int",
        "revision": "int",
        "readers": "bool"
      },
      "assume": [
        "state.generation >= 1 and state.revision >= 0 and state.serial >= 0"
      ],
      "lets": {},
      "assert": "not available(state, generation, revision, readers, True)"
    },
    {
      "name": "failed_or_closed_blocks_readiness",
      "variables": {
        "state": "State",
        "generation": "int",
        "revision": "int",
        "native_busy": "bool",
        "readers": "bool"
      },
      "assume": [
        "state.generation >= 1 and state.revision >= 0 and state.serial >= 0",
        "state.failed or state.closed"
      ],
      "lets": {},
      "assert": "not available(state, generation, revision, readers, native_busy)"
    },
    {
      "name": "readiness_requires_current_generation",
      "variables": {
        "state": "State",
        "generation": "int",
        "revision": "int",
        "native_busy": "bool",
        "readers": "bool"
      },
      "assume": [
        "state.generation >= 1 and state.revision >= 0 and state.serial >= 0",
        "generation != state.generation"
      ],
      "lets": {},
      "assert": "not available(state, generation, revision, readers, native_busy)"
    },
    {
      "name": "failure_is_sticky_until_validated_replacement",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.revision >= 0 and state.serial >= 0",
        "state.failed"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "after[0].failed or (event.kind == 'replace' and event.validated and event.ledger_valid and event.generation == state.generation and event.revision == state.revision + 1 and not state.closed)"
    },
    {
      "name": "replacement_requires_validated_current_observation",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.revision >= 0 and state.serial >= 0"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "after[0].generation == state.generation or (event.kind == 'replace' and event.validated and event.ledger_valid and event.generation == state.generation and event.revision == state.revision + 1 and not state.closed and after[0].generation == state.generation + 1)"
    },
    {
      "name": "closed_preserves_authority",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.revision >= 0 and state.serial >= 0",
        "state.closed"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "after[0].closed and after[0].generation == state.generation and after[0].serial == state.serial and not after[1].accepted"
    },
    {
      "name": "rejected_current_begin_fences_readiness",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.revision >= 0 and state.serial >= 0",
        "event.revision == state.revision + 1",
        "event.generation == state.generation and not state.closed",
        "event.kind == 'begin'"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "after[1].accepted or after[0].failed"
    },
    {
      "name": "ordered_observation_advances_once",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.revision >= 0 and state.serial >= 0",
        "event.revision == state.revision + 1"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "after[0].revision == event.revision and after[1].consumed"
    }
  ],
  "witnesses": [
    {
      "name": "first_native_lease_is_admitted",
      "lets": {
        "after": "step(new(), Event('begin', revision=1, lease=1, ledger_valid=True))"
      },
      "assert": "after[1].accepted and after[0].serial == 1"
    },
    {
      "name": "validated_retirement_can_restore_readiness",
      "lets": {
        "begun": "step(new(), Event('begin', revision=1, lease=1, ledger_valid=True))",
        "after": "step(begun[0], Event('finish', revision=2, lease=1, known=True, ledger_valid=True, validated=True))"
      },
      "assert": "after[1].accepted and available(after[0], 1, 2, False, False)"
    },
    {
      "name": "validated_replacement_recovers_failed_state",
      "lets": {
        "failed": "step(new(), Event('fail', revision=1))",
        "after": "step(failed[0], Event('replace', revision=2, ledger_valid=True, validated=True))"
      },
      "assert": "after[1].accepted and available(after[0], 2, 2, False, False)"
    }
  ],
  "mutations": [
    {
      "name": "admission_ignores_pending_ingress",
      "function": "available",
      "target": "revision == state.revision",
      "replacement": "True",
      "detects": [
        "property.pending_ingress_blocks_readiness"
      ]
    },
    {
      "name": "admission_ignores_active_lease",
      "function": "available",
      "target": "not readers",
      "replacement": "True",
      "detects": [
        "property.outstanding_lease_blocks_readiness"
      ]
    },
    {
      "name": "admission_ignores_native_job",
      "function": "available",
      "target": "not native_busy",
      "replacement": "True",
      "detects": [
        "property.native_job_blocks_readiness"
      ]
    },
    {
      "name": "foreign_receipt_changes_authority",
      "function": "step",
      "target": "event.generation != state.generation or state.closed",
      "replacement": "state.closed",
      "detects": [
        "property.foreign_generation_preserves_authority"
      ]
    },
    {
      "name": "finish_skips_retirement_validation",
      "function": "step",
      "target": "event.ledger_valid and event.validated",
      "replacement": "event.ledger_valid",
      "detects": [
        "property.finish_requires_validated_known_lease"
      ]
    },
    {
      "name": "replacement_skips_validation",
      "function": "step",
      "target": "event.validated and event.ledger_valid",
      "replacement": "event.ledger_valid",
      "detects": [
        "property.replacement_requires_validated_current_observation"
      ]
    }
  ]
}
