{
  "version": 1,
  "description": "Scalar native-edge lifecycle and compensation decisions. Edge multiplicity is trusted collection bookkeeping supplied by the runtime.",
  "state": "EffectState",
  "event": "Event",
  "initializers": [
    "new"
  ],
  "step": "step",
  "invariants": {
    "state_domain": "state.occurrence > 0 and state.before >= 0 and state.after >= 0 and state.current >= 0 and (state.current == state.before or state.current == state.after) and (not state.retired or (state.known and not state.armed)) and (not state.failed or state.armed)"
  },
  "contracts": {
    "new": {
      "requires": [
        "occurrence > 0",
        "before >= 0",
        "after >= 0"
      ]
    },
    "step": {
      "requires": [
        "event_valid(state, event)"
      ]
    }
  },
  "properties": [
    {
      "name": "foreign_effect_does_not_change_state",
      "variables": {
        "state": "EffectState",
        "event": "Event"
      },
      "assume": [
        "state.occurrence > 0 and state.before >= 0 and state.after >= 0 and state.current >= 0 and (state.current == state.before or state.current == state.after) and (not state.retired or (state.known and not state.armed)) and (not state.failed or state.armed)",
        "event_valid(state, event)",
        "event.occurrence != state.occurrence"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "after[0] == state"
    },
    {
      "name": "retired_effect_is_absorbing",
      "variables": {
        "state": "EffectState",
        "event": "Event"
      },
      "assume": [
        "state.occurrence > 0 and state.before >= 0 and state.after >= 0 and state.current >= 0 and (state.current == state.before or state.current == state.after) and (not state.retired or (state.known and not state.armed)) and (not state.failed or state.armed)",
        "event_valid(state, event)",
        "state.retired"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "after[0] == state"
    },
    {
      "name": "arm_revokes_known_value",
      "variables": {
        "state": "EffectState",
        "event": "Event"
      },
      "assume": [
        "state.occurrence > 0 and state.before >= 0 and state.after >= 0 and state.current >= 0 and (state.current == state.before or state.current == state.after) and (not state.retired or (state.known and not state.armed)) and (not state.failed or state.armed)",
        "event_valid(state, event)",
        "event.kind == 'ARM' and event.occurrence == state.occurrence and not state.retired and not state.armed"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "not after[0].known and after[0].armed"
    },
    {
      "name": "failed_compensation_retains_uncertainty",
      "variables": {
        "state": "EffectState",
        "event": "Event"
      },
      "assume": [
        "state.occurrence > 0 and state.before >= 0 and state.after >= 0 and state.current >= 0 and (state.current == state.before or state.current == state.after) and (not state.retired or (state.known and not state.armed)) and (not state.failed or state.armed)",
        "event_valid(state, event)",
        "event.kind == 'COMPENSATION_FAILED' and event.occurrence == state.occurrence and not state.retired and state.armed"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "not after[0].known and after[0].failed and not after[0].retired"
    },
    {
      "name": "commit_requires_known_applied_value",
      "variables": {
        "state": "EffectState",
        "event": "Event"
      },
      "assume": [
        "state.occurrence > 0 and state.before >= 0 and state.after >= 0 and state.current >= 0 and (state.current == state.before or state.current == state.after) and (not state.retired or (state.known and not state.armed)) and (not state.failed or state.armed)",
        "event_valid(state, event)"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "not ((event.kind == 'COMMIT' and not state.retired and after[0].retired)) or (state.applied and state.known and not state.failed)"
    },
    {
      "name": "compensation_restores_original_edge",
      "variables": {
        "state": "EffectState",
        "event": "Event"
      },
      "assume": [
        "state.occurrence > 0 and state.before >= 0 and state.after >= 0 and state.current >= 0 and (state.current == state.before or state.current == state.after) and (not state.retired or (state.known and not state.armed)) and (not state.failed or state.armed)",
        "event_valid(state, event)",
        "event.kind == 'COMPENSATED' and event.occurrence == state.occurrence and not state.retired and state.armed"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "after[0].current == state.before and after[0].known and after[0].retired"
    }
  ],
  "witnesses": [
    {
      "name": "arm_is_possible",
      "variables": {
        "state": "EffectState",
        "event": "Event"
      },
      "assume": [
        "state.occurrence > 0 and state.before >= 0 and state.after >= 0 and state.current >= 0 and (state.current == state.before or state.current == state.after) and (not state.retired or (state.known and not state.armed)) and (not state.failed or state.armed)",
        "event_valid(state,event)"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "event.kind == 'ARM' and not state.armed and after[0].armed"
    },
    {
      "name": "compensation_is_possible",
      "variables": {
        "state": "EffectState",
        "event": "Event"
      },
      "assume": [
        "state.occurrence > 0 and state.before >= 0 and state.after >= 0 and state.current >= 0 and (state.current == state.before or state.current == state.after) and (not state.retired or (state.known and not state.armed)) and (not state.failed or state.armed)",
        "event_valid(state,event)"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "event.kind == 'COMPENSATED' and not state.retired and after[0].retired"
    }
  ],
  "mutations": [
    {
      "name": "arm_keeps_old_authority",
      "function": "apply_ARM",
      "target": "False if update_known else state.known",
      "replacement": "state.known",
      "detects": [
        "property.arm_revokes_known_value"
      ]
    }
  ]
}
