{
  "version": 1,
  "description": "lifecycle workflow authority for the current Blender product. Scalar identities name separately owned payloads. Physical retirement, native replacement, verified readback and restoration are explicit adapter receipts; logical actions do not establish their truth.",
  "state": "State",
  "event": "Event",
  "initializers": [
    "new"
  ],
  "step": "step",
  "invariants": {
    "identity": "state.generation >= 1 and state.operation >= 0",
    "closed_is_closing": "state.phase != 'closed' or state.closing"
  },
  "properties": [
    {
      "name": "native_replacement_requires_quiescence",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.operation >= 0",
        "state.phase != 'closed' or state.closing"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "after[1].action != 'replace' or (event.kind == 'drained' and event.readers == 0 and event.borrows == 0 and event.debts == 0 and event.validated)"
    },
    {
      "name": "activation_requires_inspection",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.operation >= 0",
        "state.phase != 'closed' or state.closing"
      ],
      "lets": {
        "after": "step(state, event)"
      },
      "assert": "after[1].action != 'activate' or (event.kind == 'inspected' and event.validated and event.readers == 0 and event.borrows == 0 and event.debts == 0 and not state.closing)"
    },
    {
      "name": "closed_requires_physical_release",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.operation >= 0",
        "state.phase != 'closed' or state.closing",
        "state.phase != 'closed'"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "assert": "after[0].phase != 'closed' or (event.kind == 'released' and event.validated and state.phase == 'releasing' and state.closing)"
    },
    {
      "name": "external_replacement_never_authorizes_replacement",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.operation >= 0",
        "state.phase != 'closed' or state.closing",
        "event.kind == 'external_replaced'"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "assert": "after[1].action != 'replace' and (not after[1].accepted or (after[0].phase == 'inspecting' and after[0].generation == state.generation + 1))"
    },
    {
      "name": "disable_release_waits_for_every_worker_and_debt",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.operation >= 0",
        "state.phase != 'closed' or state.closing"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "assert": "after[1].action != 'release' or (event.workers == 0 and event.readers == 0 and event.borrows == 0 and event.debts == 0 and event.validated and state.closing)"
    },
    {
      "name": "external_post_requires_recorded_pre",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.operation >= 0",
        "state.phase != 'closed' or state.closing",
        "event.kind == 'external_replaced'"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "assert": "not after[1].accepted or state.phase in ('draining','replacing')"
    },
    {
      "name": "manual_inspection_does_not_advance_generation",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.operation >= 0",
        "state.phase != 'closed' or state.closing",
        "event.kind == 'inspect'"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "assert": "not after[1].accepted or (after[0].generation == state.generation and after[0].phase == 'inspecting' and after[1].action == 'inspect')"
    }
  ],
  "witnesses": [
    {
      "name": "replacement_can_retire_detached_workers_later",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.operation >= 0",
        "state.phase != 'closed' or state.closing"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "assert": "event.kind == 'drained' and event.workers > 0 and after[1].action == 'replace'"
    },
    {
      "name": "clean_disable_can_release",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.operation >= 0",
        "state.phase != 'closed' or state.closing"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "assert": "state.closing and after[1].action == 'release'"
    },
    {
      "name": "manual_inspection_is_possible",
      "variables": {
        "state": "State",
        "event": "Event"
      },
      "assume": [
        "state.generation >= 1 and state.operation >= 0",
        "state.phase != 'closed' or state.closing",
        "event.kind == 'inspect'"
      ],
      "lets": {
        "after": "step(state,event)"
      },
      "assert": "after[1].accepted and after[1].action == 'inspect'"
    }
  ],
  "mutations": [
    {
      "name": "replacement_ignores_repair_debt",
      "function": "step",
      "target": "event.kind == 'drained' and state.phase == 'draining' and event.readers == 0 and event.borrows == 0 and event.debts == 0 and event.validated",
      "replacement": "event.kind == 'drained' and state.phase == 'draining' and event.readers == 0 and event.borrows == 0 and event.validated",
      "detects": [
        "property.native_replacement_requires_quiescence"
      ]
    }
  ]
}
