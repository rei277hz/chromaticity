load("//build_defs:artifacts.bzl", "generate", "python_tool", "verification_group")

python_tool(
    name = "probe",
    srcs = {"remote_execution/tests/probe.py": "probe.py"},
    main_module = "remote_execution.tests.probe",
)

[generate(
    name = "probe_" + ("0" if index < 10 else "") + str(index),
    args = [
        "--probe",
        str(index),
        "--nonce",
        read_root_config("remote_execution", "probe_nonce", "stable"),
    ],
    outputs = {"report": "report.json"},
    tool = ":probe",
) for index in range(16)]

verification_group(
    name = "smoke",
    visibility = ["PUBLIC"],
    deps = [":probe_" + ("0" if index < 10 else "") + str(index) for index in range(16)],
)
