{
  stores: [
    {
      name: "CAS",
      filesystem: {
        content_path: "/data/control/cas/content",
        temp_path: "/data/control/cas/tmp",
        eviction_policy: {
          max_bytes: "${NATIVE_CAS_MAX_BYTES:-128849018880}",
          evict_bytes: 1073741824,
        },
      },
    },
    {
      name: "AC",
      filesystem: {
        content_path: "/data/control/ac/content",
        temp_path: "/data/control/ac/tmp",
        eviction_policy: {
          max_bytes: "${NATIVE_AC_MAX_BYTES:-1073741824}",
        },
      },
    },
  ],
  schedulers: [
    {
      name: "scheduler",
      simple: {
        supported_platform_properties: {
          OSFamily: "exact",
          ISA: "exact",
          "worker-image": "exact",
        },
        worker_timeout_s: 60,
        worker_match_logging_interval_s: 30,
      },
    },
  ],
  servers: [
    {
      name: "reapi",
      listener: { http: { socket_address: "0.0.0.0:50051" } },
      services: {
        cas: [{ instance_name: "main", cas_store: "CAS" }],
        ac: [{ instance_name: "main", ac_store: "AC" }],
        execution: [{ instance_name: "main", cas_store: "CAS", scheduler: "scheduler" }],
        capabilities: [{ instance_name: "main", remote_execution: { scheduler: "scheduler" } }],
        bytestream: [{ instance_name: "main", cas_store: "CAS" }],
      },
    },
    {
      name: "worker-api",
      listener: { http: { socket_address: "0.0.0.0:50061" } },
      services: { worker_api: { scheduler: "scheduler" } },
    },
    {
      name: "health",
      listener: { http: { socket_address: "0.0.0.0:50052" } },
      services: { health: {}, admin: {} },
    },
  ],
  global: { max_open_files: 131072 },
}
