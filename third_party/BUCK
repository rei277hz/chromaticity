[
    http_file(
        name = "xvfb_" + name + "_archive",
        out = name + ".deb",
        sha256 = spec[1],
        urls = [spec[0]],
    )
    for name, spec in XVFB_PACKAGES.items()
]

python_tool(
    name = "unpack_xvfb",
    srcs = {"tools/build/unpack_xvfb.py": "//tools/blender-build:unpack_xvfb_source"},
    main_module = "tools.build.unpack_xvfb",
)

generate(
    name = "xvfb_linux",
    args = [arg for name in XVFB_PACKAGES for arg in [
        "--archive",
        "$(location :xvfb_" + name + "_archive)",
    ]],
    outputs = {"binary": "usr/bin/Xvfb"},
    tool = ":unpack_xvfb",
    visibility = ["PUBLIC"],
)

# Blender's manylinux bpy wheel intentionally excludes Linux/X11 ABI libraries.
# Pin the Debian 13 X11/GL loader closure so native CPU evaluators do not rely
# on developer-shell packages. These libraries require glibc >= 2.38; libc and
# GPU drivers remain platform dependencies. CPU acceptance covers Debian 13.
BPY_NATIVE_ABI_PACKAGES = {
