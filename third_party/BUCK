BPY_NATIVE_ABI_SONAMES = [
    "libX11.so.6",
    "libXrender.so.1",
    "libXfixes.so.3",
    "libXi.so.6",
    "libxkbcommon.so.0",
    "libSM.so.6",
    "libICE.so.6",
    "libXext.so.6",
    "libGL.so.1",
    "libGLX.so.0",
    "libGLdispatch.so.0",
    "libxcb.so.1",
    "libXau.so.6",
    "libXdmcp.so.6",
    "libbsd.so.0",
    "libmd.so.0",
    "libuuid.so.1",
]

[http_file(
    name = "bpy_native_abi_" + name + "_archive",
    out = spec[0].split("/")[-1],
    sha256 = spec[1],
    target_compatible_with = [
        "prelude//os:linux",
        "prelude//cpu:x86_64",
    ],
    urls = ["https://deb.debian.org/debian/" + spec[0]],
    visibility = [],
) for name, spec in BPY_NATIVE_ABI_PACKAGES.items()]

python_tool(
    name = "unpack_bpy_native_abi",
    srcs = {"blender_build/unpack_native_libraries.py": "//tools/blender-build:unpack_native_libraries_source"},
    main_module = "blender_build.unpack_native_libraries",
)

generate(
    name = "bpy_native_abi_linux",
    args = [arg for name in BPY_NATIVE_ABI_PACKAGES for arg in [
        "--archive",
        "$(location :bpy_native_abi_" + name + "_archive)",
    ]],
    outputs = {soname: "usr/lib/x86_64-linux-gnu/" + soname for soname in BPY_NATIVE_ABI_SONAMES},
    tool = ":unpack_bpy_native_abi",
    visibility = ["PUBLIC"],
)

prebuilt_cxx_library_group(
    name = "bpy_native_abi_linux_libraries",
    shared_libs = {soname: ":bpy_native_abi_linux[" + soname + "]" for soname in BPY_NATIVE_ABI_SONAMES},
    shared_link = ["$(lib " + soname + ")" for soname in BPY_NATIVE_ABI_SONAMES],
    target_compatible_with = [
        "prelude//os:linux",
        "prelude//cpu:x86_64",
    ],
    visibility = ["PUBLIC"],
)

# A complete software OpenGL fixture for synthetic native GUI timing. Kept
# separate from CPU bpy admission so these drivers are never runtime imports.
[
    http_file(
        name = "gui_software_" + name + "_archive",
        out = spec[0].split("/")[-1],
        sha256 = spec[1],
        target_compatible_with = [
            "prelude//os:linux",
            "prelude//cpu:x86_64",
        ],
        urls = [spec[0]],
    )
    for name, spec in GUI_SOFTWARE_PACKAGES.items()
]

generate(
    name = "xvfb_software_linux",
    args = [arg for name in XVFB_PACKAGES for arg in [
               "--archive",
               "$(location :xvfb_" + name + "_archive)",
           ]] +
           [arg for name in BPY_NATIVE_ABI_PACKAGES for arg in [
               "--archive",
               "$(location :bpy_native_abi_" + name + "_archive)",
           ]] +
           [arg for name in GUI_SOFTWARE_PACKAGES for arg in [
               "--archive",
               "$(location :gui_software_" + name + "_archive)",
           ]],
    outputs = {
        "binary": "usr/bin/Xvfb",
        "glx": "usr/lib/x86_64-linux-gnu/libGLX_mesa.so.0",
        "swrast": "usr/lib/x86_64-linux-gnu/dri/swrast_dri.so",
    },
    target_compatible_with = [
        "prelude//os:linux",
        "prelude//cpu:x86_64",
    ],
    tool = ":unpack_xvfb",
    visibility = ["PUBLIC"],
)

