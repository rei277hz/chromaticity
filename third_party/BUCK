# Native installed-extension acceptance uses Blender's own Python and launcher,
# independently of the bpy wheel used by the fast integration suites.
http_file(
    name = "blender_linux_archive",
    out = "blender-5.2.2-linux-x64.tar.xz",
    sha256 = "84098912789dc450e95697c4184fb8a90acbe5111c2ba4aede3fecb57806a168",
    urls = ["https://download.blender.org/release/Blender5.2/blender-5.2.2-linux-x64.tar.xz"],
    visibility = ["PUBLIC"],
)

python_tool(
    name = "unpack_blender",
    srcs = {"tools/build/unpack_blender.py": "//tools/blender-build:unpack_blender_source"},
    main_module = "tools.build.unpack_blender",
)

generate(
    name = "blender_linux",
    args = [
        "--archive",
        "$(location :blender_linux_archive)",
    ],
    outputs = {"binary": "blender"},
    tool = ":unpack_blender",
    visibility = ["PUBLIC"],
)

