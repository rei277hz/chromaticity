load(":dependencies.bzl", "NPM", "TOOLS")

export_file(
    name = "manifest",
    src = "dependencies.json",
    visibility = ["PUBLIC"],
)

[http_file(
    name = spec["target"],
    out = spec["filename"],
    sha256 = spec["sha256"],
    target_compatible_with = [
        "prelude//os:linux",
        "prelude//cpu:x86_64",
    ],
    urls = [spec["url"]],
    visibility = ["PUBLIC"],
) for spec in TOOLS.values()]

[http_file(
    name = spec["target"],
    out = spec["target"] + ".tgz",
    sha256 = spec["sha256"],
    urls = [spec["url"]],
    visibility = ["PUBLIC"],
) for spec in NPM]

