[cells]
  root = .
  prelude = prelude
  toolchains = toolchains
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none

[external_cells]
  prelude = bundled

[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default target:prelude//...->prelude//platforms:default target:toolchains//...->prelude//platforms:default

[project]
  ignore = .git, .sl, buck-out, __pycache__, node_modules, target, dist, .vite, third_party/rust/.cargo, third_party/rust/vendor

# BEGIN NativeLink settings
[build]
  execution_platforms = toolchains//:platforms

[buck2]
  digest_algorithms = SHA256
  file_watcher = watchman

[buck2_re_client]
  engine_address = 172.19.0.1:50051
  action_cache_address = 172.19.0.1:50051
  cas_address = 172.19.0.1:50051
  tls = false
  instance_name = main

[remote_execution]
  enabled = true
  worker_image = sha256:e426d0d423df072ee5cefd5acce4cf9451bf1c68524ebcf0c211f20435481b9a
# END NativeLink settings
